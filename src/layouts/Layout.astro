---
// Dashboard layout
import Layout from '@/components/layout/Layout.astro';
import SidebarNav from '@/components/dashboard/SidebarNav.astro';
export const prerender = false;

const pathname = new URL(Astro.request.url).pathname;

---
<Layout title="Dashboard - Carcblog" description="Your writer dashboard">
  <div class="dashboard-layout min-h-[calc(100vh-var(--header-height))] bg-background-alt">
    {/* Sidebar */}
    <aside class="sidebar w-64 bg-background border-r border-border px-4 py-6">
      <SidebarNav currentPath={pathname} />
    </aside>

    {/* Main content */}
    <main class="main-content flex-1 p-6">
      <slot />
    </main>
  </div>
</Layout>

<style>
  .dashboard-layout {
    display: flex;
    min-height: calc(100vh - var(--h-nav));
    background: transparent;
  }

  .sidebar {
    width: 240px;
    min-width: 240px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid rgba(255, 255, 255, 0.5);
    padding: var(--space-lg) var(--space-base);
    position: sticky;
    top: var(--h-nav);
    height: calc(100vh - var(--h-nav));
    overflow-y: auto;
  }

  .main-content {
    flex: 1;
    min-width: 0;
    padding: var(--space-xl);
    overflow-y: auto;
  }
</style>
