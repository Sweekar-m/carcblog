---
// Dashboard layout
import Layout from '@/components/layout/Layout.astro';
export const prerender = false;

// Get auth data safely
let userId = null;
if (typeof Astro.locals?.auth === 'function') {
  const auth = await Astro.locals.auth();
  userId = auth?.userId;
}

// Redirect to sign-in if not authenticated
if (!userId) {
  return Astro.redirect('/sign-in');
}

const pathname = new URL(Astro.request.url).pathname;
---
<Layout title="Dashboard - Carcblog" description="Your writer dashboard">
  <div class="dashboard-layout min-h-[calc(100vh-var(--header-height))]">
    {/* Sidebar */}
    <aside class="sidebar w-64 bg-background border-r border-border">
      <div class="sidebar-header flex items-center space-x-3 pb-4 border-b border-border-muted">
        <div class="sidebar-logo h-8 w-8 rounded-md bg-primary flex items-center justify-center text-primary-foreground font-bold text-xs">
          C
        </div>
        <div class="sidebar-title font-serif text-xl font-bold text-primary">Carcblog</div>
      </div>

      <nav class="nav-menu mt-4">
        <a href="/dashboard" class={`nav-item flex items-center space-x-3 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 ${pathname === '/dashboard' ? 'bg-primary text-primary-foreground' : 'text-foreground-muted hover:bg-muted/50 hover:text-foreground'}`}>
          <span class="nav-icon h-8 w-8 flex items-center justify-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 100-2z" />
            </svg>
          </span>
          <span class="nav-label">Overview</span>
        </span>

        <a href="/dashboard/articles" class={`nav-item flex items-center space-x-3 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 ${pathname.startsWith('/dashboard/articles') ? 'bg-primary text-primary-foreground' : 'text-foreground-muted hover:bg-muted/50 hover:text-foreground'}`}>
          <span class="nav-icon h-8 w-8 flex items-center justify-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m2 0a9 9 0 11-18 0 9 9 0 0018 0z" />
            </svg>
          </span>
          <span class="nav-label">Articles</span>
        </a>

        <a href="/dashboard/analytics" class={`nav-item flex items-center space-x-3 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 ${pathname === '/dashboard/analytics' ? 'bg-primary text-primary-foreground' : 'text-foreground-muted hover:bg-muted/50 hover:text-foreground'}`}>
          <span class="nav-icon h-8 w-8 flex items-center justify-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </span>
          <span class="nav-label">Analytics</span>
        </a>

        <a href="/dashboard/profile" class={`nav-item flex items-center space-x-3 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 ${pathname === '/dashboard/profile' ? 'bg-primary text-primary-foreground' : 'text-foreground-muted hover:bg-muted/50 hover:text-foreground'}`}>
          <span class="nav-icon h-8 w-8 flex items-center justify-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </span>
          <span class="nav-label">Profile</span>
        </a>

        <a href="/dashboard/settings" class={`nav-item flex items-center space-x-3 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200 ${pathname === '/dashboard/settings' ? 'bg-primary text-primary-foreground' : 'text-foreground-muted hover:bg-muted/50 hover:text-foreground'}`}>
          <span class="nav-icon h-8 w-8 flex items-center justify-center rounded-md bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-1.756.426-2.924.426-3.35 0a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37a1.724 1.724 0 00-2.573 1.066c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573z" />
            </svg>
          </span>
          <span class="nav-label">Settings</span>
        </a>
      </nav>
    </aside>

    {/* Main content */}
    <main class="main-content flex-1 p-6">
      <slot />
    </main>
  </div>
</Layout>

<style>
  .dashboard-layout {
    display: flex;
    min-height: calc(100vh - var(--header-height, 0));
  }

  .sidebar {
    width: 240px;
    /* Background and border already set via classes */
  }

  .sidebar-header {
    /* Styles already applied via classes */
  }

  .sidebar-logo {
    /* Styles already applied via classes */
  }

  .sidebar-title {
    /* Styles already applied via classes */
  }

  .nav-menu {
    /* Styles already applied via classes */
  }

  .nav-item {
    /* Styles already applied via classes */
  }

  .main-content {
    /* Padding already applied via classes */
  }
</style>