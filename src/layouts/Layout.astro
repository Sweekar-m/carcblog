---
// Dashboard layout
import Layout from '@/components/layout/Layout.astro';
import SidebarNav from '@/components/dashboard/SidebarNav.astro';
import { hasCompletedOnboarding } from '@/lib/supabase';
export const prerender = false;

// Get auth data safely
let userId = null;
if (typeof Astro.locals?.auth === 'function') {
  const auth = await Astro.locals.auth();
  userId = auth?.userId;
}

// Redirect to sign-in if not authenticated
if (!userId) {
  return Astro.redirect('/sign-in');
}

// Redirect to onboarding if profile setup is not complete
const onboardingDone = await hasCompletedOnboarding(userId);
if (!onboardingDone) {
  return Astro.redirect('/onboarding');
}

const pathname = new URL(Astro.request.url).pathname;
---
<Layout title="Dashboard - Carcblog" description="Your writer dashboard">
  <div class="dashboard-layout min-h-[calc(100vh-var(--header-height))] bg-background-alt">
    {/* Sidebar */}
    <aside class="sidebar w-64 bg-background border-r border-border px-4 py-6">
      <SidebarNav currentPath={pathname} />
    </aside>

    {/* Main content */}
    <main class="main-content flex-1 p-6">
      <slot />
    </main>
  </div>
</Layout>

<style>
  .dashboard-layout {
    display: flex;
    min-height: calc(100vh - 96px); /* subtract combined nav heights */
    background: #f5f5f7;
  }

  .sidebar {
    width: 240px;
    min-width: 240px;
    flex-shrink: 0;
    background: #ffffff;
    border-right: 1px solid #e0e0e0;
    padding: 24px 16px;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }

  .main-content {
    flex: 1;
    min-width: 0; /* CRITICAL: prevents flex child from overflowing */
    padding: 32px;
    overflow-y: auto;
  }
</style>