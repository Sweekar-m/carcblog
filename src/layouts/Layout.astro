---
// Dashboard layout
import BaseLayout from '@/components/layout/Layout.astro';
import SidebarNav from '@/components/dashboard/SidebarNav.astro';

export const prerender = false;

interface Props {
  title?: string;
  description?: string;
  hideSidebar?: boolean;
}

const { title = "Dashboard - Carcblog", description = "Your writer dashboard", hideSidebar = true } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const role = Astro.locals.user?.role || 'writer';
---

<BaseLayout title={title} description={description}>
  <div class="dashboard-layout flex flex-col lg:flex-row min-h-[calc(100vh-72px)] bg-canvas">
    
    {!hideSidebar && (
      <>
        {/* Mobile Dashboard Bar (<1024px) */}
        <header class="lg:hidden flex items-center justify-between px-4 py-3 border-b border-hairline relative z-10" style="background-color: #ffffff !important;">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-brand-blue"></span>
            <span class="font-sans text-xs font-bold uppercase tracking-wider text-steel">{role} Dashboard</span>
          </div>
          <button
            id="dashboard-mobile-menu-trigger"
            type="button"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-hairline-strong bg-canvas text-ink text-xs font-semibold shadow-xs"
            aria-label="Toggle dashboard menu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span>Menu</span>
          </button>
        </header>

        {/* Mobile Slide-Over Drawer (<1024px) */}
        <div id="dashboard-drawer-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-[9998] hidden transition-opacity lg:hidden" aria-hidden="true"></div>
        <aside id="dashboard-drawer" class="fixed top-0 left-0 bottom-0 w-[280px] max-w-[85vw] border-r border-hairline p-5 z-[9999] transform -translate-x-full transition-transform duration-300 ease-out overflow-y-auto lg:hidden" style="background-color: #ffffff !important; color: #0f172a !important; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-hairline">
            <span class="font-sans text-sm font-bold text-ink">Dashboard Navigation</span>
            <button id="dashboard-drawer-close" class="p-1 rounded-full border border-hairline bg-surface text-steel hover:text-ink min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Close dashboard drawer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <SidebarNav currentPath={pathname} role={role} />
        </aside>

        {/* Permanent Desktop Sidebar (≥1024px) */}
        <aside class="hidden lg:block w-64 min-w-[256px] shrink-0 border-r border-hairline bg-surface/60 backdrop-blur-md px-4 py-6 sticky top-[72px] h-[calc(100vh-72px)] overflow-y-auto">
          <SidebarNav currentPath={pathname} role={role} />
        </aside>
      </>
    )}

    {/* Main Content
        PADDING CONTRACT:
        - hideSidebar={false}: Layout shell applies p-4 sm:p-6 lg:p-8. Pages must NOT add their own outer padding.
        - hideSidebar={true}:  Layout shell applies NO padding. The page/island component is responsible for its own container (e.g. SettingsManager, PublicProfileView).
    */}
    <main class={`flex-1 w-full min-w-0 overflow-y-auto ${hideSidebar ? '' : 'p-4 sm:p-6 lg:p-8'}`}>
      <slot />
    </main>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('dashboard-mobile-menu-trigger');
    const drawer = document.getElementById('dashboard-drawer');
    const overlay = document.getElementById('dashboard-drawer-overlay');
    const closeBtn = document.getElementById('dashboard-drawer-close');

    function openDrawer() {
      if (drawer && overlay) {
        drawer.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      if (drawer && overlay) {
        drawer.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    if (trigger) trigger.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
  });
</script>
