---
// Home page — ElevenLabs editorial design system
export const prerender = false;
import Layout from '@/components/layout/Layout.astro';
import { getSanityArticles, safeImageUrl } from '@/lib/sanity';
import ArticleCard from '@/components/ui/ArticleCard.astro';
import HomeTour from '@/components/islands/HomeTour';

const sanityArticles = await getSanityArticles({ limit: 6 });
const articleData = sanityArticles.map(article => ({
  title: article.title,
  excerpt: article.excerpt ?? "(no excerpt)",
  publishedAt: article.publishedAt ?? new Date().toISOString(),
  authorName: article.author?.name ?? "Unknown",
  authorImage: safeImageUrl(article.author?.image) ?? null,
  slug: typeof article.slug === 'string' ? article.slug : (article.slug as any)?.current ?? '',
  coverImage: safeImageUrl(article.coverImage, article.body) ?? null
}));


Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
);

const heroArticle = articleData[0] || null;
const gridArticles = articleData.slice(1);
const isLoggedIn = !!Astro.locals.user;
---

<Layout title="Carcblog — Where Startup Ideas Go Public" description="Discover insightful writing on startups, founders, funding, and innovation on Carcblog — the editorial platform for the startup ecosystem.">
  <HomeTour client:idle isLoggedIn={isLoggedIn} />

  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO BAND
       hero-band spec: canvas bg, display-mega, atmospheric orbs, two CTAs
  ═══════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO BAND (MiniMax 80px display, DM Sans, flat canvas)
  ═══════════════════════════════════════════════ -->
  <section class="hero-band" id="hero">
    <div class="hero-inner">
      <!-- Eyebrow label -->
      <div class="hero-eyebrow">
        <span class="badge-pill">Startup Media Platform</span>
      </div>

      <!-- Main headline — hero-display: DM Sans 600, 80px, tight leading -->
      <h1 class="hero-headline">
        Where great startup<br />
        ideas go public.
      </h1>

      <!-- Sub — subtitle: DM Sans 500, steel color -->
      <p class="hero-sub">
        News, founder stories, funding updates, and product launches —
        curated for the people building what's next.
      </p>

      <!-- CTA row: black pill primary + outline secondary -->
      <div class="hero-cta-row">
        <a href="/discover" class="btn-primary" id="hero-explore-cta">
          Explore stories
        </a>
        <a href="/auth/sign-up" class="btn-secondary" id="hero-join-cta">
          Join as a writer
        </a>
      </div>

      <!-- Social proof -->
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-num">12K+</span>
          <span class="stat-label">Writers</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-num">84K+</span>
          <span class="stat-label">Articles Published</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-num">2.4M</span>
          <span class="stat-label">Monthly Readers</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: VIBRANT CATEGORY MATRIX (MiniMax Product Encoding)
  ═══════════════════════════════════════════════ -->
  <section class="category-matrix-section">
    <div class="page-container">
      <div class="section-header-flex">
        <div>
          <h2 class="matrix-title">Ecosystem Matrix</h2>
          <p class="matrix-subtitle">Deep-dive startup journalism encoded by topic</p>
        </div>
        <a href="/topics" class="matrix-link" aria-label="View all topics in Carcblog">View all topics →</a>
      </div>

      <div class="matrix-grid">
        <!-- Card 1: Funding (Volcanic Coral) -->
        <a href="/startups" class="product-card product-card-coral">
          <div>
            <span class="card-badge">Funding &amp; Capital</span>
            <h3 class="card-hero-title">Seed to Series C</h3>
            <p class="card-desc">Exclusive breakdowns of capital raises, valuation metrics, and lead investor notes.</p>
          </div>
          <div class="card-bottom">
            <span class="card-meta">5,978 Deals &amp; Profiles</span>
            <span class="card-arrow">→</span>
          </div>
        </a>

        <!-- Card 2: Product Launches (Deep Blue) -->
        <a href="/startups" class="product-card product-card-blue">
          <div>
            <span class="card-badge">Product Launches</span>
            <h3 class="card-hero-title">Launch Radar</h3>
            <p class="card-desc">First look at new B2B tools, developer platforms, and AI-native products.</p>
          </div>
          <div class="card-bottom">
            <span class="card-meta">5,978 Companies</span>
            <span class="card-arrow">→</span>
          </div>
        </a>

        <!-- Card 3: Founder Stories (Saturated Magenta) -->
        <a href="/founders" class="product-card product-card-magenta">
          <div>
            <span class="card-badge">Founder Stories</span>
            <h3 class="card-hero-title">Raw Journeys</h3>
            <p class="card-desc">Unfiltered founder postmortems, pivot strategies, and product-market fit stories.</p>
          </div>
          <div class="card-bottom">
            <span class="card-meta">11,182 Founders</span>
            <span class="card-arrow">→</span>
          </div>
        </a>

        <!-- Card 4: AI & Tech Trends (Royal Purple) -->
        <a href="/topics" class="product-card product-card-purple">
          <div>
            <span class="card-badge">AI &amp; Infra</span>
            <h3 class="card-hero-title">Deep Tech</h3>
            <p class="card-desc">LLM architecture, agentic workflows, GPU cluster economics, and tech trends.</p>
          </div>
          <div class="card-bottom">
            <span class="card-meta">1,420 AI Profiles</span>
            <span class="card-arrow">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: FEATURED ARTICLE SPOTLIGHT
       feature-card spec: white surface, hairline, xl radius
  ═══════════════════════════════════════════════ -->
  {heroArticle && (
    <section class="spotlight-section">
      <div class="page-container">
        <div class="section-header">
          <span class="badge-pill" aria-label="Section: Featured Story">Featured Story</span>
        </div>
        <a href={`/article/${heroArticle.slug}`} class="spotlight-card reveal-single" aria-label={`Read featured article: ${heroArticle.title}`}>
          <div class="spotlight-image-col">
            {heroArticle.coverImage ? (
              <img
                src={heroArticle.coverImage}
                alt={heroArticle.title}
                width="600"
                height="375"
                decoding="async"
                fetchpriority="high"
                class="spotlight-img"
                loading="eager"
                style="aspect-ratio: 16/10; object-fit: cover;"
              />
            ) : (
              <div class="spotlight-img-placeholder">
                <div class="atm-orb placeholder-orb-mint" aria-hidden="true"></div>
                <div class="atm-orb placeholder-orb-peach" aria-hidden="true"></div>
              </div>
            )}
          </div>
          <div class="spotlight-content-col">
            <time class="spotlight-date" datetime={heroArticle.publishedAt}>
              {new Date(heroArticle.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
            <h2 class="spotlight-title">{heroArticle.title}</h2>
            {heroArticle.excerpt && (
              <p class="spotlight-excerpt">{heroArticle.excerpt}</p>
            )}
            <div class="spotlight-footer">
              <div class="spotlight-author">
                {heroArticle.authorImage && (
                  <img
                    src={heroArticle.authorImage}
                    alt={heroArticle.authorName}
                    width="24"
                    height="24"
                    decoding="async"
                    class="author-avatar"
                    style="aspect-ratio: 1/1; object-fit: cover;"
                  />
                )}
                <span class="author-name">{heroArticle.authorName}</span>
              </div>
              <span class="spotlight-read-label">Read story</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════
       SECTION 3: MORE STORIES GRID
       3-up → 2-up → 1-up feature-card grid
  ═══════════════════════════════════════════════ -->
  <section class="grid-section">
    <div class="page-container">
      <div class="grid-header">
        <h2 class="grid-title">
          {heroArticle ? 'More Stories' : 'Featured Stories'}
        </h2>
        <a href="/feed" class="grid-view-all btn-outline" id="homepage-view-all" aria-label="View all published stories in Carcblog feed">View all stories</a>
      </div>

      {(heroArticle ? gridArticles : articleData).length > 0 ? (
        <div class="articles-grid reveal-grid">
          {(heroArticle ? gridArticles : articleData).map((article) => (
            <ArticleCard
              title={article.title}
              excerpt={article.excerpt}
              publishedAt={article.publishedAt}
              authorName={article.authorName}
              authorImage={article.authorImage}
              slug={article.slug}
              coverImage={article.coverImage}
            />
          ))}
        </div>
      ) : articleData.length === 0 ? (
        <div class="empty-state reveal-single" role="status">
          <!-- Atmospheric orb for empty state -->
          <div class="empty-orb-mint" aria-hidden="true"></div>
          <p class="badge-pill empty-eyebrow">Nothing yet</p>
          <h3 class="empty-title">Be the first to publish</h3>
          <p class="empty-body">
            Your story starts here. Create your first article and join a community of thoughtful writers.
          </p>
          <a href="/dashboard/articles/new" class="btn-primary" id="empty-state-write-cta">
            Write your first story
          </a>
        </div>
      ) : (
        <div class="empty-state reveal-single" role="status">
          <div class="empty-orb-mint" aria-hidden="true"></div>
          <p class="badge-pill empty-eyebrow">You're all caught up</p>
          <h3 class="empty-title">More stories coming soon</h3>
          <p class="empty-body">
            You've read the latest featured story! Explore topics or write your own article to share with the community.
          </p>
          <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 16px; position: relative; z-index: 1;">
            <a href="/discover" class="btn-primary" id="grid-empty-discover">Explore topics</a>
            <a href="/dashboard/articles/new" class="btn-outline" id="grid-empty-write">Write a story</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: CTA BAND
       cta-band spec: canvas bg, display-lg headline, ink pill, 96px padding
  ═══════════════════════════════════════════════ -->
  <section class="cta-band">
    <!-- Atmospheric orbs — decoration behind copy -->
    <div class="atm-orb cta-orb-lavender" aria-hidden="true"></div>
    <div class="atm-orb cta-orb-sky"      aria-hidden="true"></div>

    <div class="cta-band-inner reveal-single">
      <p class="badge-pill cta-eyebrow">Join 12,000 writers</p>
      <h2 class="cta-headline">
        Your ideas deserve<br />a better home.
      </h2>
      <p class="cta-body">
        Get early access to writing tools, editorial insights, and a community
        of people who take their craft seriously.
      </p>
      <div class="cta-actions">
        <a href="/auth/sign-up" class="btn-primary" id="cta-band-signup">Start publishing free</a>
        <a href="/about" class="btn-outline" id="cta-band-learn" aria-label="Learn about Carcblog's publishing platform">Learn about Carcblog</a>
      </div>
    </div>
  </section>

  <!-- Homepage motion controls -->
  <script>
    import { animate } from 'motion';

    const triggerHeroAnimations = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const headline = document.querySelector('.hero-headline');
      const sub = document.querySelector('.hero-sub');
      const ctas = document.querySelector('.hero-cta-row');
      const stats = document.querySelector('.hero-stats');

      if (headline && sub && ctas && stats) {
        animate(
          headline,
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, ease: 'ease-out' }
        );
        animate(
          sub,
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, delay: 0.1, ease: 'ease-out' }
        );
        animate(
          ctas,
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, delay: 0.2, ease: 'ease-out' }
        );
        animate(
          stats,
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.5, delay: 0.3, ease: 'ease-out' }
        );
      }
    };

    document.addEventListener('astro:page-load', triggerHeroAnimations);
  </script>

</Layout>

<style>
/* ════════════════════════════════════════════════════════════
   HERO BAND — hero-band spec
   canvas #f5f5f5, display-mega, atmospheric orbs, 96px padding
════════════════════════════════════════════════════════════ */
.hero-band {
  background: transparent;
  padding: var(--space-section) var(--space-lg);
  position: relative;
  overflow: hidden;
  text-align: center;
  border-bottom: 1px solid var(--color-hairline);
}

/* Atmospheric orbs — pastel radial blooms, pure decoration */
.hero-orb-mint {
  width: 480px; height: 480px;
  background: radial-gradient(circle, rgba(167, 229, 211, 0.45) 0%, transparent 70%);
  top: -120px; left: 50%;
  transform: translateX(-50%);
}
.hero-orb-peach {
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(244, 197, 168, 0.35) 0%, transparent 70%);
  bottom: -40px; right: -60px;
}
.hero-orb-lavender {
  width: 280px; height: 280px;
  background: radial-gradient(circle, rgba(200, 184, 224, 0.3) 0%, transparent 70%);
  bottom: 20px; left: -40px;
}

.hero-inner {
  position: relative;
  z-index: 2;
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  border: 1px solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
  border-radius: var(--radius-xxl);
  padding: var(--space-xxl) var(--space-xl);
}
@media (max-width: 768px) {
  .hero-inner {
    padding: var(--space-xl) var(--space-sm);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.08);
  }
}

.hero-eyebrow {
  margin-bottom: var(--space-xl);
}
.hero-eyebrow .badge-pill {
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
}

/* hero-display spec: DM Sans 600, 80px, lh 1.10, ls -2px */
.hero-headline {
  font-family: var(--font-sans);
  font-size: var(--fs-hero-display);
  font-weight: var(--fw-semibold);
  line-height: var(--lh-hero-display);
  letter-spacing: var(--ls-hero-display);
  color: var(--color-ink-strong);
  margin-bottom: var(--space-lg);
  max-width: 840px;
}
@media (max-width: 768px) {
  .hero-headline {
    font-size: clamp(2.125rem, 8vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
}

/* Category Matrix Styles */
.category-matrix-section {
  padding: var(--space-section) var(--space-lg);
  background: var(--color-canvas);
  border-bottom: 1px solid var(--color-hairline);
}
.section-header-flex {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-xl);
}
.matrix-title {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-md);
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  margin: 0;
  letter-spacing: -0.01em;
}
.matrix-subtitle {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-steel);
  margin: 4px 0 0 0;
}
.matrix-link {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-semibold);
  color: var(--color-ink);
  text-decoration: underline;
}

.matrix-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: var(--space-xl);
}
@media (min-width: 640px) { .matrix-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .matrix-grid { grid-template-columns: repeat(4, 1fr); } }

.product-card {
  border-radius: var(--radius-hero);
  padding: var(--space-xxl);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 340px;
  transition: transform 250ms var(--ease-out), box-shadow 250ms var(--ease-out);
}
.product-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-atmospheric);
}

.product-card-coral {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 50%, #c2410c 100%);
  color: #ffffff;
}
.product-card-blue {
  background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 50%, #0369a1 100%);
  color: #ffffff;
}
.product-card-magenta {
  background: linear-gradient(135deg, #d946ef 0%, #c026d3 50%, #a21caf 100%);
  color: #ffffff;
}
.product-card-purple {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6d28d9 100%);
  color: #ffffff;
}

.card-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  color: #ffffff;
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: var(--fw-semibold);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--space-md);
}
.card-hero-title {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-md);
  font-weight: var(--fw-semibold);
  line-height: 1.15;
  margin: 0 0 var(--space-xs) 0;
  letter-spacing: -0.015em;
}
.card-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  margin: 0;
}
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-xl);
}
.card-meta {
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: var(--fw-semibold);
  color: rgba(255, 255, 255, 0.9);
}
.card-arrow {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #ffffff;
  transition: background 200ms ease, color 200ms ease;
}
.product-card:hover .card-arrow {
  background: #ffffff;
  color: #0f172a;
}

/* body-md spec: Inter 400, 16px, lh 1.5, ls +0.16px, body color */
.hero-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  font-weight: var(--fw-medium);
  line-height: var(--lh-body);
  letter-spacing: var(--ls-body);
  color: var(--color-body);
  max-width: 520px;
  margin-bottom: var(--space-xl);           /* 32px */
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
}

/* CTA row: ink pill + outline secondary, 40px height */
.hero-cta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);                     /* 12px */
  margin-bottom: var(--space-xxl);          /* 48px */
  flex-wrap: wrap;
}

/* Stats — Inter numbers, caption-uppercase labels */
.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xl);                     /* 32px */
  flex-wrap: wrap;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.stat-num {
  font-family: var(--font-sans);
  font-size: var(--fs-title-md);            /* 20px */
  font-weight: var(--fw-medium);            /* 500 */
  color: var(--color-ink);
  line-height: var(--lh-title-md);
}
.stat-label {
  font-family: var(--font-sans);
  font-size: var(--fs-caption-upper);       /* 12px */
  font-weight: var(--fw-semibold);          /* 600 */
  letter-spacing: var(--ls-caption-upper);  /* 0.08em */
  text-transform: uppercase;
  color: var(--color-muted);
}
.stat-divider {
  width: 1px;
  height: 32px;
  background: var(--color-hairline);
}

/* ════════════════════════════════════════════════════════════
   SPOTLIGHT SECTION
   feature-card: white, hairline, xl radius
════════════════════════════════════════════════════════════ */
.spotlight-section {
  background: rgba(250, 250, 250, 0.45);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
}

.section-header {
  margin-bottom: var(--space-lg);           /* 24px */
}

.spotlight-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
  border-radius: var(--radius-xl);
  overflow: hidden;
  text-decoration: none;
  transition: box-shadow var(--duration-200) var(--ease-out);
}
.spotlight-card:hover {
  box-shadow: var(--shadow-card-hover);
}
@media (max-width: 768px) {
  .spotlight-card { grid-template-columns: 1fr; }
}

.spotlight-image-col {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--color-surface-strong);
  position: relative;
}
.spotlight-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 400ms var(--ease-out);
}
.spotlight-card:hover .spotlight-img { transform: scale(1.03); }
.spotlight-img-placeholder {
  width: 100%; height: 100%;
  background: var(--color-canvas-soft);
  position: relative;
  overflow: hidden;
}
.placeholder-orb-mint {
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(167, 229, 211, 0.5) 0%, transparent 70%);
  top: -40px; left: -40px;
}
.placeholder-orb-peach {
  width: 180px; height: 180px;
  background: radial-gradient(circle, rgba(244, 197, 168, 0.4) 0%, transparent 70%);
  bottom: -30px; right: -30px;
}

.spotlight-content-col {
  padding: var(--space-xl);                 /* 32px */
