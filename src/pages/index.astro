---
// Home page
import Layout from '@/components/layout/Layout.astro';
import { getPublishedArticlesWithFallback } from '@/lib/supabase';
import ArticleCard from '@/components/ui/ArticleCard.astro';

const articles = await getPublishedArticlesWithFallback(6);
const articleData = articles.map(article => ({
  title: article.title,
  excerpt: article.excerpt ?? article.content?.substring(0, 150) + '...',
  publishedAt: article.published_at,
  authorName: article.author?.full_name ?? article.author?.username ?? 'Unknown',
  authorImage: article.author?.avatar_url,
  slug: article.slug,
  coverImage: article.cover_image_url
}));
const heroArticle = articleData[0] || null;
const gridArticles = articleData.slice(1);
---

<Layout title="Carcblog — AI-Native Publishing" description="Discover thoughtful writing from insightful writers on Carcblog">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO — Full-bleed dark gradient
  ═══════════════════════════════════════════════ -->
  <section class="hero-section">
    <!-- Background orbs / glow -->
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>

    <div class="hero-inner">
      <!-- Eyebrow pill -->
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        AI-Native Publishing Platform
      </div>

      <!-- Main headline -->
      <h1 class="hero-headline">
        Where Great<br/>
        <span class="headline-gradient">Ideas Go Public</span>
      </h1>

      <!-- Sub -->
      <p class="hero-sub">
        Carcblog is the writer's canvas — a distraction-free publishing environment 
        built for people who believe words still matter.
      </p>

      <!-- CTA Row -->
      <div class="hero-cta-row">
        <a href="/dashboard/articles/new" class="cta-primary">
          Start Writing Free
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/discover" class="cta-ghost">Explore Stories</a>
      </div>

      <!-- Social proof numbers -->
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-num">12K+</span>
          <span class="stat-label">Writers</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">84K+</span>
          <span class="stat-label">Articles Published</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">2.4M</span>
          <span class="stat-label">Monthly Readers</span>
        </div>
      </div>
    </div>

    <!-- Hero visual — editor mockup card -->
    <div class="hero-visual-wrapper">
      <div class="hero-visual-card">
        <div class="visual-chrome">
          <div class="chrome-dots">
            <span class="cdot cdot-red"></span>
            <span class="cdot cdot-yellow"></span>
            <span class="cdot cdot-green"></span>
          </div>
          <span class="chrome-title">Carcblog Editor</span>
        </div>
        <div class="visual-body">
          <div class="v-line v-line-title"></div>
          <div class="v-line v-line-lg"></div>
          <div class="v-line v-line-md"></div>
          <div class="v-line v-line-sm"></div>
          <div class="v-line v-line-md" style="width:72%"></div>
          <div class="v-line v-line-sm" style="width:55%"></div>
          <div class="ai-chip">
            <span class="ai-chip-icon">✦</span>
            <span><strong>AI:</strong> Suggested headline is 18% more engaging — apply?</span>
            <button class="ai-chip-btn">Apply</button>
          </div>
        </div>
      </div>
      <!-- card shadow ground -->
      <div class="card-shadow"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: FEATURED ARTICLE SPOTLIGHT
  ═══════════════════════════════════════════════ -->
  {heroArticle && (
    <section class="spotlight-section">
      <div class="section-container">
        <div class="section-label">Featured Story</div>
        <a href={`/article/${heroArticle.slug.current}`} class="spotlight-card">
          <div class="spotlight-image-col">
            {heroArticle.coverImage ? (
              <img src={heroArticle.coverImage} alt={heroArticle.title} class="spotlight-img" loading="eager" />
            ) : (
              <div class="spotlight-img-placeholder"></div>
            )}
          </div>
          <div class="spotlight-content-col">
            <time class="spotlight-date">
              {new Date(heroArticle.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
            <h2 class="spotlight-title">{heroArticle.title}</h2>
            {heroArticle.excerpt && (
              <p class="spotlight-excerpt">{heroArticle.excerpt}</p>
            )}
            <div class="spotlight-footer">
              <div class="spotlight-author">
                {heroArticle.author.image && (
                  <img src={heroArticle.author.image} alt={heroArticle.author.name} class="author-avatar" />
                )}
                <span class="author-name">{heroArticle.author.name}</span>
              </div>
              <span class="spotlight-cta">Read story →</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════
       SECTION 3: MORE STORIES GRID
  ═══════════════════════════════════════════════ -->
  <section class="grid-section">
    <div class="section-container">
      <div class="grid-header">
        <h2 class="grid-title">
          {heroArticle ? 'More Stories' : 'Featured Stories'}
        </h2>
        <a href="/feed" class="grid-view-all">View all →</a>
      </div>

      {(heroArticle ? gridArticles : featuredArticles).length > 0 ? (
        <div class="articles-grid">
          {(heroArticle ? gridArticles : featuredArticles).map((article) => (
            <ArticleCard
              title={article.title}
              excerpt={article.excerpt}
              publishedAt={article.publishedAt}
              authorName={article.author.name}
              authorImage={article.author.image}
              slug={article.slug.current}
              coverImage={article.coverImage}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state-box">
          <p class="empty-eyebrow">Nothing yet</p>
          <h3 class="empty-title">Be the first to publish</h3>
          <p class="empty-body">Your story starts here. Create your first article and join a community of thoughtful writers.</p>
          <a href="/dashboard/articles/new" class="cta-primary inline-cta">Write your first story →</a>
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: NEWSLETTER / CTA
  ═══════════════════════════════════════════════ -->
  <section class="cta-section">
    <div class="cta-orb cta-orb-1"></div>
    <div class="cta-orb cta-orb-2"></div>
    <div class="cta-content">
      <p class="cta-eyebrow">Join 12,000 writers</p>
      <h2 class="cta-headline">Your ideas deserve<br/>a better home.</h2>
      <p class="cta-body">
        Get early access to writing tools, editorial insights, and a community of people who take their craft seriously.
      </p>
      <div class="cta-actions">
        <a href="/sign-up" class="cta-primary cta-primary--large">Start Publishing Free</a>
        <a href="/about" class="cta-ghost cta-ghost--dark">Learn more</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════
   HERO SECTION
════════════════════════════════════════════ */
.hero-section {
  background: #0a0a0f;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120px 24px 80px;
  position: relative;
  overflow: hidden;
  text-align: center;
}

/* Glowing orbs in background */
.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}
.hero-orb-1 {
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(0,102,204,0.35) 0%, transparent 70%);
  top: -150px; left: 50%;
  transform: translateX(-50%);
}
.hero-orb-2 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(124,58,237,0.2) 0%, transparent 70%);
  bottom: 100px; right: 10%;
}
.hero-orb-3 {
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(6,182,212,0.15) 0%, transparent 70%);
  bottom: 0; left: 5%;
}

.hero-inner {
  position: relative;
  z-index: 2;
  max-width: 760px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Eyebrow pill */
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.7);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  padding: 6px 14px;
  border-radius: 9999px;
  margin-bottom: 32px;
}
.eyebrow-dot {
  width: 6px; height: 6px;
  background: #0ea5e9;
  border-radius: 50%;
  animation: pulse-dot 2s ease infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

/* Main headline */
.hero-headline {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(3rem, 7vw, 5.5rem);
  font-weight: 700;
  line-height: 1.05;
  color: #ffffff;
  margin-bottom: 24px;
  letter-spacing: -0.02em;
}
.headline-gradient {
  background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 50%, #34d399 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Subheadline */
.hero-sub {
  font-size: 18px;
  line-height: 1.6;
  color: rgba(255,255,255,0.55);
  max-width: 520px;
  margin-bottom: 40px;
}

/* CTA row */
.hero-cta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-bottom: 56px;
  flex-wrap: wrap;
}

.cta-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #0066cc;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  padding: 13px 24px;
  border-radius: 9999px;
  text-decoration: none;
  transition: all 220ms cubic-bezier(0.4,1.3,0.65,1);
  white-space: nowrap;
}
.cta-primary:hover {
  background: #0071e3;
  transform: scale(1.03);
  box-shadow: 0 8px 24px rgba(0,102,204,0.4);
}
.cta-primary:active { transform: scale(0.97); }

.cta-ghost {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.10);
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 9999px;
  border: 1.5px solid rgba(255,255,255,0.28);
  text-decoration: none;
  transition: all 220ms ease;
  white-space: nowrap;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}
.cta-ghost:hover {
  background: rgba(255,255,255,0.18);
  border-color: rgba(255,255,255,0.4);
  transform: scale(1.02);
}

/* Stats row */
.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32px;
  flex-wrap: wrap;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.stat-num {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.02em;
}
.stat-label {
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.stat-divider {
  width: 1px;
  height: 32px;
  background: rgba(255,255,255,0.12);
}

/* Hero editor mockup */
.hero-visual-wrapper {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 680px;
  margin-top: 64px;
}
.hero-visual-card {
  background: #14141a;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 14px;
  overflow: hidden;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.05),
    0 40px 80px rgba(0,0,0,0.6),
    0 0 60px rgba(0,102,204,0.15);
}
.visual-chrome {
  height: 36px;
  background: #1a1a24;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 10px;
}
.chrome-dots {
  display: flex;
  gap: 6px;
}
.cdot {
  width: 10px; height: 10px;
  border-radius: 50%;
}
.cdot-red { background: #ff5f57; }
.cdot-yellow { background: #febc2e; }
.cdot-green { background: #28c840; }
.chrome-title {
  font-size: 11px;
  color: rgba(255,255,255,0.3);
  margin-left: auto;
  margin-right: auto;
  letter-spacing: 0.02em;
}
.visual-body {
  padding: 28px 32px 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.v-line {
  height: 10px;
  border-radius: 6px;
  background: rgba(255,255,255,0.08);
}
.v-line-title {
  height: 18px;
  width: 65%;
  background: rgba(255,255,255,0.14);
  margin-bottom: 4px;
}
.v-line-lg { width: 90%; }
.v-line-md { width: 78%; }
.v-line-sm { width: 45%; }

.ai-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(99,102,241,0.12);
  border: 1px solid rgba(99,102,241,0.25);
  border-radius: 8px;
  padding: 10px 14px;
  margin-top: 12px;
  font-size: 12px;
  color: rgba(255,255,255,0.75);
}
.ai-chip-icon {
  color: #a78bfa;
  font-size: 14px;
}
.ai-chip-btn {
  margin-left: auto;
  background: #6366f1;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  white-space: nowrap;
}

.card-shadow {
  height: 24px;
  margin: 0 32px;
  background: radial-gradient(ellipse at center, rgba(0,0,0,0.5) 0%, transparent 70%);
}

/* ════════════════════════════════════════════
   SHARED SECTION UTILS
════════════════════════════════════════════ */
.section-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

.section-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #0066cc;
  margin-bottom: 20px;
}

/* ════════════════════════════════════════════
   SECTION 2: SPOTLIGHT
════════════════════════════════════════════ */
.spotlight-section {
  background: #f5f5f7;
  padding: 80px 0;
  border-bottom: 1px solid #e8e8ed;
}

.spotlight-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  background: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  overflow: hidden;
  text-decoration: none;
  transition: all 250ms cubic-bezier(0.4,1.3,0.65,1);
}
.spotlight-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  border-color: #c0c0c0;
}
@media (max-width: 768px) {
  .spotlight-card { grid-template-columns: 1fr; gap: 0; }
}

.spotlight-image-col {
  aspect-ratio: 4/3;
  overflow: hidden;
  background: #f5f5f7;
}
.spotlight-img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 400ms ease;
}
.spotlight-card:hover .spotlight-img { transform: scale(1.04); }
.spotlight-img-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #e8e8ed 0%, #d0d0d8 100%);
}

.spotlight-content-col {
  padding: 40px 40px 40px 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
@media (max-width: 768px) {
  .spotlight-content-col { padding: 28px; }
}

.spotlight-date {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #86868b;
  margin-bottom: 12px;
  display: block;
}
.spotlight-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.15;
  margin-bottom: 16px;
}
.spotlight-excerpt {
  font-size: 15px;
  color: #6e6e73;
  line-height: 1.6;
  margin-bottom: 28px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.spotlight-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 20px;
  border-top: 1px solid #f0f0f0;
}
.spotlight-author {
  display: flex;
  align-items: center;
  gap: 8px;
}
.author-avatar {
  width: 28px; height: 28px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid #e0e0e0;
}
.author-name {
  font-size: 13px;
  font-weight: 600;
  color: #1d1d1f;
}
.spotlight-cta {
  font-size: 13px;
  font-weight: 700;
  color: #0066cc;
}

/* ════════════════════════════════════════════
   SECTION 3: GRID
════════════════════════════════════════════ */
.grid-section {
  background: #ffffff;
  padding: 80px 0;
  border-bottom: 1px solid #e8e8ed;
}

.grid-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 36px;
}
.grid-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 2rem;
  font-weight: 700;
  color: #1d1d1f;
}
.grid-view-all {
  font-size: 13px;
  font-weight: 600;
  color: #0066cc;
  text-decoration: none;
}
.grid-view-all:hover { text-decoration: underline; }

.articles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 360px));
  gap: 24px;
  justify-content: center;   /* centers columns when fewer than full row */
}

/* Empty state */
.empty-state-box {
  text-align: center;
  padding: 80px 24px;
  border: 1px dashed #d0d0d8;
  border-radius: 16px;
}
.empty-eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #86868b;
  margin-bottom: 8px;
}
.empty-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 2rem;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 12px;
}
.empty-body {
  font-size: 15px;
  color: #6e6e73;
  max-width: 400px;
  margin: 0 auto 28px;
  line-height: 1.6;
}
.inline-cta { display: inline-flex; }

/* ════════════════════════════════════════════
   SECTION 4: CTA SECTION
════════════════════════════════════════════ */
.cta-section {
  background: #0a0a0f;
  padding: 120px 24px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.cta-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}
.cta-orb-1 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(0,102,204,0.3) 0%, transparent 70%);
  top: -100px; left: -100px;
}
.cta-orb-2 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(124,58,237,0.25) 0%, transparent 70%);
  bottom: -80px; right: 5%;
}
.cta-content {
  position: relative;
  z-index: 2;
  max-width: 680px;
  margin: 0 auto;
}
.cta-eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #60a5fa;
  margin-bottom: 20px;
}
.cta-headline {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 20px;
}
.cta-body {
  font-size: 17px;
  color: rgba(255,255,255,0.5);
  line-height: 1.6;
  margin-bottom: 40px;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}
.cta-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}
.cta-primary--large {
  padding: 16px 32px;
  font-size: 15px;
}
.cta-ghost--dark {
  color: rgba(255,255,255,0.65);
  border-color: rgba(255,255,255,0.18);
  background: rgba(255,255,255,0.05);
}
.cta-ghost--dark:hover {
  color: #fff;
  background: rgba(255,255,255,0.1);
}

/* ════════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════════ */
@media (max-width: 640px) {
  .hero-stats { gap: 20px; }
  .stat-divider { display: none; }
  .hero-section { padding: 100px 16px 60px; }
}
</style>
