---
// Topics page — ElevenLabs editorial design system
import Layout from '@/components/layout/Layout.astro';
---
<Layout title="Topics — Carcblog" description="Browse and explore all topics on Carcblog">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: TRENDING TOPICS
       canvas-soft bg, display-lg title, feature-card categories
  ═══════════════════════════════════════════════ -->
  <section class="topics-section topics-section--soft">
    <div class="page-container">
      <div class="sec-header">
        <h1 class="sec-title">Trending Topics</h1>
        <p class="sec-sub">Browse popular segments of the publishing canvas.</p>
      </div>

      <div class="categories-grid">
        {[
          { href: '/discover#technology', icon: '📱', name: 'Technology', count: '1.2M', desc: 'Latest insights on software, developer tools, and neural innovations.' },
          { href: '/discover#science',    icon: '🔬', name: 'Science',    count: '850K', desc: 'Breakthroughs, aerospace discoveries, and research progress reports.' },
          { href: '/discover#culture',    icon: '🎨', name: 'Arts & Culture', count: '620K', desc: 'Exploring modern design systems, creative expressions, and aesthetics.' },
          { href: '/discover#history',    icon: '🏛️', name: 'History',    count: '480K', desc: 'Historical records, retro analysis, and stories that explain the present.' },
          { href: '/discover#business',   icon: '💼', name: 'Business',   count: '550K', desc: 'SaaS architecture, startup ecosystems, and business leadership strategies.' },
          { href: '/discover#travel',     icon: '🌍', name: 'Travel',     count: '310K', desc: 'Destinations, cultural journals, and global landscape photography.' }
        ].map(({ href, icon, name, count, desc }) => (
          <a href={href} class="category-card" aria-label={`Explore ${name} topic — ${count} articles`}>
            <div class="cat-icon-box" aria-hidden="true">{icon}</div>
            <div class="cat-body">
              <div class="cat-meta">
                <h3 class="cat-name">{name}</h3>
                <span class="badge-pill cat-badge">{count}</span>
              </div>
              <p class="cat-desc">{desc}</p>
            </div>
            <span class="cat-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: ALL TOPICS DIRECTORY
       white bg, badge-pill cloud
  ═══════════════════════════════════════════════ -->
  <section class="topics-section">
    <div class="page-container">
      <div class="sec-header">
        <h2 class="sec-title">All Topics</h2>
        <p class="sec-sub">A comprehensive list of publication categories.</p>
      </div>

      <div class="topics-cloud">
        {[
          'Technology', 'Science', 'Arts & Culture', 'History', 'Business', 'Travel',
          'Food & Drink', 'Health & Wellness', 'Personal Growth', 'Relationships',
          'Environment', 'Philosophy', 'Finance', 'Space', 'Design', 'Politics'
        ].map((topic) => (
          <a href={`/discover#${topic.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="badge-pill topic-cloud-pill">
            {topic}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3: CTA BAND
       cta-band spec: canvas bg, display-lg, ink pill
  ═══════════════════════════════════════════════ -->
  <section class="topics-cta-band">
    <!-- Atmospheric orbs -->
    <div class="atm-orb topics-cta-orb-mint"     aria-hidden="true"></div>
    <div class="atm-orb topics-cta-orb-lavender" aria-hidden="true"></div>

    <div class="page-container topics-cta-inner">
      <span class="badge-pill cta-eyebrow">Share your perspective</span>
      <h2 class="cta-headline">Want to contribute?</h2>
      <p class="cta-body">
        Share your expertise by writing about topics you are passionate about with a growing audience that cares.
      </p>
      <a href="/dashboard/articles/new" class="btn-primary" id="topics-cta-write">Write an Article</a>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════════════════════
   TOPICS PAGE — ElevenLabs editorial system
════════════════════════════════════════════════════════════ */
.topics-section {
  background: var(--color-surface-card);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
}
.topics-section--soft {
  background: var(--color-canvas-soft);
}

.sec-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}
/* display-lg: EB Garamond 300, 36px */
.sec-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-xs);
}
.sec-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-muted);
}

/* ── Categories Grid — white feature-card, hairline, xl radius ── */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}
@media (max-width: 960px) { .categories-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .categories-grid { grid-template-columns: 1fr; } }

.category-card {
  background: var(--color-surface-card);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  transition: box-shadow var(--duration-200) var(--ease-out), border-color var(--duration-200) var(--ease-out);
}
.category-card:hover {
  border-color: var(--color-hairline-strong);
  box-shadow: var(--shadow-card-hover);
}

/* voice-icon-circular style */
.cat-icon-box {
  font-size: 20px;
  width: 44px; height: 44px;
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline-soft);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-body {
  flex: 1;
}
.cat-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-xs);
  margin-bottom: var(--space-xs);
}
/* title-sm: Inter 500 */
.cat-name {
  font-family: var(--font-sans);
  font-size: var(--fs-title-sm);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  margin: 0;
}
.cat-badge {
  font-size: 11px;
}
.cat-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-body);
  line-height: var(--lh-body-sm);
  margin: 0;
}

.cat-arrow {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  color: var(--color-muted-soft);
  transition: transform var(--duration-150) var(--ease-out), color var(--duration-150) var(--ease-out);
  align-self: flex-end;
  margin-top: auto;
}
.category-card:hover .cat-arrow {
  color: var(--color-ink);
  transform: translateX(4px);
}

/* ── Topics Cloud — badge pills ── */
.topics-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  justify-content: center;
  max-width: 800px;
  margin: 0 auto;
}
.topic-cloud-pill {
  font-size: var(--fs-body-sm);
  padding: 8px 20px;
  text-decoration: none;
  transition: background var(--duration-150) var(--ease-out), border-color var(--duration-150) var(--ease-out);
  border: 1px solid var(--color-hairline);
  cursor: pointer;
}
.topic-cloud-pill:hover {
  background: var(--color-hairline-soft);
  border-color: var(--color-hairline-strong);
  color: var(--color-ink);
}

/* ── CTA Band ── */
.topics-cta-band {
  background: var(--color-canvas);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
  position: relative;
  overflow: hidden;
}
.topics-cta-orb-mint {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(167, 229, 211, 0.4) 0%, transparent 70%);
  top: -80px; left: 10%;
  pointer-events: none;
}
.topics-cta-orb-lavender {
  width: 350px; height: 350px;
  background: radial-gradient(circle, rgba(200, 184, 224, 0.35) 0%, transparent 70%);
  bottom: -60px; right: 10%;
  pointer-events: none;
}
.topics-cta-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cta-eyebrow {
  margin-bottom: var(--space-lg);
}
/* display-lg: EB Garamond 300, 36px */
.cta-headline {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-md);
}
.cta-body {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  color: var(--color-body);
  line-height: var(--lh-body);
  max-width: 500px;
  margin-bottom: var(--space-xl);
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .topics-section, .topics-cta-band {
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-xxl);
  }
  .cta-headline { font-size: var(--fs-display-sm); }
}
</style>