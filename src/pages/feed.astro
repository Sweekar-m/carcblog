---
// Feed page — ElevenLabs editorial design system
export const prerender = false;
import Layout from '@/components/layout/Layout.astro';
import { getSanityArticles, safeImageUrl } from '@/lib/sanity';
import ArticleCard from '@/components/ui/ArticleCard.astro';

const sanityArticles = await getSanityArticles({ limit: 12 });
const recentArticles = sanityArticles.map(article => ({
  title: article.title,
  excerpt: article.excerpt ?? "(no excerpt)",
  publishedAt: article.publishedAt ?? new Date().toISOString(),
  authorName: article.author?.name ?? "Unknown",
  authorImage: safeImageUrl(article.author?.image) ?? null,
  slug: typeof article.slug === 'string' ? article.slug : (article.slug as any)?.current ?? '',
  coverImage: safeImageUrl(article.coverImage, article.body) ?? null
}));



---

<Layout title="Your Feed — Carcblog" description="Discover new articles from writers you follow on Carcblog">

  <div class="feed-page">

    <!-- ── Page header: canvas bg, display-xl headline, badge-pill filters ── -->
    <div class="feed-header">
      <div class="page-container">
        <div class="fh-inner">
          <div class="fh-text">
            <h1 class="feed-title">Your Feed</h1>
            <p class="feed-sub">Curated stories from writers and topics you care about.</p>
          </div>
          <!-- Filter badge-pills: surface-strong bg, ink text, caption-uppercase, pill radius -->
          <div class="feed-filters" role="group" aria-label="Feed filters">
            <button class="filter-pill filter-pill--active" id="filter-all">All</button>
            <button class="filter-pill" id="filter-following">Following</button>
            <button class="filter-pill" id="filter-trending">Trending</button>
            <button class="filter-pill" id="filter-new">New</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Articles grid: 3-up → 2-up → 1-up ── -->
    <div class="feed-body">
      <div class="page-container">

        {recentArticles.length > 0 ? (
          <>
            <div class="articles-grid reveal-grid">
              {recentArticles.map((article) => (
                <ArticleCard
                  title={article.title}
                  excerpt={article.excerpt}
                  publishedAt={article.publishedAt}
                  authorName={article.authorName}
                  authorImage={article.authorImage}
                  slug={article.slug}
                  coverImage={article.coverImage}
                />
              ))}
            </div>

            <!-- Load more — outline pill -->
            <div class="load-more reveal-single">
              <button class="btn-outline" id="load-more-btn">
                Load more stories
              </button>
            </div>
          </>
        ) : (
          <!-- Empty state — atmospheric orb decoration -->
          <div class="empty-state reveal-single" role="status">
            <div class="empty-orb-sky"    aria-hidden="true"></div>
            <div class="empty-orb-rose"   aria-hidden="true"></div>
            <span class="badge-pill empty-eyebrow">Nothing here yet</span>
            <h2 class="empty-title">Your feed is empty</h2>
            <p class="empty-desc">
              Follow writers and explore topics to start seeing articles here.
              There's a lot of great writing waiting.
            </p>
            <div class="empty-actions">
              <a href="/discover" class="btn-primary" id="feed-empty-discover">Explore topics</a>
              <a href="/dashboard/articles/new" class="btn-outline" id="feed-empty-write">Write your first article</a>
            </div>
          </div>
        )}

      </div>
    </div>
  </div>

</Layout>

<style>
/* ════════════════════════════════════════════════════════════
   FEED PAGE — editorial design system
════════════════════════════════════════════════════════════ */
.feed-page {
  min-height: calc(100vh - var(--h-nav));
  background: transparent;
}

/* ── Feed header — surface-card, hairline bottom ── */
.feed-header {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--color-hairline);
  padding: var(--space-xl) 0;              /* 32px */
}
.fh-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-lg);
  flex-wrap: wrap;
}
.fh-text { flex: 1; }

/* heading-lg: DM Sans 600, 40px */
.feed-title {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-lg);
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  line-height: var(--lh-heading-lg);
  letter-spacing: -0.015em;
  margin-bottom: var(--space-xs);
}
/* body-sm: DM Sans 400, 15px */
.feed-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-regular);
  color: var(--color-steel);
  line-height: var(--lh-body-sm);
}

/* Filter badge-pills — surface-strong bg, ink text, caption-uppercase, pill radius */
.feed-filters {
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
  align-items: flex-start;
  padding-top: var(--space-xs);
}
.filter-pill {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: var(--fw-semibold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-ink);
  background: var(--color-surface);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-full);
  padding: 8px 16px;
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--duration-150) var(--ease-out), border-color var(--duration-150) var(--ease-out);
}
.filter-pill:hover {
  background: var(--color-surface-soft);
  border-color: var(--color-hairline-strong);
}
/* Active filter: ink background, white text */
.filter-pill--active {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-color: var(--color-primary);
}
.filter-pill--active:hover {
  background: var(--color-primary-active);
  border-color: var(--color-primary-active);
}

/* ── Feed body ── */
.feed-body {
  padding: var(--space-xxl) 0 var(--space-section);  /* 48px top, 96px bottom */
}

/* 3-up → 2-up → 1-up article grid */
.articles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-lg);                    /* 24px */
  margin-bottom: var(--space-xxl);
}
@media (max-width: 1024px) {
  .articles-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .articles-grid { grid-template-columns: 1fr; }
}

/* Load more — centered outline pill */
.load-more {
  text-align: center;
}

/* ── Empty state — clean flat card ── */
.empty-state {
  text-align: center;
  padding: var(--space-section) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-xl);
  background: var(--color-canvas);
}
.empty-orb-sky, .empty-orb-rose { display: none; }
.empty-eyebrow {
  margin-bottom: var(--space-sm);
  position: relative;
  z-index: 1;
}
.empty-title {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-md);
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  margin-bottom: var(--space-sm);
  position: relative;
  z-index: 1;
}
.empty-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-body);
  max-width: 420px;
  line-height: var(--lh-body);
  margin-bottom: var(--space-xl);
  position: relative;
  z-index: 1;
}
.empty-actions {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
  justify-content: center;
  position: relative;
  z-index: 1;
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .feed-title { font-size: var(--fs-display-md); }
  .fh-inner { flex-direction: column; }
  .feed-body {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xxl);
  }
}
</style>
