---
import Layout from '@/layouts/Layout.astro';
import DashboardPage from '@/components/dashboard/DashboardPage.astro';
import { getCurrentUser } from '@/lib/auth';
import { getUserReadingHistory } from '@/lib/social';
import ArticleCard from '@/components/ui/ArticleCard.astro';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

const historyArticles = await getUserReadingHistory(user.id);
---

<Layout title="Reading History - Dashboard" description="Your article reading history on Carcblog" hideSidebar={false}>
  <DashboardPage title="Reading History" subtitle="Articles you've recently viewed.">
    {historyArticles.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 reveal-grid">
        {historyArticles.map((article) => (
          <ArticleCard
            title={article.title}
            excerpt={article.excerpt}
            publishedAt={article.publishedAt || new Date().toISOString()}
            authorName={article.author?.name || 'Writer'}
            authorImage={typeof article.author?.image === 'string' ? article.author.image : null}
            slug={typeof article.slug === 'string' ? article.slug : (article.slug as any)?.current || ''}
            coverImage={typeof article.coverImage === 'string' ? article.coverImage : null}
          />
        ))}
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center text-center px-6 py-16 sm:py-24 bg-surface border border-dashed border-hairline-strong rounded-xl">
        <p class="font-sans text-base sm:text-lg font-semibold text-ink mb-2">No reading history yet</p>
        <p class="font-sans text-sm text-steel max-w-sm mb-5">
          As you read articles across Carcblog, your recent reading history will appear here.
        </p>
        <a href="/" class="btn-primary inline-flex">Start Reading</a>
      </div>
    )}
  </DashboardPage>
</Layout>
