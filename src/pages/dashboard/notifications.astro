---
import Layout from '@/layouts/Layout.astro';
import { getCurrentUser } from '@/lib/auth';
import { getUserNotifications, markNotificationsAsRead } from '@/lib/social';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

const notifications = await getUserNotifications(user.id);
await markNotificationsAsRead(user.id); // Mark all as read when visiting full page
---

<Layout title="Notifications - Dashboard" description="Your activity notifications on Carcblog">
  <div class="dashboard-page">
    <div class="page-header">
      <h1 class="page-title">Notifications</h1>
      <p class="page-sub">Updates on your content, comments, and followers.</p>
    </div>

    {notifications.length > 0 ? (
      <div class="notifications-list">
        {notifications.map((n) => {
          const actorName = n.actor?.full_name || n.actor?.username || 'Someone';
          return (
            <div class={`notification-item ${!n.is_read ? 'notification-item--unread' : ''}`}>
              <div class="actor-avatar">
                {n.actor?.avatar_url ? (
                  <img src={n.actor.avatar_url} alt={actorName} />
                ) : (
                  <span>{actorName.charAt(0).toUpperCase()}</span>
                )}
              </div>
              <div class="notification-content">
                <p class="notification-text">
                  <strong>{actorName}</strong>{' '}
                  {n.type === 'follow' && 'started following you.'}
                  {n.type === 'like' && 'liked your article.'}
                  {n.type === 'comment_reply' && 'responded to your post/comment.'}
                </p>
                <span class="notification-date">
                  {new Date(n.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}
                </span>
              </div>
              {n.article_id && (
                <a href={`/article/${n.article_id}`} class="btn-outline" style="font-size: 11px; padding: 4px 10px;">View Article</a>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div class="empty-box">
        <p class="empty-title">No notifications yet</p>
        <p class="empty-sub">When readers like your posts, comment, or follow your profile, alerts will appear here.</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .dashboard-page { display: flex; flex-direction: column; gap: var(--space-xl); }
  .page-header { border-bottom: 1px solid var(--color-hairline); padding-bottom: var(--space-md); }
  .page-title { font-family: var(--font-sans); font-size: var(--fs-heading-md); font-weight: var(--fw-semibold); color: var(--color-ink-strong); margin: 0 0 4px 0; }
  .page-sub { font-family: var(--font-sans); font-size: var(--fs-body-sm); color: var(--color-steel); margin: 0; }
  .notifications-list { display: flex; flex-direction: column; gap: 1px; background: var(--color-hairline-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-xl); overflow: hidden; }
  .notification-item { background: var(--color-canvas); padding: 14px 18px; display: flex; align-items: center; gap: 14px; transition: background 150ms ease; }
  .notification-item--unread { background: rgba(14, 165, 233, 0.04); }
  .actor-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--color-surface-strong); border: 1px solid var(--color-hairline); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; font-weight: 700; color: var(--color-ink); }
  .actor-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .notification-content { flex: 1; min-width: 0; }
  .notification-text { font-family: var(--font-sans); font-size: var(--fs-body-sm); color: var(--color-ink); margin: 0 0 2px 0; }
  .notification-date { font-family: var(--font-sans); font-size: 11px; color: var(--color-muted); }
  .empty-box { background: var(--color-surface); border: 1px dashed var(--color-hairline-strong); border-radius: var(--radius-xl); padding: var(--space-xxl); text-align: center; }
  .empty-title { font-family: var(--font-sans); font-size: var(--fs-card-title); font-weight: var(--fw-semibold); color: var(--color-ink); margin: 0 0 8px 0; }
  .empty-sub { font-family: var(--font-sans); font-size: var(--fs-body-sm); color: var(--color-steel); margin: 0; }
</style>
