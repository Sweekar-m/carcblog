---
import Layout from '@/layouts/Layout.astro';
import DashboardPage from '@/components/dashboard/DashboardPage.astro';
import { getCurrentUser } from '@/lib/auth';
import { getUserNotifications, markNotificationsAsRead } from '@/lib/social';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

const notifications = await getUserNotifications(user.id);
await markNotificationsAsRead(user.id);
---

<Layout title="Notifications - Dashboard" description="Your activity notifications on Carcblog" hideSidebar={false}>
  <DashboardPage title="Notifications" subtitle="Updates on your content, comments, and followers.">
    {notifications.length > 0 ? (
      <div class="flex flex-col divide-y divide-hairline border border-hairline rounded-xl overflow-hidden bg-canvas">
        {notifications.map((n) => {
          const actorName = n.actor?.full_name || n.actor?.username || 'Someone';
          return (
            <div class={`flex items-center gap-4 px-4 sm:px-5 py-4 transition-colors hover:bg-surface ${!n.is_read ? 'bg-blue-50/40' : 'bg-canvas'}`}>
              <!-- Actor Avatar -->
              <div class="w-10 h-10 rounded-full bg-surface-strong border border-hairline flex items-center justify-center overflow-hidden shrink-0 font-bold text-ink text-sm font-sans">
                {n.actor?.avatar_url ? (
                  <img src={n.actor.avatar_url} alt={actorName} class="w-full h-full object-cover" />
                ) : (
                  <span>{actorName.charAt(0).toUpperCase()}</span>
                )}
              </div>
              <!-- Notification Content -->
              <div class="flex-1 min-w-0">
                <p class="font-sans text-sm text-ink leading-snug">
                  <strong>{actorName}</strong>{' '}
                  {n.type === 'follow' && 'started following you.'}
                  {n.type === 'like' && 'liked your article.'}
                  {n.type === 'comment_reply' && 'responded to your post/comment.'}
                </p>
                <span class="font-sans text-xs text-muted mt-0.5 block">
                  {new Date(n.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}
                </span>
              </div>
              <!-- Article Link -->
              {n.article_id && (
                <a
                  href={`/article/${n.article_id}`}
                  class="shrink-0 inline-flex items-center justify-center px-3 py-1.5 rounded-full border border-hairline bg-canvas text-ink font-semibold text-xs hover:bg-surface transition-colors whitespace-nowrap"
                >
                  View Article
                </a>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center text-center px-6 py-16 sm:py-24 bg-surface border border-dashed border-hairline-strong rounded-xl">
        <p class="font-sans text-base sm:text-lg font-semibold text-ink mb-2">No notifications yet</p>
        <p class="font-sans text-sm text-steel max-w-sm">
          When readers like your posts, comment, or follow your profile, alerts will appear here.
        </p>
      </div>
    )}
  </DashboardPage>
</Layout>
