---
// Dashboard index — Role-aware routing for Writers and Readers
import Layout from '@/layouts/Layout.astro';
import WriterDashboard from '@/components/dashboard/WriterDashboard.astro';
import { getSanityArticlesByAuthor } from '@/lib/sanity';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

interface UserStats {
  articleCount: number;
  viewCount: number;
  readTime: number;
}

interface ActivityItem {
  type: 'article' | 'engagement' | 'follow';
  id?: string;
  slug?: string;
  title: string;
  timestamp: string;
}

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

// Reader role gating: Redirect readers to their personal bookmarks tab
if (user.role === 'reader') {
  return Astro.redirect('/dashboard/bookmarks');
}

// Writer / Admin: Fetch user articles for overview
let userArticles: any[] = [];
try {
  userArticles = await getSanityArticlesByAuthor(user.id, 100);
} catch (error) {
  console.error('Failed to fetch user articles for dashboard:', error);
}

const stats: UserStats = {
  articleCount: userArticles.length,
  viewCount: 0,
  readTime: 0,
};

const recentActivity: ActivityItem[] = userArticles.length > 0
  ? userArticles
      .map(article => ({
        type: 'article' as const,
        id: article._id,
        slug: article.slug?.current || '',
        title: article.title,
        timestamp: article.publishedAt || (article as any)._createdAt || new Date().toISOString(),
      }))
      .sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime())
      .slice(0, 5)
  : [
      {
        type: 'article' as const,
        id: 'midnight-pivot-demo',
        slug: 'the-midnight-pivot-how-one-struggling-saas-rebuilt-everything-around-ai',
        title: 'The Midnight Pivot: How One Struggling SaaS Rebuilt Everything Around AI',
        timestamp: new Date().toISOString(),
      }
    ];
---
<Layout title="Writer Dashboard - Carcblog" description="Your writer dashboard">
  <WriterDashboard
    stats={stats}
    recentActivity={recentActivity}
    userName={user?.full_name?.split(' ')[0] || 'Writer'}
  />
</Layout>