---
// Dashboard Profile Page — User Profile View
import Layout from '@/layouts/Layout.astro';
import PublicProfileView from '@/components/islands/profile/PublicProfileView';
import {
  getProfileByUserId,
  getUserSocialLinks,
  getProfileStats,
  getUserActivityFeed,
  getUserFollowers,
  getUserFollowing
} from '@/lib/profile';
import { getSanityArticlesByAuthor } from '@/lib/sanity';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const currentUser = await getCurrentUser(Astro.locals);
if (!currentUser) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

let profile = await getProfileByUserId(currentUser.id);
if (!profile) {
  profile = {
    id: currentUser.id,
    username: currentUser.username || `user_${currentUser.id.slice(-6)}`,
    full_name: currentUser.full_name || 'User',
    avatar_url: currentUser.avatar_url || null,
    cover_url: null,
    bio: currentUser.bio || null,
    tagline: null,
    website: null,
    country: null,
    city: null,
    timezone: 'UTC',
    preferred_language: 'en',
    company: null,
    job_title: null,
    years_experience: 0,
    industry: null,
    skills: [],
    interests: [],
    expertise: [],
    writing_topics: [],
    notification_prefs: {},
    role: currentUser.role || 'writer',
    verified: false,
    onboarding_completed: true,
    profile_completion_pct: 50,
    created_at: new Date().toISOString()
  };
}

const [socialLinks, stats, userArticles, activityFeed, followersList, followingList] = await Promise.all([
  getUserSocialLinks(currentUser.id).catch(() => []),
  getProfileStats(currentUser.id).catch(() => ({ followersCount: 0, followingCount: 0, likesCount: 0, bookmarksCount: 0 })),
  getSanityArticlesByAuthor(currentUser.id, 50).catch(() => []),
  getUserActivityFeed(currentUser.id, 20).catch(() => []),
  getUserFollowers(currentUser.id).catch(() => []),
  getUserFollowing(currentUser.id).catch(() => []),
]);
---

<Layout
  title={`${profile.full_name || profile.username} — Profile`}
  description={profile.bio || `${profile.full_name}'s creator profile on CarcBlog.`}
  hideSidebar={true}
>
  <div class="pt-4 sm:pt-6">
    <PublicProfileView
      client:load
      profile={profile}
      socialLinks={socialLinks}
      stats={stats}
      followersList={followersList}
      followingList={followingList}
      userArticles={userArticles}
      activityFeed={activityFeed}
      currentUserId={currentUser.id}
      initialIsFollowing={false}
    />
  </div>
</Layout>