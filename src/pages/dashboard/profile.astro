---
// Profile page
import Layout from '@/layouts/Layout.astro';
import { supabase } from '@/lib/supabase';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
let profile = null;

if (user) {
  try {
    const { data: profileData, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', user.id)
      .single();
    if (error) throw error;
    profile = profileData;
  } catch (error) {
    console.error('Failed to fetch profile:', error);
    profile = {
      id: user.id,
      username: user.username,
      full_name: user.full_name,
      avatar_url: user.avatar_url,
      bio: user.bio,
      website: null,
      role: user.role,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    };
  }
}
---
<Layout title="Profile - Dashboard" description="Manage your account settings">

  <div class="page-content">

    <!-- Page header -->
    <div class="page-header">
      <h1 class="page-title">Profile</h1>
      <p class="page-sub">Manage your account information and preferences.</p>
    </div>

    <div class="profile-layout">

      <!-- Avatar card -->
      <div class="profile-card">
        <div class="avatar-section">
          <div class="avatar-wrap">
            {profile?.avatar_url ? (
              <img
                src={profile.avatar_url}
                alt={`${profile?.full_name || 'User'}'s avatar`}
                class="avatar-img"
              />
            ) : (
              <div class="avatar-placeholder">
                <span>{user?.full_name?.charAt(0)?.toUpperCase() || 'U'}</span>
              </div>
            )}
          </div>
          <h2 class="profile-name">{profile?.full_name || user?.full_name || 'Anonymous User'}</h2>
          <p class="profile-email">{(profile as any)?.email || user?.email || 'email@example.com'}</p>
          <span class="profile-role">{profile?.role || user?.role || 'Writer'}</span>
        </div>
      </div>

      <!-- Form card -->
      <div class="profile-card form-card">

        <!-- Account info rows -->
        <h3 class="form-section-title">Account</h3>
        <div class="info-rows">
          <div class="info-row">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div class="info-body">
              <p class="info-label">Username</p>
              <p class="info-value">{profile?.username || 'username'}</p>
            </div>
          </div>
          <div class="info-row">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="info-body">
              <p class="info-label">Email</p>
              <p class="info-value">{(profile as any)?.email || user?.email || 'email@example.com'}</p>
            </div>
          </div>
        </div>

        <!-- Bio -->
        <div class="form-group">
          <label class="form-label" for="bio">Bio</label>
          <textarea id="bio" rows="3" class="form-textarea" placeholder="Tell people about yourself...">{profile?.bio || user?.bio || ''}</textarea>
        </div>

        <!-- Social links -->
        <div class="form-group">
          <h3 class="form-section-title">Social Links</h3>
          <div class="social-inputs">
            <div class="social-row">
              <div class="social-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </div>
              <input type="text" id="twitter" class="social-input" placeholder="@yourhandle" />
            </div>
            <div class="social-row">
              <div class="social-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </div>
              <input type="text" id="instagram" class="social-input" placeholder="@yourhandle" />
            </div>
            <div class="social-row">
              <div class="social-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              </div>
              <input type="url" id="website" class="social-input" placeholder="https://yourwebsite.com" value={profile?.website || ''} />
            </div>
          </div>
        </div>

        <!-- Preferences -->
        <div class="form-group">
          <h3 class="form-section-title">Preferences</h3>
          <div class="pref-list">
            <label class="pref-row">
              <input type="checkbox" id="email-notifications" checked class="pref-check" />
              <div class="pref-body">
                <p class="pref-name">Email notifications for new followers</p>
                <p class="pref-desc">Get notified when someone follows you</p>
              </div>
            </label>
            <label class="pref-row">
              <input type="checkbox" id="newsletter" class="pref-check" />
              <div class="pref-body">
                <p class="pref-name">Newsletter subscription</p>
                <p class="pref-desc">Receive monthly digest of top stories</p>
              </div>
            </label>
            <label class="pref-row">
              <input type="checkbox" id="allow-comments" checked class="pref-check" />
              <div class="pref-body">
                <p class="pref-name">Allow comments on your articles</p>
                <p class="pref-desc">Readers can leave comments on your published work</p>
              </div>
            </label>
          </div>
        </div>

        <button id="saveButton" class="save-btn">Save Changes</button>
      </div>
    </div>

  </div>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const saveButton = document.getElementById('saveButton') as HTMLButtonElement;
    if (!saveButton) return;

    saveButton.addEventListener('click', async () => {
      const original = saveButton.textContent!;
      saveButton.textContent = 'Saving…';
      saveButton.disabled = true;
      await new Promise(r => setTimeout(r, 1400));
      saveButton.textContent = 'Saved!';
      saveButton.style.background = '#059669';
      setTimeout(() => {
        saveButton.textContent = original;
        saveButton.disabled = false;
        saveButton.style.background = '';
      }, 2000);
    });
  });
</script>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
  }

  /* ── Page header ── */
  .page-header { display: flex; flex-direction: column; gap: 5px; }

  .page-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .page-sub {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #86868b;
    margin: 0;
  }

  /* ── Layout ── */
  .profile-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 640px) {
    .profile-layout { grid-template-columns: 1fr; }
  }

  /* ── Card ── */
  .profile-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  /* ── Avatar section ── */
  .avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .avatar-wrap {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 4px;
    border: 3px solid rgba(0,102,204,0.15);
  }

  .avatar-img { width: 100%; height: 100%; object-fit: cover; }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0,102,204,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 28px;
    color: #0066cc;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
  }

  .profile-name {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0;
  }

  .profile-email {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 12px;
    color: #86868b;
    margin: 0;
    word-break: break-all;
  }

  .profile-role {
    display: inline-block;
    padding: 2px 10px;
    background: rgba(0,102,204,0.08);
    color: #0066cc;
    border-radius: 9999px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: capitalize;
  }

  /* ── Form card ── */
  .form-card {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .form-section-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #86868b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 10px;
  }

  /* ── Info rows ── */
  .info-rows { display: flex; flex-direction: column; gap: 6px; }

  .info-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: #f5f5f7;
    border-radius: 8px;
  }

  .info-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0066cc;
    flex-shrink: 0;
  }

  .info-body { display: flex; flex-direction: column; gap: 1px; }

  .info-label {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 11px;
    color: #86868b;
    margin: 0;
    font-weight: 500;
  }

  .info-value {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #1d1d1f;
    margin: 0;
    font-weight: 500;
  }

  /* ── Form groups ── */
  .form-group { display: flex; flex-direction: column; gap: 8px; }

  .form-label {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #1d1d1f;
  }

  .form-textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #1d1d1f;
    background: #ffffff;
    resize: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    box-sizing: border-box;
  }
  .form-textarea:focus {
    outline: none;
    border-color: #0066cc;
    box-shadow: 0 0 0 3px rgba(0,102,204,0.1);
  }

  /* ── Social inputs ── */
  .social-inputs { display: flex; flex-direction: column; gap: 8px; }

  .social-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #f5f5f7;
    border-radius: 8px;
  }

  .social-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #86868b;
    flex-shrink: 0;
  }

  .social-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #1d1d1f;
    min-width: 0;
  }
  .social-input:focus { outline: none; }
  .social-input::placeholder { color: #c7c7cc; }

  /* ── Preferences ── */
  .pref-list { display: flex; flex-direction: column; gap: 14px; }

  .pref-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }

  .pref-check {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: #0066cc;
    cursor: pointer;
  }

  .pref-body { display: flex; flex-direction: column; gap: 2px; }

  .pref-name {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1d1d1f;
    margin: 0;
  }

  .pref-desc {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 12px;
    color: #86868b;
    margin: 0;
  }

  /* ── Save button ── */
  .save-btn {
    width: 100%;
    padding: 11px;
    background: #0066cc;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 200ms ease, transform 150ms ease;
    margin-top: 4px;
  }
  .save-btn:hover { background: #0071e3; }
  .save-btn:active { transform: scale(0.98); }
  .save-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
</style>