---
import Layout from '@/layouts/Layout.astro';
import SettingsManager from '@/components/islands/settings/SettingsManager';
import { getProfileByUserId, getUserSocialLinks } from '@/lib/profile';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=/dashboard/settings');
}

const profile = await getProfileByUserId(user.id);
const socialLinks = await getUserSocialLinks(user.id);
---

<Layout title="Account Settings - CarcBlog" description="Manage your creator profile, social accounts, notifications, and security.">
  <SettingsManager
    client:load
    profile={profile || {
      id: user.id,
      username: user.username || 'user',
      full_name: user.full_name || 'User',
      avatar_url: user.avatar_url || '',
      cover_url: '',
      bio: '',
      tagline: '',
      website: '',
      country: '',
      city: '',
      timezone: 'UTC',
      preferred_language: 'en',
      company: '',
      job_title: '',
      years_experience: 0,
      industry: '',
      skills: [],
      interests: [],
      expertise: [],
      writing_topics: [],
      notification_prefs: {},
      role: user.role || 'reader',
      verified: false,
      onboarding_completed: true,
      profile_completion_pct: 50,
      created_at: new Date().toISOString()
    }}
    socialLinks={socialLinks}
  />
</Layout>
