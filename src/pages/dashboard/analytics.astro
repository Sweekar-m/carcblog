---
// Dashboard analytics page
import Layout from '@/layouts/Layout.astro';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
---
<Layout title="Analytics - Dashboard" description="View your article statistics and insights">

  <div class="page-content">

    <!-- Page header -->
    <div class="page-header">
      <h1 class="page-title">Analytics</h1>
      <p class="page-sub">Track the performance of your articles and audience engagement.</p>
    </div>

    <!-- Overview metric cards -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Total Views</p>
            <p class="metric-period">Last 30 days</p>
          </div>
          <div class="metric-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>

      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Read Time</p>
            <p class="metric-period">Total minutes</p>
          </div>
          <div class="metric-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>

      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Followers</p>
            <p class="metric-period">Total count</p>
          </div>
          <div class="metric-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>

      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Est. Revenue</p>
            <p class="metric-period">This month</p>
          </div>
          <div class="metric-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>
    </div>

    <!-- Charts section -->
    <div class="chart-section">
      <div class="chart-card">
        <h2 class="chart-title">Views over time</h2>
        <div class="chart-placeholder">
          Analytics data loading…
        </div>
      </div>

      <div class="chart-row">
        <div class="chart-card">
          <h2 class="chart-title">Top articles</h2>
          <div class="chart-placeholder">Loading top articles…</div>
        </div>
        <div class="chart-card">
          <h2 class="chart-title">Audience demographics</h2>
          <div class="chart-placeholder">Loading demographics…</div>
        </div>
      </div>
    </div>

    <!-- Export actions -->
    <div class="export-row">
      <button class="btn-outline">Export CSV</button>
      <button class="btn-primary">Generate Report</button>
    </div>

  </div>

</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ── Header ── */
  .page-header { display: flex; flex-direction: column; gap: 6px; }

  .page-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .page-sub {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #86868b;
    margin: 0;
  }

  /* ── Metrics grid ── */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .metric-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .metric-card:hover {
    border-color: rgba(0,102,204,0.25);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .metric-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 14px;
    gap: 8px;
  }

  .metric-label-group { display: flex; flex-direction: column; gap: 2px; }

  .metric-name {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #1d1d1f;
    margin: 0;
  }

  .metric-period {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 11px;
    color: #86868b;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .metric-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,102,204,0.08);
    border-radius: 8px;
    color: #0066cc;
    flex-shrink: 0;
  }

  .metric-value {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* ── Charts ── */
  .chart-section { display: flex; flex-direction: column; gap: 16px; }

  .chart-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) { .chart-row { grid-template-columns: 1fr; } }

  .chart-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 24px;
  }

  .chart-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .chart-placeholder {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f7;
    border: 1px dashed #e0e0e0;
    border-radius: 8px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13px;
    color: #86868b;
  }

  /* ── Export row ── */
  .export-row {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 9px 20px;
    background: #0066cc;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 200ms ease, transform 150ms ease;
  }
  .btn-primary:hover { background: #0071e3; }
  .btn-primary:active { transform: scale(0.97); }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 9px 20px;
    background: transparent;
    color: #0066cc;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border: 1.5px solid #0066cc;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 200ms ease, transform 150ms ease;
  }
  .btn-outline:hover { background: rgba(0,102,204,0.05); }
  .btn-outline:active { transform: scale(0.97); }
</style>