---
// Dashboard analytics page — ElevenLabs editorial design system
import Layout from '@/layouts/Layout.astro';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
---
<Layout title="Analytics - Dashboard" description="View your article statistics and insights on Carcblog">

  <div class="page-content">

    <!-- Page header -->
    <div class="page-header">
      <h1 class="page-title">Analytics</h1>
      <p class="page-sub">Track the performance of your articles and audience engagement.</p>
    </div>

    <!-- Overview metric cards — white surface-card, hairline, xl radius -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Total Views</p>
            <p class="metric-period">Last 30 days</p>
          </div>
          <div class="metric-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
        </div>
        <!-- EB Garamond 300 display number -->
        <p class="metric-value">--</p>
      </div>

      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Read Time</p>
            <p class="metric-period">Total minutes</p>
          </div>
          <div class="metric-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>

      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Followers</p>
            <p class="metric-period">Total count</p>
          </div>
          <div class="metric-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>

      <div class="metric-card">
        <div class="metric-top">
          <div class="metric-label-group">
            <p class="metric-name">Est. Revenue</p>
            <p class="metric-period">This month</p>
          </div>
          <div class="metric-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <p class="metric-value">--</p>
      </div>
    </div>

    <!-- Charts section -->
    <div class="chart-section">
      <div class="chart-card">
        <h2 class="chart-title">Views over time</h2>
        <div class="chart-placeholder">
          Analytics data loading…
        </div>
      </div>

      <div class="chart-row">
        <div class="chart-card">
          <h2 class="chart-title">Top articles</h2>
          <div class="chart-placeholder">Loading top articles…</div>
        </div>
        <div class="chart-card">
          <h2 class="chart-title">Audience demographics</h2>
          <div class="chart-placeholder">Loading demographics…</div>
        </div>
      </div>
    </div>

    <!-- Export actions — ink pill and outline buttons -->
    <div class="export-row">
      <button class="btn-outline" id="btn-export-csv">Export CSV</button>
      <button class="btn-primary" id="btn-generate-report">Generate Report</button>
    </div>

  </div>

</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);                   /* 32px */
  }

  /* ── Header ── */
  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hairline);
  }

  /* heading-md: DM Sans 600, 32px */
  .page-title {
    font-family: var(--font-sans);
    font-size: var(--fs-heading-md);
    font-weight: var(--fw-semibold);
    color: var(--color-ink-strong);
    margin: 0;
    line-height: var(--lh-heading-md);
    letter-spacing: -0.01em;
  }

  .page-sub {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-steel);
    margin: 0;
    line-height: var(--lh-body-sm);
  }

  /* ── Metrics grid ── */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md);
  }

  /* feature-card style */
  .metric-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    transition: box-shadow var(--duration-200) var(--ease-out);
  }
  .metric-card:hover {
    box-shadow: var(--shadow-card);
  }

  .metric-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    gap: var(--space-xs);
  }

  .metric-label-group { display: flex; flex-direction: column; gap: 2px; }

  /* title-sm: Inter 500 */
  .metric-name {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    color: var(--color-body-strong);
    margin: 0;
  }

  /* caption-uppercase */
  .metric-period {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-steel);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* voice-icon-circular: surface-strong bg */
  .metric-icon {
    width: 32px; height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  /* display-lg: DM Sans 600 for numbers */
  .metric-value {
    font-family: var(--font-sans);
    font-size: var(--fs-display-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-ink-strong);
    margin: 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* ── Charts ── */
  .chart-section { display: flex; flex-direction: column; gap: var(--space-md); }

  .chart-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }
  @media (max-width: 768px) { .chart-row { grid-template-columns: 1fr; } }

  .chart-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
  }

  /* title-sm */
  .chart-title {
    font-family: var(--font-sans);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
  }

  .chart-placeholder {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-canvas-soft);
    border: 1px dashed var(--color-hairline-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    color: var(--color-muted);
  }

  /* ── Export row ── */
  .export-row {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-sm);
  }
</style>