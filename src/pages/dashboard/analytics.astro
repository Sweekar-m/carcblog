---
import Layout from '@/layouts/Layout.astro';
import AnalyticsDashboardView from '@/components/islands/analytics/AnalyticsDashboardView';
import { getWriterAnalytics } from '@/lib/analytics';
import { getSanityArticlesByAuthor } from '@/lib/sanity';
import { getCurrentUser } from '@/lib/auth';
import { isWriter } from '@/types/roles';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=/dashboard/analytics');
}

if (!isWriter(user.role)) {
  return Astro.redirect('/dashboard/profile');
}

let userArticles = [];
try {
  userArticles = await getSanityArticlesByAuthor(user.id, 100);
} catch (e) {
  console.error('Failed to fetch author articles for analytics:', e);
}

const articleIds = userArticles.map(a => a._id);
const analytics = await getWriterAnalytics(articleIds);
---

<Layout title="Writer Analytics Dashboard - CarcBlog" description="Track engagement, readership growth, traffic origins, and read depth.">
  <AnalyticsDashboardView client:load analytics={analytics} />
</Layout>