---
import Layout from '@/layouts/Layout.astro';
import DashboardPage from '@/components/dashboard/DashboardPage.astro';
import { getCurrentUser } from '@/lib/auth';
import { getUserFollowedWriters } from '@/lib/social';
import FollowButton from '@/components/islands/social/FollowButton';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

const followedProfiles = await getUserFollowedWriters(user.id);
---

<Layout title="Following - Dashboard" description="Writers and accounts you follow on Carcblog" hideSidebar={false}>
  <DashboardPage title={`Following (${followedProfiles.length})`} subtitle="Accounts whose stories and updates you follow.">
    {followedProfiles.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {followedProfiles.map((profile) => (
          <div class="flex items-start gap-3 bg-canvas border border-hairline rounded-xl p-4 sm:p-5 transition-colors hover:bg-surface">
            <!-- Avatar -->
            <div class="w-11 h-11 rounded-full bg-surface-strong border border-hairline flex items-center justify-center overflow-hidden shrink-0 font-bold text-ink text-sm font-sans">
              {profile.avatar_url ? (
                <img src={profile.avatar_url} alt={profile.full_name || profile.username} class="w-full h-full object-cover" />
              ) : (
                <span>{(profile.full_name || profile.username).charAt(0).toUpperCase()}</span>
              )}
            </div>
            <!-- Profile Info -->
            <div class="flex-1 min-w-0">
              <p class="font-sans text-sm font-semibold text-ink truncate">{profile.full_name || profile.username}</p>
              <p class="font-sans text-xs text-steel mt-0.5 truncate">@{profile.username} · {profile.role}</p>
              {profile.bio && (
                <p class="font-sans text-xs text-body mt-1.5 line-clamp-2 leading-relaxed">{profile.bio}</p>
              )}
            </div>
            <!-- Follow Button -->
            <div class="shrink-0 mt-0.5">
              <FollowButton client:visible targetId={profile.id} initialFollowing={true} />
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center text-center px-6 py-16 sm:py-24 bg-surface border border-dashed border-hairline-strong rounded-xl">
        <p class="font-sans text-base sm:text-lg font-semibold text-ink mb-2">You're not following anyone yet</p>
        <p class="font-sans text-sm text-steel max-w-sm mb-5">
          Discover writers across the startup ecosystem and follow them to build your network.
        </p>
        <a href="/writers" class="btn-primary inline-flex">Discover Writers</a>
      </div>
    )}
  </DashboardPage>
</Layout>
