---
import Layout from '@/layouts/Layout.astro';
import { getCurrentUser } from '@/lib/auth';
import { getUserFollowedWriters } from '@/lib/social';
import FollowButton from '@/components/islands/social/FollowButton';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=' + encodeURIComponent(Astro.url.pathname));
}

const followedProfiles = await getUserFollowedWriters(user.id);
---

<Layout title="Following - Dashboard" description="Writers and accounts you follow on Carcblog">
  <div class="dashboard-page">
    <div class="page-header">
      <h1 class="page-title">Following ({followedProfiles.length})</h1>
      <p class="page-sub">Accounts whose stories and updates you follow.</p>
    </div>

    {followedProfiles.length > 0 ? (
      <div class="profiles-grid">
        {followedProfiles.map((profile) => (
          <div class="profile-card">
            <div class="profile-avatar">
              {profile.avatar_url ? (
                <img src={profile.avatar_url} alt={profile.full_name || profile.username} />
              ) : (
                <span>{(profile.full_name || profile.username).charAt(0).toUpperCase()}</span>
              )}
            </div>
            <div class="profile-info">
              <h3 class="profile-name">{profile.full_name || profile.username}</h3>
              <p class="profile-role">@{profile.username} · {profile.role}</p>
              {profile.bio && <p class="profile-bio">{profile.bio}</p>}
            </div>
            <div class="profile-action">
              <FollowButton client:load targetId={profile.id} initialFollowing={true} />
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-box">
        <p class="empty-title">You're not following anyone yet</p>
        <p class="empty-sub">Discover writers across the startup ecosystem and follow them to build your network.</p>
        <a href="/writers" class="btn-primary" style="margin-top: 12px; display: inline-flex;">Discover Writers</a>
      </div>
    )}
  </div>
</Layout>

<style>
  .dashboard-page { display: flex; flex-direction: column; gap: var(--space-xl); }
  .page-header { border-bottom: 1px solid var(--color-hairline); padding-bottom: var(--space-md); }
  .page-title { font-family: var(--font-sans); font-size: var(--fs-heading-md); font-weight: var(--fw-semibold); color: var(--color-ink-strong); margin: 0 0 4px 0; }
  .page-sub { font-family: var(--font-sans); font-size: var(--fs-body-sm); color: var(--color-steel); margin: 0; }
  .profiles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-md); }
  .profile-card { background: var(--color-surface-card); border: 1px solid var(--color-hairline); border-radius: var(--radius-xl); padding: var(--space-lg); display: flex; align-items: flex-start; gap: 14px; }
  .profile-avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--color-surface-strong); border: 1px solid var(--color-hairline); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; font-family: var(--font-sans); font-weight: 700; color: var(--color-ink); }
  .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-info { flex: 1; min-width: 0; }
  .profile-name { font-family: var(--font-sans); font-size: var(--fs-body-sm); font-weight: var(--fw-semibold); color: var(--color-ink-strong); margin: 0 0 2px 0; }
  .profile-role { font-family: var(--font-sans); font-size: 11px; color: var(--color-steel); margin: 0 0 6px 0; }
  .profile-bio { font-family: var(--font-sans); font-size: 12px; color: var(--color-body); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .profile-action { flex-shrink: 0; }
  .empty-box { background: var(--color-surface); border: 1px dashed var(--color-hairline-strong); border-radius: var(--radius-xl); padding: var(--space-xxl); text-align: center; }
  .empty-title { font-family: var(--font-sans); font-size: var(--fs-card-title); font-weight: var(--fw-semibold); color: var(--color-ink); margin: 0 0 8px 0; }
  .empty-sub { font-family: var(--font-sans); font-size: var(--fs-body-sm); color: var(--color-steel); margin: 0; }
</style>
