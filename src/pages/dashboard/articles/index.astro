---
import Layout from '@/layouts/Layout.astro';
import ArticleCMSManager from '@/components/islands/dashboard/ArticleCMSManager';
import { getSanityArticlesByAuthor } from '@/lib/sanity';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=/dashboard/articles');
}

if (user.role !== 'writer' && user.role !== 'admin') {
  return Astro.redirect('/dashboard/bookmarks');
}

let articles = [];
try {
  articles = await getSanityArticlesByAuthor(user.id, 100);
} catch (e) {
  console.error('Failed to fetch articles for CMS manager:', e);
}
---

<Layout title="Article Management CMS - CarcBlog" description="Manage, draft, publish, and analyze your publications.">
  <ArticleCMSManager client:load articles={articles} />
</Layout>
