---
// Dashboard articles listing — ElevenLabs editorial design system
import Layout from '@/layouts/Layout.astro';
import { getSanityArticlesByAuthor, urlFor } from '@/lib/sanity';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
const rawArticles = user ? await getSanityArticlesByAuthor(user.id) : [];
const articles = rawArticles.map(article => ({
  _id: article._id,
  title: article.title,
  slug: article.slug,
  excerpt: article.excerpt ?? '(no excerpt)',
  publishedAt: article.publishedAt,
  coverImage: article.coverImage ? urlFor(article.coverImage).url() : undefined,
  author: {
    name: article.author?.name ?? 'Unknown',
    image: article.author?.image,
  }
}));
const publishedArticles = articles.filter(a => a.publishedAt !== null);
const draftArticles = articles.filter(a => a.publishedAt === null);
---
<Layout title="My Articles - Dashboard" description="Manage your published articles and drafts on Carcblog">
  <div class="page-content">

    <!-- Page header -->
    <div class="page-header">
      <div class="header-text">
        <h1 class="page-title">My Articles</h1>
        <p class="page-sub">Manage your published articles and drafts.</p>
      </div>
      <a href="/dashboard/articles/new" class="btn-primary" id="dash-new-article-btn">New Article</a>
    </div>

    <!-- Published articles -->
    <section class="dashboard-section">
      <h2 class="section-title">Published</h2>

      {publishedArticles.length > 0 ? (
        <div class="article-list">
          {publishedArticles.map((article) => (
            <article class="article-row-card">
              <div class="article-thumb-wrap">
                {article.coverImage ? (
                  <img src={article.coverImage} alt={article.title} class="article-thumb-img" />
                ) : (
                  <div class="article-thumb-placeholder" aria-hidden="true">
                    <span>{article.title.charAt(0).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="article-body">
                <h3 class="article-heading">{article.title}</h3>
                <p class="article-excerpt">{article.excerpt || 'No preview available'}</p>
                <div class="article-meta">
                  {article.publishedAt && (
                    <time datetime={article.publishedAt}>
                      {new Date(article.publishedAt).toLocaleDateString(undefined, {
                        month: 'short', day: 'numeric', year: 'numeric'
                      })}
                    </time>
                  )}
                  <span class="meta-dot" aria-hidden="true">·</span>
                  <span>{article.author?.name || 'Anonymous'}</span>
                </div>
              </div>
              <a href={`/article/${article.slug}`} class="btn-outline btn-small" id={`view-article-${article.slug}`}>View</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <p>No published articles yet. <a href="/dashboard/articles/new" class="link-editorial">Create your first article</a> to get started!</p>
        </div>
      )}
    </section>

    <!-- Drafts -->
    <section class="dashboard-section">
      <h2 class="section-title">Drafts</h2>

      {draftArticles.length > 0 ? (
        <div class="article-list">
          {draftArticles.map((article) => (
            <article class="article-row-card">
              <div class="article-thumb-wrap">
                {article.coverImage ? (
                  <img src={article.coverImage} alt={article.title} class="article-thumb-img" />
                ) : (
                  <div class="article-thumb-placeholder" aria-hidden="true">
                    <span>{article.title.charAt(0).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="article-body">
                <h3 class="article-heading">{article.title}</h3>
                <p class="article-excerpt">{article.excerpt || 'No preview available'}</p>
                <div class="article-meta">
                  <span class="badge-pill">Draft</span>
                  <span class="meta-dot" aria-hidden="true">·</span>
                  <span>{article.author?.name || 'Anonymous'}</span>
                </div>
              </div>
              <a href={`/article/${article.slug}`} class="btn-outline btn-small" id={`preview-draft-${article.slug}`}>Preview</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <p>No drafts yet. Ideas waiting to be written?</p>
        </div>
      )}
    </section>

  </div>
</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);                   /* 32px */
  }

  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hairline);
  }
  .header-text { flex: 1; }

  /* display-md: EB Garamond 300, 32px */
  .page-title {
    font-family: var(--font-serif);
    font-size: var(--fs-display-md);
    font-weight: var(--fw-light);           /* 300 */
    color: var(--color-ink);
    margin: 0 0 var(--space-xxs);
    line-height: var(--lh-display-md);
    letter-spacing: var(--ls-display-md);
  }

  .page-sub {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-muted);
    margin: 0;
  }

  /* ── Section ── */
  .dashboard-section { display: flex; flex-direction: column; gap: var(--space-sm); }

  /* title-sm: Inter 500, 18px */
  .section-title {
    font-family: var(--font-sans);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    margin: 0;
  }

  /* ── Article list ── */
  .article-list { display: flex; flex-direction: column; gap: var(--space-xs); }

  /* Row card: white, hairline, xl radius */
  .article-row-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    transition: box-shadow var(--duration-200) var(--ease-out), border-color var(--duration-200) var(--ease-out);
  }
  .article-row-card:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .article-thumb-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--color-hairline);
  }

  .article-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-surface-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-medium);
    font-size: 18px;
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  .article-body {
    flex: 1;
    min-width: 0;
  }

  /* title-sm range */
  .article-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-excerpt {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    color: var(--color-body);
    margin: 0 0 var(--space-xxs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 480px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-muted);
  }

  .meta-dot { color: var(--color-hairline-strong); }

  /* Compact button styling override */
  .btn-small {
    padding: 6px 16px;
    height: auto;
    font-size: var(--fs-caption);
  }

  /* ── Empty state ── */
  .empty-state {
    padding: var(--space-xl) var(--space-lg);
    background: var(--color-surface-card);
    border: 1px dashed var(--color-hairline-strong);
    border-radius: var(--radius-xl);
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-muted);
  }
  .empty-state p { margin: 0; }

  .link-editorial {
    color: var(--color-ink);
    text-decoration: underline;
    font-weight: var(--fw-medium);
  }
  .link-editorial:hover {
    color: var(--color-primary-active);
  }
</style>
