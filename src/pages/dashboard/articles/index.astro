---
// Dashboard articles listing
import Layout from '@/layouts/Layout.astro';
import { getArticlesByAuthorWithFallback } from '@/lib/supabase';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
const rawArticles = user ? await getArticlesByAuthorWithFallback(user.id) : [];
const articles = rawArticles.map(article => ({
  ...article,
  _id: article.id,
  coverImage: article.cover_image_url,
  excerpt: article.excerpt ?? article.content?.substring(0, 150) + '...',
  publishedAt: article.published_at,
  author: {
    name: article.author?.full_name ?? article.author?.username ?? 'Unknown',
    image: article.author?.avatar_url
  }
}));
---


<Layout title="My Articles - Dashboard" description="Manage your published articles and drafts">

  <div class="page-content">

    <!-- Page header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">My Articles</h1>
        <p class="page-sub">Manage your published articles and drafts.</p>
      </div>
      <a href="/dashboard/articles/new" class="btn-primary">New Article</a>
    </div>

    <!-- Published articles -->
    <section class="section">
      <h2 class="section-title">Published</h2>

      {articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article) => (
            <article class="article-card">
              <div class="article-thumb-wrap">
                {article.coverImage ? (
                  <img src={article.coverImage} alt={article.title} class="article-thumb-img" />
                ) : (
                  <div class="article-thumb-placeholder">
                    <span>{article.title.charAt(0).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="article-body">
                <h3 class="article-title">{article.title}</h3>
                <p class="article-excerpt">{article.excerpt || 'No preview available'}</p>
                <div class="article-meta">
                  <time datetime={article.publishedAt}>
                    {new Date(article.publishedAt).toLocaleDateString(undefined, {
                      month: 'short', day: 'numeric', year: 'numeric'
                    })}
                  </time>
                  <span class="meta-dot">·</span>
                  <span>{article.author?.name || 'Anonymous'}</span>
                </div>
              </div>
              <a href={`/dashboard/articles/${article._id}`} class="article-edit-btn">Edit</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No published articles yet. <a href="/dashboard/articles/new" class="link">Create your first article</a> to get started!</p>
        </div>
      )}
    </section>

    <!-- Drafts -->
    <section class="section">
      <h2 class="section-title">Drafts</h2>
      <div class="empty-state">
        <p>No drafts yet. Ideas waiting to be written?</p>
      </div>
    </section>

  </div>

</Layout>

<style>
  .page-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .page-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }

  .page-sub {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #86868b;
    margin: 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 20px;
    background: #0066cc;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 200ms ease, transform 150ms ease;
    flex-shrink: 0;
  }
  .btn-primary:hover { background: #0071e3; }
  .btn-primary:active { transform: scale(0.97); }

  /* ── Section ── */
  .section { display: flex; flex-direction: column; gap: 12px; }

  .section-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* ── Article list ── */
  .article-list { display: flex; flex-direction: column; gap: 10px; }

  .article-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .article-card:hover {
    border-color: rgba(0,102,204,0.25);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .article-thumb-wrap {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid #e0e0e0;
  }

  .article-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0,102,204,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    color: #0066cc;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
  }

  .article-body {
    flex: 1;
    min-width: 0;
  }

  .article-title {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #1d1d1f;
    margin: 0 0 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-excerpt {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13px;
    color: #86868b;
    margin: 0 0 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 480px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 12px;
    color: #86868b;
  }

  .meta-dot { color: #c7c7cc; }

  .article-edit-btn {
    flex-shrink: 0;
    padding: 6px 16px;
    border: 1px solid #e0e0e0;
    border-radius: 9999px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #1d1d1f;
    text-decoration: none;
    background: #ffffff;
    transition: background 150ms ease, border-color 150ms ease;
  }
  .article-edit-btn:hover {
    background: #f5f5f7;
    border-color: #c7c7cc;
  }

  /* ── Empty state ── */
  .empty-state {
    padding: 40px 24px;
    background: #ffffff;
    border: 1px dashed #e0e0e0;
    border-radius: 12px;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 14px;
    color: #86868b;
  }
  .empty-state p { margin: 0; }

  .link { color: #0066cc; text-decoration: none; font-weight: 500; }
  .link:hover { color: #0071e3; text-decoration: underline; }
</style>

