---
/**
 * /dashboard/articles/new — Publishing Studio entry point.
 * Uses EditorLayout (no nav/footer) and mounts ArticleEditorShell as client:only="react".
 * Auth is enforced by middleware.ts — this page is writer-only.
 */
import EditorLayout from '@/layouts/EditorLayout.astro';
import { ArticleEditorShell } from '@/components/islands/ArticleEditorShell';
import { EditorLoadingSkeleton } from '@/components/islands/editor/LoadingSkeleton';

export const prerender = false;

let clerkUserId = '';
if (typeof Astro.locals?.auth === 'function') {
  const auth = await Astro.locals.auth();
  clerkUserId = auth?.userId || '';
}

if (!clerkUserId) {
  return Astro.redirect('/auth/sign-in');
}
---


<EditorLayout title="New Article">
  <!--
    SSR placeholder: shown between Astro serving the HTML and React hydrating.
    EditorLoadingSkeleton is a pure JSX component rendered server-side to prevent blank flash.
  -->
  <div id="editor-ssr-skeleton" aria-hidden="true">
    <EditorLoadingSkeleton />
  </div>

  <!--
    React island: client:only="react" — nothing is server-rendered for the shell.
    The skeleton above fills the gap. Once React mounts, it takes over the viewport.
  -->
  <ArticleEditorShell client:only="react" clerkUserId={clerkUserId} />


  <script is:inline>
    // Hide the SSR skeleton as soon as the React shell mounts
    document.addEventListener('DOMContentLoaded', () => {
      // ArticleEditorShell mounts into a sibling div — hide skeleton once React runs
      const observer = new MutationObserver(() => {
        const shell = document.getElementById('publishing-studio');
        const skeleton = document.getElementById('editor-ssr-skeleton');
        if (shell && skeleton) {
          skeleton.style.display = 'none';
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });
  </script>
</EditorLayout>
