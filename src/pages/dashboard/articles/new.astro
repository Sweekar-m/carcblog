---
// New article form
import Layout from '@/layouts/Layout.astro';
import { sanityClient } from '@/lib/sanity';

export const prerender = false;

// Handle form submission
export async function POST({ request, locals }) {
  try {
    const { userId, sessionId, getToken } = await locals.auth();

    if (!userId) {
      return new Response(JSON.stringify({ error: 'Unauthorized' }), {
        status: 401,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    const formData = await request.formData();
    const data = Object.fromEntries(formData);

    // Validate required fields
    if (!data.title || !data.content) {
      return new Response(JSON.stringify({ error: 'Title and content are required' }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    // Prepare article data for Sanity
    const articleData = {
      title: data.title,
      slug: {
        current: data.title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)+/g, '')
          .substring(0, 60) // Limit slug length
      },
      publishedAt: data['publish-immediately'] ? new Date().toISOString() : null,
      excerpt: data.subtitle || data.content.substring(0, 150) + '...',
      body: [
        {
          _type: 'block',
          style: 'normal',
          children: [
            {
              _type: 'span',
              text: data.content,
              marks: []
            }
          ]
        }
      ],
      author: {
        _type: 'reference',
        _ref: userId // Assuming user ID in Clerk matches author ID in Sanity
      }
    };

    // Add cover image if provided
    if (data.coverImageUrl) {
      articleData.coverImage = {
        _type: 'image',
        asset: {
          _type: 'reference',
          _ref: await uploadImageToSanity(data.coverImageUrl)
        }
      };
    }

    // Add topics if provided
    if (data.topics) {
      const topics = data.topics.split(',').map(t => t.trim()).filter(t => t.length > 0);
      // Note: In a real implementation, you'd need to handle topics properly
      // This would require a topic schema in Sanity and proper references
    }

    // Create article in Sanity
    const result = await sanityClient.create({
      _type: 'article',
      ...articleData
    });

    // Redirect to the article page
    return new Response(JSON.stringify({
      success: true,
      articleId: result._id,
      slug: result.slug.current
    }), {
      status: 201,
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (error) {
    console.error('Error creating article:', error);
    return new Response(JSON.stringify({ error: 'Failed to create article' }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

// Helper function to upload image to Sanity (simplified - in reality you'd upload the file)
async function uploadImageToSanity(url) {
  // This is a simplified version - in production you'd:
  // 1. Fetch the image from the URL
  // 2. Upload it to Sanity assets
  // 3. Return the asset ID
  // For now, we'll return a placeholder or skip image upload
  return null;
}

---
<Layout title="New Article - Dashboard" description="Create a new article">
  <header class="mb-8">
    <h1 class="text-2xl font-bold">New Article</h1>
    <p class="text-muted-foreground">
      Share your thoughts and ideas with the world.
    </p>
  </header>

  <form id="articleForm" class="space-y-6" method="POST">
    <div>
      <label class="block text-sm font-medium text-foreground mb-2">Title</label>
      <input type="text" name="title" required
             class="w-full px-4 py-2 border border-muted/50 rounded-md bg-background text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-0"
             placeholder="Enter article title" />
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-2">Subtitle (optional)</label>
      <input type="text" name="subtitle"
             class="w-full px-4 py-2 border border-muted/50 rounded-md bg-background text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-0"
             placeholder="Enter subtitle" />
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-2">Cover Image URL (optional)</label>
      <input type="url" name="coverImageUrl"
             class="w-full px-4 py-2 border border-muted/50 rounded-md bg-background text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-0"
             placeholder="https://example.com/image.jpg" />
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-2">Topics (comma-separated)</label>
      <input type="text" name="topics"
             class="w-full px-4 py-2 border border-muted/50 rounded-md bg-background text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-0"
             placeholder="technology, science, ai" />
    </div>

    <div class="border-t border-muted/50 pt-4">
      <label class="block text-sm font-medium text-foreground mb-2">Content</label>
      <div class="relative">
        <textarea id="content" name="content" rows="20"
                  class="w-full px-4 py-2 border border-muted/50 rounded-md bg-background text-sm resize-none focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-0"
                  placeholder="Write your article here..." required></textarea>
        <div class="absolute bottom-2 right-2 text-xs text-muted-foreground">
          <span id="word-count">0</span> words
        </div>
      </div>
    </div>

    <div class="flex items-center space-x-4">
      <label class="flex items-center space-x-2 text-sm font-medium text-foreground cursor-pointer">
        <input type="checkbox" name="publish-immediately" id="publish-immediate" checked class="rounded border-muted/50 text-primary bg-background focus:ring-primary h-4 w-4" />
        <span>Publish immediately</span>
      </label>
    </div>

    <div class="mt-6">
      <button type="submit"
              id="submitButton"
              class="w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary hover:bg-primary-focus focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-50 transition-colors duration-200">
        Publish article
      </button>
    </div>
  </form>

  <div id="formResponse" class="mt-4 hidden"></div>
</Layout>

<script>
  // Handle form submission via AJAX
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('articleForm');
    const submitButton = document.getElementById('submitButton');
    const responseDiv = document.getElementById('formResponse');
    const wordCount = document.getElementById('word-count');
    const textarea = document.getElementById('content');

    // Word counter
    if (textarea && wordCount) {
      const updateWordCount = () => {
        const text = textarea.value.trim();
        const count = text === '' ? 0 : text.split(/\s+/).length;
        wordCount.textContent = count;
      };

      textarea.addEventListener('input', updateWordCount);
      updateWordCount(); // Initial count
    }

    // Form submission
    if (form && submitButton && responseDiv) {
      form.addEventListener('asyncsubmit', async (e) => {
        e.preventDefault();

        // Disable button and show loading state
        submitButton.disabled = true;
        submitButton.innerHTML = '<span class="mr-2">&#9654;</span> Publishing...';
        responseDiv.classList.add('hidden');
        responseDiv.classList.remove('text-green-600', 'text-red-600');
        responseDiv.textContent = '';

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (response.ok && result.success) {
            responseDiv.classList.remove('hidden');
            responseDiv.classList.add('text-green-600');
            responseDiv.textContent = 'Article published successfully!';

            // Redirect to the article page after a short delay
            setTimeout(() => {
              window.location.href = `/article/${result.slug}`;
            }, 1500);
          } else {
            responseDiv.classList.remove('hidden');
            responseDiv.classList.add('text-red-600');
            responseDiv.textContent = result.error || 'Failed to publish article';
          }
        } catch (error) {
          responseDiv.classList.remove('hidden');
          responseDiv.classList.add('text-red-600');
          responseDiv.textContent = 'An error occurred while publishing the article.';
          console.error('Error:', error);
        } finally {
          // Re-enable button
          submitButton.disabled = false;
          submitButton.textContent = 'Publish article';
        }
      });
    }
  });
</script>

<style>
  /* Form styles */
  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    font-size: 0.875rem;
    color: hsl(var(--foreground));
  }

  input, textarea {
    width: 100%;
    padding: 0.5rem 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.375rem;
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 0.875rem;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 2px hsl(var(--primary) / 0.2);
  }

  button {
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    color: hsl(var(--primary-foreground));
    background-color: hsl(var(--primary));
    cursor: pointer;
    transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  button:hover:not(:disabled) {
    background-color: hsl(var(--primary) / 0.9);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Response message styles */
  #formResponse {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  /* Hide response by default */
  #formResponse[hidden] {
    opacity: 0;
    pointer-events: none;
  }
</style>