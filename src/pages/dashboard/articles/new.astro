---
/**
 * /dashboard/articles/new — Publishing Studio entry point.
 * Supports creating a new article or editing an existing article via ?id=...
 * Uses EditorLayout (no nav/footer) and mounts ArticleEditorShell as client:only="react".
 * Auth is enforced by middleware.ts — this page is writer-only.
 */
import EditorLayout from '@/layouts/EditorLayout.astro';
import { ArticleEditorShell } from '@/components/islands/ArticleEditorShell';
import { EditorLoadingSkeleton } from '@/components/islands/editor/LoadingSkeleton';
import { getSanityArticleById } from '@/lib/sanity';

export const prerender = false;

let clerkUserId = Astro.locals?.user?.userId || '';
if (!clerkUserId && typeof Astro.locals?.auth === 'function') {
  const auth = await Astro.locals.auth();
  clerkUserId = auth?.userId || '';
}

if (!clerkUserId && import.meta.env.DEV && Astro.url.searchParams.get('dev_test') === 'true') {
  clerkUserId = 'test_writer_1';
}

if (!clerkUserId) {
  return Astro.redirect('/auth/sign-in');
}

const id = Astro.url.searchParams.get('id') || Astro.url.searchParams.get('articleId');
let initialArticle = null;
if (id) {
  try {
    initialArticle = await getSanityArticleById(id);
  } catch (err) {
    console.error('Failed to load article for editing:', err);
  }
}
---

<EditorLayout title={initialArticle ? `Edit "${initialArticle.title}"` : "New Article"}>
  <div id="editor-ssr-skeleton" aria-hidden="true">
    <EditorLoadingSkeleton />
  </div>

  <ArticleEditorShell client:only="react" clerkUserId={clerkUserId} initialArticle={initialArticle} />

  <script is:inline>
    // Hide the SSR skeleton as soon as the React shell mounts
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new MutationObserver(() => {
        const shell = document.getElementById('publishing-studio');
        const skeleton = document.getElementById('editor-ssr-skeleton');
        if (shell && skeleton) {
          skeleton.style.display = 'none';
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });
  </script>
</EditorLayout>
