---
// Writers page — ElevenLabs editorial design system
import Layout from '@/components/layout/Layout.astro';
import { supabase } from '@/lib/supabase';
import FollowButton from '@/components/islands/social/FollowButton';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const currentUser = await getCurrentUser(Astro.locals);

const { data: dbWriters } = await supabase
  .from('profiles')
  .select('id, username, full_name, avatar_url, bio, role')
  .limit(12);

const defaultWriters = [
  { id: 'w1', username: 'janedoe', full_name: 'Jane Doe', bio: 'Exploring technology and human experience.', role: 'writer' },
  { id: 'w2', username: 'michaelsmith', full_name: 'Michael Smith', bio: 'Examining culture trends and contemporary art.', role: 'writer' },
  { id: 'w3', username: 'alexkumar', full_name: 'Alex Kumar', bio: 'Science journalism and space discoveries.', role: 'writer' },
  { id: 'w4', username: 'ninagupta', full_name: 'Nina Gupta', bio: 'Bridging climate science and environmental policy.', role: 'writer' },
  { id: 'w5', username: 'diegocastillo', full_name: 'Diego Castillo', bio: 'Exploring digital spaces and cultural identity.', role: 'writer' },
  { id: 'w6', username: 'taylorsmith', full_name: 'Taylor Smith', bio: 'Decoding algorithms, machine learning, and AI.', role: 'writer' },
];

const writersList = (dbWriters && dbWriters.length > 0) ? dbWriters : defaultWriters;
---
<Layout title="Writers — Carcblog" description="Discover talented writers crafting ideas on Carcblog">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO
  ═══════════════════════════════════════════════ -->
  <section class="writers-hero">
    <div class="atm-orb writers-orb-peach" aria-hidden="true"></div>
    <div class="atm-orb writers-orb-lavender" aria-hidden="true"></div>

    <div class="page-container writers-hero-inner">
      <div class="hero-eyebrow">
        <span class="badge-pill">Our Writers</span>
      </div>
      <h1 class="hero-title">Words worth reading.</h1>
      <p class="hero-sub">
        Meet the authors who make Carcblog worth visiting every day — from deep dives to sharp perspectives.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: FEATURED WRITERS GRID
  ═══════════════════════════════════════════════ -->
  <section class="writers-section writers-section--soft">
    <div class="page-container">
      <div class="sec-header">
        <h2 class="sec-title">Featured Writers</h2>
        <p class="sec-sub">Meet authors crafting detailed content on Carcblog.</p>
      </div>

      <div class="writers-grid">
        {writersList.map((writer) => {
          const name = writer.full_name || writer.username;
          const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
          return (
            <div class="writer-card feature-card">
              <div class="writer-card-top">
                <div class="writer-avatar" aria-hidden="true">
                  {writer.avatar_url ? (
                    <img src={writer.avatar_url} alt={name} style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                  ) : (
                    <span>{initials}</span>
                  )}
                </div>
                <div class="writer-stats">
                  <span class="badge-pill">@{writer.username}</span>
                </div>
              </div>
              <div class="writer-info">
                <h3 class="writer-name">{name}</h3>
                <p class="writer-spec">{writer.role ? writer.role.toUpperCase() : 'CONTRIBUTOR'}</p>
                <p class="writer-bio">{writer.bio || 'Writer on Carcblog.'}</p>
              </div>
              <div class="writer-footer" style="display: flex; justify-content: flex-end; margin-top: 12px;">
                {currentUser?.id !== writer.id && (
                  <FollowButton client:load targetId={writer.id} />
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3: BROWSE BY EXPERTISE
       badge-pill cloud + leaderboard panels
  ═══════════════════════════════════════════════ -->
  <section class="writers-section">
    <div class="page-container">
      <div class="sec-header">
        <h2 class="sec-title">Browse by Expertise</h2>
        <p class="sec-sub">Explore leaders in specific fields and disciplines.</p>
      </div>

      <div class="expertise-pills">
        {['Technology', 'Science', 'Culture', 'Politics', 'Business', 'Health', 'Personal Growth', 'Design'].map(field => (
          <a href={`/discover#${field.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="badge-pill expertise-cloud-pill">
            {field}
          </a>
        ))}
      </div>

      <!-- Leaderboards -->
      <div class="leaderboard-grid">
        <!-- Tech leaders -->
        <div class="leaderboard-panel feature-card">
          <h3 class="panel-title">Top technology writers</h3>
          <div class="panel-rows">
            {[
              { rank: '01', initials: 'TS', name: 'Taylor Smith',     beat: 'AI & Machine Learning', stat: '18.5K views' },
              { rank: '02', initials: 'LR', name: 'Linda Rodriguez', beat: 'Software Engineering',   stat: '14.2K views' },
              { rank: '03', initials: 'JD', name: 'Jane Doe',        beat: 'Interface & AI',         stat: '12.4K views' }
            ].map(({ rank, initials, name, beat, stat }) => (
              <div class="panel-row">
                <span class="pr-rank" aria-hidden="true">{rank}</span>
                <div class="pr-avatar" aria-hidden="true">{initials}</div>
                <div class="pr-info">
                  <p class="pr-name">{name}</p>
                  <p class="pr-meta">{beat}</p>
                </div>
                <span class="pr-stat">{stat}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Emerging voices -->
        <div class="leaderboard-panel feature-card">
          <h3 class="panel-title">Emerging voices</h3>
          <div class="panel-rows">
            {[
              { rank: '01', initials: 'NG', name: 'Nina Gupta',     beat: 'Environmental Science', badgeText: 'New', status: 'new' },
              { rank: '02', initials: 'DC', name: 'Diego Castillo',  beat: 'Digital Culture',        badgeText: 'Rising', status: 'rising' },
              { rank: '03', initials: 'PW', name: 'Priya Williams',  beat: 'Health & Wellness',     badgeText: 'New', status: 'new' }
            ].map(({ rank, initials, name, beat, badgeText, status }) => (
              <div class="panel-row">
                <span class="pr-rank" aria-hidden="true">{rank}</span>
                <div class="pr-avatar" aria-hidden="true">{initials}</div>
                <div class="pr-info">
                  <p class="pr-name">{name}</p>
                  <p class="pr-meta">{beat}</p>
                </div>
                <span class={`badge-pill pr-badge pr-badge--${status}`}>{badgeText}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: CTA BAND
       cta-band spec: canvas bg, display-lg, ink pill
  ═══════════════════════════════════════════════ -->
  <section class="writers-cta-band">
    <!-- Atmospheric orbs -->
    <div class="atm-orb writers-cta-orb-mint" aria-hidden="true"></div>
    <div class="atm-orb writers-cta-orb-sky"  aria-hidden="true"></div>

    <div class="page-container writers-cta-inner">
      <span class="badge-pill cta-eyebrow">Join the community</span>
      <h2 class="cta-headline">Ready to share your expertise?</h2>
      <p class="cta-body">
        Join our growing community of writers and connect with readers who value your insights and perspective.
      </p>
      <div class="cta-buttons">
        <a href="/auth/sign-up" class="btn-primary" id="writers-cta-signup">Join as a Writer</a>
        <a href="/about" class="btn-outline" id="writers-cta-learn">Learn more</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════════════════════
   WRITERS PAGE — ElevenLabs editorial system
════════════════════════════════════════════════════════════ */
.writers-hero {
  background: var(--color-canvas);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
  position: relative;
  overflow: hidden;
  text-align: center;
}
.writers-orb-peach {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(244, 197, 168, 0.4) 0%, transparent 70%);
  top: -150px; right: 10%;
  pointer-events: none;
}
.writers-orb-lavender {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(200, 184, 224, 0.35) 0%, transparent 70%);
  bottom: -80px; left: 10%;
  pointer-events: none;
}
.writers-hero-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-eyebrow {
  margin-bottom: var(--space-lg);
}
/* hero-display: DM Sans 600, 56px/80px */
.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(var(--fs-heading-lg), 5vw, var(--fs-hero-display));
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  line-height: var(--lh-hero-display);
  letter-spacing: -0.025em;
  margin-bottom: var(--space-md);
}
.hero-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-subtitle);
  color: var(--color-steel);
  line-height: 1.5;
  max-width: 500px;
  margin: 0 auto;
}

/* ── Sections ── */
.writers-section {
  background: transparent;
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
}
.writers-section--soft {
  background: transparent;
}

.sec-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}
/* heading-md: DM Sans 600, 32px */
.sec-title {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-md);
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  line-height: var(--lh-heading-md);
  letter-spacing: -0.01em;
  margin-bottom: var(--space-xs);
}
.sec-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-steel);
}

/* ── Writer Cards Grid — white surface-card, hairline, xl radius ── */
.writers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-lg);
}
@media (max-width: 960px) { .writers-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .writers-grid { grid-template-columns: 1fr; } }

.writer-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.writer-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* voice-icon-circular: surface-strong bg, initials */
.writer-avatar {
  width: 44px; height: 44px;
  border-radius: var(--radius-full);
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline);
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.writer-info {
  flex: 1;
}
/* title-sm: Inter 500 */
.writer-name {
  font-family: var(--font-sans);
  font-size: var(--fs-title-sm);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  margin-bottom: 2px;
}
.writer-spec {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
  margin-bottom: var(--space-xs);
}
/* body-sm: Inter 400 */
.writer-bio {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-body);
  line-height: var(--lh-body-sm);
  margin: 0;
}

.writer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--space-sm);
  border-top: 1px solid var(--color-hairline-soft);
  margin-top: auto;
}
.writer-tags { display: flex; gap: 4px; flex-wrap: wrap; }
.tag-badge {
  font-size: 10px;
  background: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
}
.follow-btn-small {
  font-size: var(--fs-caption);
  height: auto;
  padding: 6px 16px;
}

/* ── Expertise Pills Cloud ── */
.expertise-pills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  justify-content: center;
  margin-bottom: var(--space-xl);
}
.expertise-cloud-pill {
  font-size: var(--fs-body-sm);
  padding: 8px 20px;
  text-decoration: none;
  border: 1px solid var(--color-hairline);
  transition: background var(--duration-150) var(--ease-out), border-color var(--duration-150) var(--ease-out);
  cursor: pointer;
}
.expertise-cloud-pill:hover {
  background: var(--color-hairline-soft);
  border-color: var(--color-hairline-strong);
  color: var(--color-ink);
}

/* ── Leaderboard panels — feature-cards ── */
.leaderboard-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-lg);
}
@media (max-width: 768px) { .leaderboard-grid { grid-template-columns: 1fr; } }

.leaderboard-panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}
/* title-sm */
.panel-title {
  font-family: var(--font-sans);
  font-size: var(--fs-title-sm);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  margin: 0;
  padding-bottom: var(--space-sm);
  border-bottom: 1px solid var(--color-hairline-soft);
}

.panel-rows { display: flex; flex-direction: column; gap: var(--space-xs); }
.panel-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-md);
  transition: background var(--duration-150) var(--ease-out);
}
.panel-row:hover { background: var(--color-canvas-soft); }

.pr-rank {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: var(--fw-semibold);
  color: var(--color-muted-soft);
  width: 20px;
  flex-shrink: 0;
}

/* voice-icon-circular avatar */
.pr-avatar {
  width: 32px; height: 32px;
  border-radius: var(--radius-full);
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline-soft);
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pr-info { flex: 1; min-width: 0; }
.pr-name {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-medium);
  color: var(--color-body-strong);
}
.pr-meta {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
}

.pr-stat {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
  white-space: nowrap;
}

/* Emerging/New badge styling */
.pr-badge {
  font-size: 10px;
  border: 1px solid transparent;
}
.pr-badge--new {
  background: rgba(22, 163, 74, 0.08);
  color: var(--color-semantic-success);
  border-color: rgba(22, 163, 74, 0.15);
}
.pr-badge--rising {
  background: var(--color-surface-strong);
  color: var(--color-body-strong);
  border-color: var(--color-hairline);
}

/* ── CTA Band ── */
.writers-cta-band {
  background: var(--color-canvas);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
  position: relative;
  overflow: hidden;
}
.writers-cta-orb-mint {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(167, 229, 211, 0.4) 0%, transparent 70%);
  top: -100px; left: 50%;
  transform: translateX(-50%);
}
.writers-cta-orb-sky {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(168, 200, 232, 0.35) 0%, transparent 70%);
  bottom: -60px; right: 10%;
  pointer-events: none;
}
.writers-cta-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cta-eyebrow {
  margin-bottom: var(--space-lg);
}
/* display-lg: EB Garamond 300, 36px */
.cta-headline {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-md);
}
.cta-body {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  color: var(--color-body);
  line-height: var(--lh-body);
  max-width: 500px;
  margin-bottom: var(--space-xl);
}
.cta-buttons {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
  justify-content: center;
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .writers-hero, .writers-section, .writers-cta-band {
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-xxl);
  }
  .hero-title { font-size: var(--fs-display-md); }
  .cta-headline { font-size: var(--fs-display-sm); }
}
</style>