---
import Layout from '@/components/layout/Layout.astro';
import OnboardingWizard from '@/components/islands/onboarding/OnboardingWizard';
import { getCurrentUser } from '@/lib/auth';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
if (!user) {
  return Astro.redirect('/auth/sign-in?redirect_url=/onboarding');
}
---

<Layout title="Complete Your Creator Profile - CarcBlog" description="Professional onboarding for CarcBlog creators and readers.">
  <div style="min-height: 100vh; background: var(--color-canvas, #FAFAFA);">
    <OnboardingWizard client:load initialUser={{
      id: user.id,
      full_name: user.full_name || '',
      username: user.username || '',
      avatar_url: user.avatar_url || '',
      role: 'writer'
    }} />
  </div>
</Layout>