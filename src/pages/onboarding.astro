---
// User Onboarding Page — ElevenLabs editorial design system
import Layout from '@/components/layout/Layout.astro';
import { upsertUserProfile, getUserProfile } from '@/lib/supabase';

export const prerender = false;

// 1. Ensure user is authenticated
let userId = null;
let clerkUser = null;
if (typeof Astro.locals?.auth === 'function') {
  const auth = await Astro.locals.auth();
  userId = auth?.userId;
  if (userId && typeof Astro.locals?.currentUser === 'function') {
    clerkUser = await Astro.locals.currentUser();
  }
}

if (!userId) {
  return Astro.redirect('/auth/sign-in');
}

// 2. Check if onboarding is already completed
let existingProfile = null;
try {
  existingProfile = await getUserProfile(userId);
  if (existingProfile?.onboarding_completed) {
    return Astro.redirect('/dashboard');
  }
} catch (e) {
  // Profile doesn't exist yet, which is expected
}

// 3. Handle Form Submission
let errorMessage = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const fullName = formData.get('fullName')?.toString() || '';
    const role = formData.get('role')?.toString() as 'reader' | 'writer';
    const occupation = formData.get('occupation')?.toString() || '';
    const bio = formData.get('bio')?.toString() || '';

    if (!fullName || !role || !occupation) {
      errorMessage = 'Please fill in all required fields.';
    } else {
      await upsertUserProfile(userId, {
        full_name: fullName,
        role: role,
        occupation: occupation,
        bio: bio,
        username: clerkUser?.username || clerkUser?.emailAddresses?.[0]?.emailAddress.split('@')[0] || 'user',
        avatar_url: clerkUser?.imageUrl || null,
      });

      return Astro.redirect('/dashboard');
    }
  } catch (error) {
    console.error('Onboarding failed:', error);
    errorMessage = 'Something went wrong. Please try again.';
  }
}

const prefilledName = clerkUser?.fullName || `${clerkUser?.firstName || ''} ${clerkUser?.lastName || ''}`.trim() || '';
---

<Layout title="Welcome — Setup Your Profile" description="Complete your onboarding to access your writer dashboard.">
  <div class="onboarding-container">
    <!-- Atmospheric background orbs -->
    <div class="atm-orb onboarding-orb-mint" aria-hidden="true"></div>
    <div class="atm-orb onboarding-orb-peach" aria-hidden="true"></div>

    <!-- White surface card, hairline, xl radius -->
    <div class="onboarding-card">
      <div class="onboarding-header">
        <h1 class="onboarding-title">Welcome to Carcblog</h1>
        <p class="onboarding-subtitle">Let's set up your profile to customize your experience.</p>
      </div>

      {errorMessage && (
        <div class="error-banner" role="alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="error-icon" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span>{errorMessage}</span>
        </div>
      )}

      <form method="POST" class="onboarding-form" id="onboarding-form">
        <!-- Name Input -->
        <div class="form-group">
          <label for="fullName" class="form-label">Full Name <span class="required" aria-hidden="true">*</span></label>
          <input
            type="text"
            name="fullName"
            id="fullName"
            value={prefilledName}
            placeholder="e.g. Sweekar M"
            required
            class="form-input"
          />
        </div>

        <!-- Role Cards Selection -->
        <div class="form-group">
          <label class="form-label">Choose your Role <span class="required" aria-hidden="true">*</span></label>
          <div class="role-grid">
            <button
              type="button"
              class="role-card"
              data-role-btn="reader"
              aria-label="Select Reader role"
            >
              <div class="role-icon-box">📖</div>
              <div class="role-title">Reader</div>
              <div class="role-desc">Read founder stories, discover news, and follow startups.</div>
            </button>

            <button
              type="button"
              class="role-card"
              data-role-btn="writer"
              aria-label="Select Writer role"
            >
              <div class="role-icon-box">✍️</div>
              <div class="role-title">Writer</div>
              <div class="role-desc">Publish articles, share startup profiles, and write updates.</div>
            </button>
          </div>
          <input type="hidden" name="role" id="selected-role" required />
        </div>

        <!-- Occupation Radio Pills -->
        <div class="form-group">
          <label class="form-label">Occupation <span class="required" aria-hidden="true">*</span></label>
          <div class="occupation-pills">
            {[
              'Student',
              'Working Professional',
              'Freelancer',
              'Founder',
              'Other'
            ].map((occ) => (
              <label class="occ-pill-label">
                <input
                  type="radio"
                  name="occupation"
                  value={occ}
                  class="occ-pill-input"
                  required
                />
                <span class="occ-pill-text">{occ}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Bio Textarea -->
        <div class="form-group">
          <label for="bio" class="form-label">Short Bio <span class="optional">(Optional)</span></label>
          <textarea
            name="bio"
            id="bio"
            rows="3"
            placeholder="Tell us a bit about yourself..."
            class="form-textarea"
          ></textarea>
        </div>

        <!-- Submit Button: ink pill CTA -->
        <button type="submit" class="btn-primary submit-btn">
          <span>Complete Onboarding</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="btn-arrow" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  // Handlers for Role card selection
  const roleCards = document.querySelectorAll('[data-role-btn]');
  const roleInput = document.getElementById('selected-role');

  roleCards.forEach(card => {
    card.addEventListener('click', () => {
      const selectedRole = card.getAttribute('data-role-btn');
      
      // Update hidden input
      roleInput.value = selectedRole;

      // Update active UI classes
      roleCards.forEach(c => {
        if (c.getAttribute('data-role-btn') === selectedRole) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .onboarding-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--h-nav));
    padding: var(--space-lg);
    background-color: var(--color-canvas);
    overflow: hidden;
  }

  .onboarding-orb-mint {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(167, 229, 211, 0.4) 0%, transparent 70%);
    top: -100px; left: 10%;
    pointer-events: none;
  }
  .onboarding-orb-peach {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(244, 197, 168, 0.35) 0%, transparent 70%);
    bottom: -60px; right: 10%;
    pointer-events: none;
  }

  /* white surface card, hairline border, xl radius */
  .onboarding-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 580px;
    padding: var(--space-xl);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card-hover);
    animation: slide-up 0.5s var(--ease-out) both;
  }

  .onboarding-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  /* display-md: EB Garamond 300 */
  .onboarding-title {
    font-family: var(--font-serif);
    font-size: var(--fs-display-md);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
    line-height: var(--lh-display-md);
    letter-spacing: var(--ls-display-md);
  }

  .onboarding-subtitle {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-muted);
  }

  .onboarding-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-label {
    font-family: var(--font-sans);
    font-size: var(--fs-caption-upper);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ls-caption-upper);
    color: var(--color-muted);
  }

  .required {
    color: var(--color-semantic-error);
    margin-left: 2px;
  }
  .optional {
    color: var(--color-muted-soft);
    font-size: 11px;
    text-transform: lowercase;
  }

  /* text-input standard styling */
  .form-input {
    width: 100%;
    padding: 10px var(--space-sm);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-ink);
    background: var(--color-surface-card);
    box-sizing: border-box;
    transition: border-color var(--duration-150) var(--ease-out);
  }
  .form-textarea {
    width: 100%;
    padding: 12px var(--space-sm);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-ink);
    background: var(--color-surface-card);
    box-sizing: border-box;
    resize: vertical;
    transition: border-color var(--duration-150) var(--ease-out);
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-ink);
    border-width: 1.5px;
  }

  /* Role Selection Cards Grid */
  .role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .role-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-md);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color var(--duration-150) var(--ease-out), background-color var(--duration-150) var(--ease-out);
  }

  .role-card:hover {
    border-color: var(--color-hairline-strong);
    background-color: var(--color-canvas-soft);
  }

  /* Active role selection: surface-strong bg, ink border */
  .role-card.active {
    border-color: var(--color-ink);
    background-color: var(--color-surface-strong);
    border-width: 1.5px;
  }

  /* voice-icon-circular avatar */
  .role-icon-box {
    font-size: 20px;
    width: 44px; height: 44px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }
  .role-card.active .role-icon-box {
    background: var(--color-surface-card);
    border-color: var(--color-hairline-strong);
  }

  .role-title {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    margin-bottom: var(--space-xxs);
  }

  .role-desc {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-muted);
    line-height: var(--lh-body-sm);
  }

  /* Occupation Radio Pills */
  .occupation-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .occ-pill-label {
    cursor: pointer;
  }

  .occ-pill-input {
    display: none;
  }

  /* badge-pill style pills */
  .occ-pill-text {
    display: inline-block;
    padding: 6px 14px;
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--color-body);
    background-color: var(--color-surface-strong);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    transition: background-color var(--duration-150) var(--ease-out), border-color var(--duration-150) var(--ease-out);
  }

  .occ-pill-label:hover .occ-pill-text {
    border-color: var(--color-hairline-strong);
    color: var(--color-ink);
  }

  /* Active occ pill: ink bg, on-primary text */
  .occ-pill-input:checked + .occ-pill-text {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  /* Submit Button styling */
  .submit-btn {
    width: 100%;
    margin-top: var(--space-xs);
  }

  .btn-arrow {
    transition: transform var(--duration-150) var(--ease-out);
    margin-left: var(--space-xxs);
  }

  .submit-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Error Banner */
  .error-banner {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background-color: rgba(220, 26, 26, 0.05);
    border: 1px solid var(--color-semantic-error);
    border-radius: var(--radius-md);
    color: var(--color-semantic-error);
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    margin-bottom: var(--space-md);
  }

  .error-icon {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .role-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
