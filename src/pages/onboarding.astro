---
// User Onboarding Page
import Layout from '@/components/layout/Layout.astro';
import { upsertUserProfile, getUserProfile } from '@/lib/supabase';

export const prerender = false;

// 1. Ensure user is authenticated
let userId = null;
let clerkUser = null;
if (typeof Astro.locals?.auth === 'function') {
  const auth = await Astro.locals.auth();
  userId = auth?.userId;
  if (userId && typeof Astro.locals?.currentUser === 'function') {
    clerkUser = await Astro.locals.currentUser();
  }
}

if (!userId) {
  return Astro.redirect('/auth/sign-in');
}

// 2. Check if onboarding is already completed
let existingProfile = null;
try {
  existingProfile = await getUserProfile(userId);
  if (existingProfile?.onboarding_completed) {
    return Astro.redirect('/dashboard');
  }
} catch (e) {
  // Profile doesn't exist yet, which is expected
}

// 3. Handle Form Submission
let errorMessage = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const fullName = formData.get('fullName')?.toString() || '';
    const role = formData.get('role')?.toString() as 'reader' | 'writer';
    const occupation = formData.get('occupation')?.toString() || '';
    const bio = formData.get('bio')?.toString() || '';

    if (!fullName || !role || !occupation) {
      errorMessage = 'Please fill in all required fields.';
    } else {
      await upsertUserProfile(userId, {
        full_name: fullName,
        role: role,
        occupation: occupation,
        bio: bio,
        username: clerkUser?.username || clerkUser?.emailAddresses?.[0]?.emailAddress.split('@')[0] || 'user',
        avatar_url: clerkUser?.imageUrl || null,
      });

      return Astro.redirect('/dashboard');
    }
  } catch (error) {
    console.error('Onboarding failed:', error);
    errorMessage = 'Something went wrong. Please try again.';
  }
}

const prefilledName = clerkUser?.fullName || `${clerkUser?.firstName || ''} ${clerkUser?.lastName || ''}`.trim() || '';
---

<Layout title="Welcome — Setup Your Profile" description="Complete your onboarding to access your writer dashboard.">
  <div class="onboarding-container">
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>

    <div class="onboarding-card">
      <div class="onboarding-header">
        <h1 class="onboarding-title">Welcome to Carcblog</h1>
        <p class="onboarding-subtitle">Let's set up your profile to customize your experience.</p>
      </div>

      {errorMessage && (
        <div class="error-banner">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="error-icon">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span>{errorMessage}</span>
        </div>
      )}

      <form method="POST" class="onboarding-form" id="onboarding-form">
        <!-- Name Input -->
        <div class="form-group">
          <label for="fullName" class="form-label">Full Name <span class="required">*</span></label>
          <input
            type="text"
            name="fullName"
            id="fullName"
            value={prefilledName}
            placeholder="e.g. Sweekar M"
            required
            class="form-input"
          />
        </div>

        <!-- Role Cards Selection -->
        <div class="form-group">
          <label class="form-label">Choose your Role <span class="required">*</span></label>
          <div class="role-grid">
            <button
              type="button"
              class="role-card"
              data-role-btn="reader"
              aria-label="Select Reader role"
            >
              <div class="role-icon">📖</div>
              <div class="role-title">Reader</div>
              <div class="role-desc">Read founder stories, discover news, and follow startups.</div>
            </button>

            <button
              type="button"
              class="role-card"
              data-role-btn="writer"
              aria-label="Select Writer role"
            >
              <div class="role-icon">✍️</div>
              <div class="role-title">Writer</div>
              <div class="role-desc">Publish articles, share startup profiles, and write updates.</div>
            </button>
          </div>
          <input type="hidden" name="role" id="selected-role" required />
        </div>

        <!-- Occupation Radio Pills -->
        <div class="form-group">
          <label class="form-label">Occupation <span class="required">*</span></label>
          <div class="occupation-pills">
            {[
              'Student',
              'Working Professional',
              'Freelancer',
              'Founder',
              'Other'
            ].map((occ) => (
              <label class="occ-pill-label">
                <input
                  type="radio"
                  name="occupation"
                  value={occ}
                  class="occ-pill-input"
                  required
                />
                <span class="occ-pill-text">{occ}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Bio Textarea -->
        <div class="form-group">
          <label for="bio" class="form-label">Short Bio <span class="optional">(Optional)</span></label>
          <textarea
            name="bio"
            id="bio"
            rows="3"
            placeholder="Tell us a bit about yourself..."
            class="form-textarea"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="submit-btn">
          <span>Complete Onboarding</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  // Handlers for Role card selection
  const roleCards = document.querySelectorAll('[data-role-btn]');
  const roleInput = document.getElementById('selected-role');

  roleCards.forEach(card => {
    card.addEventListener('click', () => {
      const selectedRole = card.getAttribute('data-role-btn');
      
      // Update hidden input
      roleInput.value = selectedRole;

      // Update active UI classes
      roleCards.forEach(c => {
        if (c.getAttribute('data-role-btn') === selectedRole) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .onboarding-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 100px);
    padding: var(--spacing-6);
    background-color: var(--color-background);
    overflow: hidden;
  }

  /* Decorative Background Glows */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.12;
    z-index: 0;
    pointer-events: none;
  }
  .glow-orb-1 {
    top: 10%;
    left: 10%;
    width: 300px;
    height: 300px;
    background-color: var(--color-primary);
  }
  .glow-orb-2 {
    bottom: 10%;
    right: 10%;
    width: 350px;
    height: 350px;
    background-color: var(--color-primary);
    filter: hue-rotate(240deg) blur(120px);
  }

  /* Glassmorphism Card styling */
  .onboarding-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 600px;
    padding: var(--spacing-8);
    background: var(--color-glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-xl);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08);
    animation: slide-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .onboarding-header {
    text-align: center;
    margin-bottom: var(--spacing-8);
  }

  .onboarding-title {
    font-family: var(--font-sans);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-foreground);
    margin-bottom: var(--spacing-2);
    letter-spacing: -0.02em;
  }

  .onboarding-subtitle {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .onboarding-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .form-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
  }

  .required {
    color: var(--color-destructive);
  }
  .optional {
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-transform: lowercase;
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: var(--spacing-3) var(--spacing-4);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    transition: all var(--duration-150) var(--ease-in-out);
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  /* Role Selection Cards Grid */
  .role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
  }

  .role-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-5);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all var(--duration-200) var(--ease-in-out);
  }

  .role-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
  }

  .role-card.active {
    border-color: var(--color-primary);
    background-color: rgba(37, 99, 235, 0.03);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .role-icon {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-2);
  }

  .role-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-foreground);
    margin-bottom: var(--spacing-1);
  }

  .role-desc {
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
  }

  /* Occupation Radio Pills */
  .occupation-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .occ-pill-label {
    cursor: pointer;
  }

  .occ-pill-input {
    display: none;
  }

  .occ-pill-text {
    display: inline-block;
    padding: var(--spacing-2) var(--spacing-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-muted);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    transition: all var(--duration-150) var(--ease-in-out);
  }

  .occ-pill-label:hover .occ-pill-text {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .occ-pill-input:checked + .occ-pill-text {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-foreground);
  }

  /* Submit Button styling */
  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    width: 100%;
    padding: var(--spacing-4);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--duration-200) var(--ease-in-out);
    margin-top: var(--spacing-2);
  }

  .submit-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
  }

  .btn-arrow {
    transition: transform var(--duration-150) var(--ease-in-out);
  }

  .submit-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Error Banner */
  .error-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-3) var(--spacing-4);
    background-color: rgba(239, 68, 68, 0.05);
    border: 1px solid var(--color-destructive);
    border-radius: var(--radius-md);
    color: var(--color-destructive);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-6);
  }

  .error-icon {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .role-grid {
      grid-template-columns: 1fr;
    }
    .onboarding-card {
      padding: var(--spacing-6);
    }
  }
</style>
