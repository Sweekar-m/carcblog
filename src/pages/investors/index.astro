---
import Layout from '@/components/layout/Layout.astro';
import { getInvestors, getInvestorTypes } from '@/lib/supabase';
import { getCurrentUser } from '@/lib/auth';
import { REGION_OPTIONS } from '@/utils/regionTaxonomy';

export const prerender = false;

const user = await getCurrentUser(Astro.locals);
const url = new URL(Astro.request.url);
const search = url.searchParams.get('q') || '';
const type = url.searchParams.get('type') || 'All';
const selectedRegion = url.searchParams.get('region') || 'All Regions';
const page = parseInt(url.searchParams.get('page') || '1', 10);
const limit = 24;
const offset = (page - 1) * limit;

const [{ investors, total }, investorTypes] = await Promise.all([
  getInvestors({ search, type, region: selectedRegion, limit, offset }),
  getInvestorTypes()
]);

const totalPages = Math.ceil(total / limit);

function getPageUrl(p: number) {
  const params = new URLSearchParams(url.search);
  params.set('page', p.toString());
  return `/investors?${params.toString()}`;
}
---

<Layout title="Investor Directory - CarcBlog" description="Discover top venture capital firms, angel networks, family offices, and active startup investors.">
  <div style="max-width:1280px;margin:0 auto;padding:40px 24px 80px">

    {/* ── Page Header ── */}
    <div style="text-align:center;max-width:640px;margin:0 auto 48px">
      <div style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:9999px;background:#F8FAFC;border:1px solid #E2E8F0;font-family:var(--font-sans);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#64748B;margin-bottom:16px">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        Investor Directory
      </div>
      <p style="font-family:var(--font-sans);font-size:2.5rem;font-weight:700;line-height:1.2;letter-spacing:-0.02em;color:#0F172A;margin:0 0 12px">
        Discover Active Venture Capital & Angel Investors
      </p>
      <p style="font-family:var(--font-sans);font-size:1.125rem;font-weight:400;color:#64748B;line-height:1.6;margin:0">
        Browse {total.toLocaleString()} VC funds, angel networks, corporate VCs, and syndicate partners looking for high-growth startups.
      </p>
    </div>

    {/* ── Search & Filter Controls ── */}
    <div style="background:#FFFFFF;border:1px solid #E2E8F0;border-radius:16px;padding:20px;margin-bottom:40px;box-shadow:0px 1px 2px rgba(0,0,0,0.04)">
      <form method="GET" action="/investors" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
        <div style="position:relative;flex:1;min-width:240px">
          <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);pointer-events:none;color:#94A3B8;display:flex;align-items:center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <input
            type="text"
            name="q"
            id="investor-search"
            value={search}
            placeholder="Search investors by name, thesis, or value-add..."
            style="width:100%;padding:0 16px 0 42px;height:44px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;font-family:var(--font-sans);font-size:0.875rem;color:#0F172A;outline:none;transition:border-color 150ms;box-sizing:border-box"
          />
        </div>

        {investorTypes.length > 0 && (
          <div style="position:relative;min-width:200px">
            <select
              name="type"
              id="investor-type-filter"
              onchange="this.form.submit()"
              style="width:100%;padding:0 36px 0 14px;height:44px;appearance:none;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;font-family:var(--font-sans);font-size:0.875rem;color:#0F172A;outline:none;cursor:pointer"
            >
              <option value="All" selected={type === 'All'}>All Investor Types</option>
              {investorTypes.map((t) => (
                <option value={t} selected={type === t}>{t}</option>
              ))}
            </select>
            <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;color:#94A3B8;display:flex;align-items:center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            </span>
          </div>
        )}

        <div style="position:relative;min-width:180px">
          <select
            name="region"
            id="region-filter"
            onchange="this.form.submit()"
            style="width:100%;padding:0 36px 0 14px;height:44px;appearance:none;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;font-family:var(--font-sans);font-size:0.875rem;color:#0F172A;outline:none;cursor:pointer"
          >
            {REGION_OPTIONS.map((reg) => (
              <option value={reg} selected={selectedRegion === reg}>{reg}</option>
            ))}
          </select>
          <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;color:#94A3B8;display:flex;align-items:center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
        </div>

        <button
          type="submit"
          id="investor-search-submit"
          style="padding:0 24px;height:44px;border-radius:9999px;background:#0F172A;color:#FFFFFF;font-family:var(--font-sans);font-size:0.875rem;font-weight:600;border:none;cursor:pointer;white-space:nowrap"
        >
          Search
        </button>
      </form>
    </div>

    {/* ── Results Summary ── */}
    <div style="margin-bottom:20px">
      <p style="font-family:var(--font-sans);font-size:0.8125rem;color:#64748B;margin:0">
        Showing <strong style="color:#0F172A;font-weight:600">{investors.length}</strong> of <strong style="color:#0F172A;font-weight:600">{total.toLocaleString()}</strong> investors
        {search && <span> matching "<span style="color:#0284C7">{search}</span>"</span>}
        {type !== 'All' && <span> type <span style="color:#0284C7">{type}</span></span>}
      </p>
    </div>

    {/* ── Investor Directory Grid ── */}
    {investors.length > 0 ? (
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px">
        {investors.map((inv) => (
          <a href={`/investors/${inv.slug}`} style="display:flex;flex-direction:column;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:16px;padding:24px;text-decoration:none;transition:border-color 200ms,box-shadow 200ms;color:inherit" class="investor-card">
            
            {/* Header: Investor Type Pill & First Check Badge */}
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:14px;flex-wrap:wrap">
              <span style="padding:3px 10px;border-radius:9999px;background:#F8FAFC;border:1px solid #E2E8F0;font-family:var(--font-sans);font-size:0.75rem;font-weight:600;color:#0F172A">
                {inv.investor_type || 'VC / Investor'}
              </span>
              {inv.first_check && (
                <span style="padding:3px 10px;border-radius:9999px;background:rgba(14,165,233,0.08);border:1px solid rgba(14,165,233,0.2);font-family:var(--font-sans);font-size:0.75rem;font-weight:600;color:#0284C7">
                  Check: {inv.first_check}
                </span>
              )}
            </div>

            {/* Firm / Investor Name */}
            <p style="font-family:var(--font-sans);font-size:1.125rem;font-weight:700;color:#0F172A;margin:0 0 8px;line-height:1.3">
              {inv.name}
            </p>

            {/* Investment Thesis Summary */}
            <p style="font-family:var(--font-sans);font-size:0.875rem;color:#334155;line-height:1.6;margin:0 0 auto;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
              {inv.thesis || inv.value_add || 'Active early-stage investor supporting tech startups.'}
            </p>

            {/* Target Geography Tags */}
            {inv.target_geography && inv.target_geography.length > 0 && (
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:14px">
                {inv.target_geography.slice(0, 3).map((geo) => (
                  <span style="font-family:var(--font-sans);font-size:0.75rem;color:#64748B;background:#F1F5F9;padding:2px 8px;border-radius:4px">
                    📍 {geo}
                  </span>
                ))}
                {inv.target_geography.length > 3 && (
                  <span style="font-family:var(--font-sans);font-size:0.75rem;color:#94A3B8;padding:2px 4px">
                    +{inv.target_geography.length - 3} more
                  </span>
                )}
              </div>
            )}

            {/* Footer: Reply Rate / Action */}
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:14px;border-top:1px solid #F1F5F9">
              {inv.reply_rate ? (
                <span style="font-family:var(--font-sans);font-size:0.75rem;color:#64748B">
                  Reply Rate: <strong style="color:#0F172A">{inv.reply_rate}</strong>
                </span>
              ) : (
                <span style="font-family:var(--font-sans);font-size:0.75rem;color:#64748B">
                  OpenVC Profile
                </span>
              )}
              <span style="font-family:var(--font-sans);font-size:0.8125rem;font-weight:600;color:#0F172A">
                View Profile →
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div style="text-align:center;padding:80px 24px;background:#F8FAFC;border-radius:16px;border:1px solid #E2E8F0">
        <p style="font-family:var(--font-sans);font-size:1.125rem;font-weight:600;color:#0F172A;margin:0 0 8px">
          No investors found
        </p>
        <p style="font-family:var(--font-sans);font-size:0.875rem;color:#64748B;margin:0">
          Try clearing your search query or selecting a different investor type filter.
        </p>
      </div>
    )}

    {/* ── Pagination ── */}
    {totalPages > 1 && (
      <div style="display:flex;justify-content:center;align-items:center;gap:8px;margin-top:48px">
        {page > 1 && (
          <a
            href={getPageUrl(page - 1)}
            style="padding:8px 16px;border-radius:9999px;background:#FFFFFF;border:1px solid #E2E8F0;font-family:var(--font-sans);font-size:0.875rem;font-weight:600;color:#0F172A;text-decoration:none"
          >
            ← Previous
          </a>
        )}
        <span style="font-family:var(--font-sans);font-size:0.875rem;color:#64748B;padding:0 12px">
          Page {page} of {totalPages}
        </span>
        {page < totalPages && (
          <a
            href={getPageUrl(page + 1)}
            style="padding:8px 16px;border-radius:9999px;background:#FFFFFF;border:1px solid #E2E8F0;font-family:var(--font-sans);font-size:0.875rem;font-weight:600;color:#0F172A;text-decoration:none"
          >
            Next →
          </a>
        )}
      </div>
    )}

  </div>
</Layout>

<style>
  .investor-card:hover {
    border-color: #CBD5E1 !important;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.05) !important;
  }
</style>
