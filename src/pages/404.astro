---
// 404 Page — MiniMax Design System (v2)
import Layout from '@/components/layout/Layout.astro';
---

<Layout title="404 - Page Not Found — Carcblog" description="The page you are looking for does not exist.">
  <div class="min-h-[70vh] flex flex-col items-center justify-center py-20 px-4 text-center">
    <div class="max-w-md mx-auto space-y-6">
      <span class="inline-block px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-semibold uppercase tracking-wider">404 Error</span>
      <h1 class="text-7xl font-semibold tracking-tighter text-slate-900 font-sans">Lost in space?</h1>
      <p class="text-base text-slate-600 font-sans leading-relaxed">
        The page or story you were looking for doesn't exist or has been moved.
      </p>
      <div class="pt-4">
        <a href="/" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-semibold rounded-full text-white bg-slate-900 hover:bg-black transition-all">
          Return to homepage →
        </a>
      </div>
    </div>
  </div>
</Layout>