---
// Article detail page — ElevenLabs editorial design system
import Layout from '@/components/layout/Layout.astro';
import { getSanityArticleBySlugForUser, safeImageUrl, portableTextToHtml } from '@/lib/sanity';

import { requireAuth } from '@/lib/requireAuth';
import { getUserProfile } from '@/lib/supabase';

export const prerender = false;

let userId: string | null = null;
let isAdmin = false;
try {
  userId = await requireAuth(Astro.locals);
  if (userId) {
    const profile = await getUserProfile(userId);
    isAdmin = profile?.role === 'admin';
  }
} catch {
  // Unauthenticated guest request
}

const { slug } = Astro.params;
const articleSlug = typeof slug === 'string'
  ? slug
  : Array.isArray(slug)
    ? slug.filter(s => s !== '').join('/')
    : '';

const articleRaw = await getSanityArticleBySlugForUser(articleSlug, userId, isAdmin);

if (!articleRaw) {
  return Astro.redirect('/404');
}

// Helper to extract plain text from Portable Text for excerpt if needed
const extractPlainText = (blocks) => {
  if (!blocks || !Array.isArray(blocks)) return '';
  return blocks
    .map(block =>
      block.children?.map(child => child.text || '').join(' ') || ''
    )
    .join('\n\n')
    .replace(/\n+/g, ' ')
    .trim();
};

const isOwner = userId != null && articleRaw.author?.clerkUserId === userId;
const canManage = isOwner || isAdmin;
const status = articleRaw.status ?? (articleRaw.publishedAt ? 'published' : 'draft');

const article = {
  id: articleRaw._id,
  title: articleRaw.title,
  excerpt: articleRaw.excerpt ??
    (articleRaw.body ? extractPlainText(articleRaw.body).substring(0, 150) + '...' : '(no excerpt)'),
  publishedAt: articleRaw.publishedAt,
  status,
  author: {
    name: articleRaw.author?.name ?? 'Unknown',
    image: safeImageUrl(articleRaw.author?.image)
  },
  coverImage: safeImageUrl(articleRaw.coverImage, articleRaw.body),
  body: articleRaw.body
};



const authorInitial = article.author.name.charAt(0).toUpperCase();
---

<Layout title={`${article.title} — Carcblog`} description={article.excerpt}>

  <!-- Reading progress bar — ink-colored thin line -->
  <div class="reading-progress-bar" aria-hidden="true">
    <div class="reading-progress-fill" id="progressBar"></div>
  </div>

  <div class="article-page">
    <div class="page-container">
      <div class="article-glass-column">

        {canManage && (
          <!-- Owner / Admin Action Bar -->
          <div class="owner-manage-bar" data-article-id={article.id}>
            <div class="owner-status-pill">
              <span class={`status-badge status-${article.status}`}>
                {article.status.toUpperCase()}
              </span>
              {article.status === 'draft' && (
                <span class="draft-notice">Draft Preview (Only Visible To You)</span>
              )}
            </div>
            <div class="owner-actions">
              {article.status !== 'published' && (
                <button type="button" class="btn-publish-global" id="btnPublishGlobal">
                  🚀 Publish Globally
                </button>
              )}
              <button type="button" class="btn-delete-article" id="btnDeleteArticle">
                🗑️ Delete Article
              </button>
            </div>
          </div>
        )}

        <!-- ── Article Header ── -->
        <header class="article-header">

        <!-- Author row: voice-icon-circular + Inter 500 name + caption date -->
        <div class="article-meta">
          <div class="author-row">
            {article.author.image ? (
              <img
                src={article.author.image}
                alt={article.author.name}
                class="author-avatar"
              />
            ) : (
              <div class="author-avatar-fallback" aria-hidden="true">
                {authorInitial}
              </div>
            )}
            <div class="author-info">
              <span class="author-name">{article.author.name}</span>
              <span class="author-title">Carcblog Contributor</span>
            </div>
          </div>
          <time class="publish-date" datetime={article.publishedAt ?? undefined}>
            {article.publishedAt ? (
              new Date(article.publishedAt).toLocaleDateString(undefined, {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })
            ) : (
              'Draft (Unpublished)'
            )} · 5 min read
          </time>
        </div>


        <!-- Headline: display-xl, EB Garamond 300, 48px, -0.96px tracking, ink -->
        <h1 class="article-title">{article.title}</h1>

        <!-- Cover image: xl radius -->
        {article.coverImage && (
          <div class="article-cover-wrap">
            <img
              src={article.coverImage}
              alt={article.title}
              class="article-cover"
              loading="eager"
              referrerpolicy="no-referrer"
            />
          </div>
        )}
      </header>

      <!-- ── Article Body — 680px reading column ── -->
      <article class="article-body reading-col">
        {article.body ? (
          <div class="prose" set:html={portableTextToHtml(article.body, article.coverImage)} />
        ) : (
          <p class="article-empty">Article content loading…</p>
        )}
      </article>

      <!-- ── Author card at bottom ── -->
      <footer class="article-footer reading-col">
        <div class="author-card">
          {article.author.image ? (
            <img
              src={article.author.image}
              alt={article.author.name}
              class="author-card-avatar"
              referrerpolicy="no-referrer"
            />
          ) : (
            <div class="author-card-avatar-fallback">
              {authorInitial}
            </div>
          )}
          <div class="author-card-info">
            <span class="author-card-name">{article.author.name}</span>
            <span class="author-card-role">Carcblog Contributor</span>
          </div>
        </div>
      </footer>

      </div><!-- /.article-glass-column -->
    </div>
  </div>

</Layout>

<script>
  const progressBar = document.getElementById('progressBar');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight - windowHeight;
      const scrolled = window.scrollY;
      const progress = documentHeight > 0 ? (scrolled / documentHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    }, { passive: true });
  }

  const manageBar = document.querySelector('.owner-manage-bar');
  if (manageBar) {
    const articleId = manageBar.getAttribute('data-article-id');
    const btnPublish = document.getElementById('btnPublishGlobal');
    const btnDelete = document.getElementById('btnDeleteArticle');

    if (btnPublish && articleId) {
      btnPublish.addEventListener('click', async () => {
        if (!confirm('Publish this article globally now?')) return;
        btnPublish.setAttribute('disabled', 'true');
        btnPublish.textContent = 'Publishing...';
        try {
          const res = await fetch(`/api/articles/${articleId}/publish`, { method: 'POST' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('Article published globally successfully!');
            window.location.reload();
          } else {
            alert('Failed to publish article: ' + (data.error || 'Unknown error'));
            btnPublish.removeAttribute('disabled');
            btnPublish.textContent = '🚀 Publish Globally';
          }
        } catch (err: any) {
          alert('Error: ' + err.message);
          btnPublish.removeAttribute('disabled');
          btnPublish.textContent = '🚀 Publish Globally';
        }
      });
    }

    if (btnDelete && articleId) {
      btnDelete.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this article? This action cannot be undone.')) return;
        btnDelete.setAttribute('disabled', 'true');
        btnDelete.textContent = 'Deleting...';
        try {
          const res = await fetch(`/api/articles/${articleId}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('Article deleted successfully.');
            window.location.href = '/dashboard/articles';
          } else {
            alert('Failed to delete article: ' + (data.error || 'Unknown error'));
            btnDelete.removeAttribute('disabled');
            btnDelete.textContent = '🗑️ Delete Article';
          }
        } catch (err: any) {
          alert('Error: ' + err.message);
          btnDelete.removeAttribute('disabled');
          btnDelete.textContent = '🗑️ Delete Article';
        }
      });
    }
  }
</script>

<style>
/* ── Owner / Admin Action Bar ── */
.owner-manage-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: rgba(15, 23, 42, 0.05);
  border: 1px solid rgba(15, 23, 42, 0.12);
  padding: 12px 18px;
  border-radius: var(--radius-lg);
  margin-bottom: 24px;
}
.owner-status-pill {
  display: flex;
  align-items: center;
  gap: 10px;
}
.status-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border-radius: 4px;
}
.status-draft { background: #fef08a; color: #854d0e; }
.status-published { background: #dcfce7; color: #166534; }
.status-scheduled { background: #e0f2fe; color: #075985; }
.draft-notice {
  font-size: 12px;
  font-weight: 500;
  color: var(--color-muted);
}
.owner-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}
.btn-publish-global {
  background: #0f172a;
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: opacity 150ms ease;
}
.btn-publish-global:hover { opacity: 0.9; }
.btn-delete-article {
  background: #ef4444;
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: opacity 150ms ease;
}
.btn-delete-article:hover { opacity: 0.9; }

/* ── Reading progress bar — 2px ink-colored line ── */

.reading-progress-bar {
  position: fixed;
  top: var(--h-nav);                       /* sits below the 64px nav */
  left: 0;
  right: 0;
  height: 2px;
  background: var(--color-hairline);
  z-index: 999;
}
.reading-progress-fill {
  height: 100%;
  width: 0;
  background: var(--color-ink);
  transition: width 100ms linear;
}

/* ── Article page layout ── */
.article-page {
  background: transparent;
  min-height: calc(100vh - var(--h-nav));
  padding: var(--space-section) 0;
}

/* ── Article header ── */
.article-header {
  max-width: 720px;                         /* Aligned to reading-col max-width */
  margin: 0 auto;
  margin-bottom: var(--space-xl);
}

/* Author meta row */
.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-xl);          /* 32px before headline */
}
.author-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
/* voice-icon-circular: surface-strong, full radius */
.author-avatar {
  width: 36px; height: 36px;
  border-radius: var(--radius-full);
  object-fit: cover;
  border: 1px solid var(--color-hairline);
  flex-shrink: 0;
}
.author-avatar-fallback {
  width: 36px; height: 36px;
  border-radius: var(--radius-full);
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  flex-shrink: 0;
}
.author-info {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.author-name {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-medium);
  color: var(--color-body-strong);
  line-height: 1.3;
}
.author-title {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  font-weight: var(--fw-regular);
  color: var(--color-muted);
}

/* caption-uppercase: date */
.publish-date {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  font-weight: var(--fw-regular);
  color: var(--color-muted);
  letter-spacing: var(--ls-body-sm);
}

/* ── Headline: DM Sans 600, 40px/48px ── */
.article-title {
  font-family: var(--font-sans);
  font-size: clamp(var(--fs-heading-md), 4vw, var(--fs-heading-lg));
  font-weight: var(--fw-semibold);
  line-height: var(--lh-heading-lg);
  letter-spacing: var(--ls-heading-lg);
  color: var(--color-ink-strong);
  margin-bottom: var(--space-xl);
}

/* Cover image */
.article-cover-wrap {
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--color-hairline);
}
.article-cover {
  width: 100%;
  display: block;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

/* ── Article body — reading-col 720px max ── */
.article-body {
  padding-bottom: var(--space-xxl);
}
.article-empty {
  color: var(--color-muted);
  font-style: italic;
}

/* ── Prose styles — Cormorant Garamond serif for reading prose (Option B) ── */
.prose {
  font-family: var(--font-serif);
  font-size: 1.1875rem;                     /* ~19px reading serif */
  font-weight: 400;
  line-height: 1.75;
  color: var(--color-charcoal);
}

.prose p {
  margin-bottom: 1.75rem;
  color: var(--color-charcoal);
}

.prose strong {
  font-weight: 600;
  color: var(--color-ink-strong);
}

.prose em { font-style: italic; }

/* Links — ink, subtle underline */
.prose a {
  color: var(--color-ink);
  text-decoration: underline;
  text-decoration-color: var(--color-hairline-strong);
  text-underline-offset: 3px;
  transition: text-decoration-color var(--duration-150) var(--ease-out);
}
.prose a:hover {
  text-decoration-color: var(--color-ink);
  opacity: 1;
}

/* Headings in body — DM Sans 600 */
.prose h2 {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-md);
  font-weight: var(--fw-semibold);
  line-height: var(--lh-heading-md);
  letter-spacing: var(--ls-heading-md);
  color: var(--color-ink-strong);
  margin-top: var(--space-xxl);
  margin-bottom: var(--space-md);
}
.prose h3 {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-sm);
  font-weight: var(--fw-semibold);
  line-height: var(--lh-heading-sm);
  color: var(--color-ink-strong);
  margin-top: var(--space-xl);
  margin-bottom: var(--space-sm);
}
.prose h4 {
  font-family: var(--font-sans);
  font-size: var(--fs-card-title);
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  margin-top: var(--space-lg);
  margin-bottom: var(--space-xs);
}

/* Blockquote — display-sm pull quote style */
.prose blockquote {
  border-left: 2px solid var(--color-hairline-strong);
  padding-left: var(--space-lg);
  margin: var(--space-xl) 0;
  font-family: var(--font-serif);
  font-size: var(--fs-display-sm);          /* 24px — display-sm spec for pull quotes */
  font-weight: var(--fw-light);
  line-height: var(--lh-display-sm);
  color: var(--color-body-strong);
  font-style: italic;
}
.prose blockquote p { margin-bottom: 0; color: inherit; }

/* Code — surface-strong bg */
.prose pre {
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  overflow-x: auto;
  margin: var(--space-xl) 0;
}
.prose code {
  font-family: var(--font-mono);
  font-size: 0.9em;
  background: var(--color-surface-strong);
  padding: 2px 6px;
  border-radius: var(--radius-xs);
  color: var(--color-body-strong);
}
.prose pre code {
  background: transparent;
  padding: 0;
  border-radius: 0;
  font-size: inherit;
  color: var(--color-body-strong);
}

/* Lists */
.prose ul, .prose ol {
  margin: var(--space-md) 0;
  padding-left: var(--space-lg);
  color: var(--color-body);
}
.prose li { margin-bottom: var(--space-xs); }

/* HR — hairline divider */
.prose hr {
  border: none;
  border-top: 1px solid var(--color-hairline);
  margin: var(--space-xxl) 0;
}

/* ── Author card at bottom ── */
.article-footer {
  border-top: 1px solid var(--color-hairline);
  padding-top: var(--space-xl);
}
.author-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.author-card-avatar {
  width: 48px; height: 48px;
  border-radius: var(--radius-full);
  object-fit: cover;
  border: 1px solid var(--color-hairline);
  flex-shrink: 0;
}
.author-card-avatar-fallback {
  width: 48px; height: 48px;
  border-radius: var(--radius-full);
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: var(--fs-title-sm);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  flex-shrink: 0;
}
.author-card-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.author-card-name {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-medium);
  color: var(--color-body-strong);
}
.author-card-role {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .article-title {
    font-size: var(--fs-display-md);        /* 32px on mobile */
    letter-spacing: var(--ls-display-md);
  }
  .article-page { padding: var(--space-xxl) 0; }
  .article-meta { flex-direction: column; align-items: flex-start; }
}
.article-glass-column {
  max-width: 820px;
  margin: 0 auto;
  padding: var(--space-xxl) var(--space-xl);
  background: rgba(245, 245, 245, 0.65);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8px 48px rgba(0, 0, 0, 0.06);
  border-radius: var(--radius-xxl);
}
@media (max-width: 768px) {
  .article-glass-column {
    padding: var(--space-lg) var(--space-sm);
    border-radius: var(--radius-xl);
    background: rgba(245, 245, 245, 0.82);
  }
}
</style>
