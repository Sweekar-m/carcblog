---
// Article detail page
import Layout from '@/components/layout/Layout.astro';
import { getArticleBySlugWithFallback } from '@/lib/supabase';

export const prerender = false;

const { slug } = Astro.params;
const articleSlug = slug.join('/');
const articleRaw = await getArticleBySlugWithFallback(articleSlug);

if (!articleRaw) {
  return Astro.redirect('/404');
}

const article = {
  title: articleRaw.title,
  excerpt: articleRaw.excerpt ?? articleRaw.content?.substring(0, 150) + '...',
  publishedAt: articleRaw.published_at,
  author: {
    name: articleRaw.author?.full_name ?? articleRaw.author?.username ?? 'Unknown',
    image: articleRaw.author?.avatar_url
  },
  coverImage: articleRaw.cover_image_url,
  body: articleRaw.content
};
---

<Layout title={`${article.title} - Carcblog`} description={article.excerpt}>
  <div class="min-h-[calc(100vh-var(--header-height))] flex flex-col">
    {/* Article Header */}
    <header class="article-header text-center mb-8 pb-6 border-b border-border">
      <div class="article-meta flex flex-col items-center space-x-3 space-y-2">
        <div class="article-author flex items-center space-x-3">
          {article.author.image ? (
            <img
              src={article.author.image}
              alt={article.author.name}
              class="author-avatar h-8 w-8 rounded-full object-cover"
            />
          ) : (
            <div class="author-avatar flex h-8 w-8 items-center justify-center rounded-full bg-primary text-primary-foreground font-medium text-xs">
              {article.author.name.charAt(0).toUpperCase()}
            </div>
          )}
          <div class="author-info text-left">
            <div class="author-name font-semibold text-foreground">{article.author.name}</div>
            <div class="author-title text-xs text-foreground-muted">CarcBlog Contributor</div>
          </div>
        </div>
        <div class="publish-date text-sm text-foreground-muted">
          {new Date(article.publishedAt).toLocaleDateString(undefined, {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })} • 5 min read
        </div>
      </div>
      <h1 class="article-title font-serif text-5xl font-bold text-foreground mb-4 leading-tight">
        {article.title}
      </h1>
      {article.coverImage && (
        <div class="relative">
          <img
            src={article.coverImage}
            alt={article.title}
            class="article-image w-full h-64 object-cover rounded-lg shadow-lg"
            loading="lazy"
          />
        </div>
      )}
    </header>

    <!-- Reading Progress Bar -->
    <div class="reading-progress h-0.5 bg-background-muted rounded-full overflow-hidden my-4">
      <div class="reading-progress-fill h-full bg-accent-2 transition-all duration-100" id="progressBar"></div>
    </div>

    <!-- Article Content -->
    <article class="article-content prose prose-lg max-w-none">
      {article.body ? (
        <p>{article.body}</p>
      ) : (
        <p class="text-foreground-muted">Article content loading...</p>
      )}
    </article>

    {article.author.bio && (
      <!-- Author Bio -->
      <section class="author-bio flex items-start mt-8 pt-6 border-t border-border">
        {article.author.image ? (
          <img
            src={article.author.image}
            alt={article.author.name}
            class="author-bio-avatar h-10 w-10 rounded-full object-cover"
          />
        ) : (
          <div class="author-bio-avatar flex h-10 w-10 items-center justify-center rounded-full bg-primary text-primary-foreground font-bold text-xs">
            {article.author.name.charAt(0).toUpperCase()}
          </div>
        )}
        <div class="author-bio-content ml-4 flex-1">
          <h3 class="author-bio-name font-semibold text-foreground text-lg">{article.author.name}</h3>
          <div class="author-bio-title text-sm text-foreground-muted mb-2">Contributor</div>
          <p class="author-bio-description text-sm text-foreground-muted">{article.author.bio}</p>
        </div>
      </section>
    )}
  </div>

  <script>
    // Update reading progress bar
    const progressBar = document.getElementById('progressBar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight - windowHeight;
        const scrolled = window.scrollY;
        const progress = documentHeight > 0 ? (scrolled / documentHeight) * 100 : 0;
        progressBar.style.width = `${progress}%`;
      });
    }
  </script>
</Layout>

<style>
  /* Prose classes for article content - customize to match design system */
  .prose {
    color: var(--color-foreground);
    max-width: none;
  }

  .prose p {
    margin-bottom: var(--space-5);
    font-size: var(--font-size-3);
    line-height: var(--leading-relaxed);
  }

  .prose strong {
    color: var(--color-foreground);
    font-weight: var(--font-weight-semibold);
  }

  .prose a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--duration-200) var(--ease-in-out);
  }

  .prose a:hover {
    color: var(--color-primary-hover);
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: var(--color-foreground);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--space-6);
    margin-bottom: var(--space-4);
    line-height: var(--leading-tight);
  }

  .prose h1 {
    font-size: var(--font-size-7);
  }

  .prose h2 {
    font-size: var(--font-size-6);
  }

  .prose h3 {
    font-size: var(--font-size-5);
  }

  .prose h4 {
    font-size: var(--font-size-4);
  }

  .prose h5 {
    font-size: var(--font-size-3);
  }

  .prose h6 {
    font-size: var(--font-size-2);
  }

  .prose blockquote {
    border-left-width: var(--border-3);
    border-left-color: var(--color-primary);
    padding-left: var(--space-4);
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
    font-style: italic;
    color: var(--color-foreground-muted);
  }

  .prose pre {
    background-color: var(--color-background-muted);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
  }

  .prose code {
    background-color: var(--color-background-muted);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-xs);
    font-size: 0.9em;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  .prose ul,
  .prose ol {
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
  }

  .prose li {
    margin-bottom: var(--space-2);
  }

  .prose li > ul,
  .prose li > ol {
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .prose hr {
    border-top-width: var(--border-1);
    border-top-color: var(--color-border-muted);
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
</style>
