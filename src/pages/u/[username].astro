---
import Layout from '@/components/layout/Layout.astro';
import PublicProfileView from '@/components/islands/profile/PublicProfileView';
import { getProfileByUsername, getUserSocialLinks, getProfileStats, getUserActivityFeed, getUserFollowers, getUserFollowing } from '@/lib/profile';
import { getSanityArticlesByAuthor } from '@/lib/sanity';
import { getCurrentUser } from '@/lib/auth';
import { getFollowStatus } from '@/lib/social';

export const prerender = false;

const { username } = Astro.params;
if (!username) {
  return Astro.redirect('/404');
}

const profile = await getProfileByUsername(username);
if (!profile) {
  return Astro.redirect('/404');
}

const currentUser = await getCurrentUser(Astro.locals);

const [socialLinks, stats, userArticles, activityFeed, followStatus, followersList, followingList] = await Promise.all([
  getUserSocialLinks(profile.id),
  getProfileStats(profile.id),
  getSanityArticlesByAuthor(profile.id, 50).catch(() => []),
  getUserActivityFeed(profile.id, 20).catch(() => []),
  getFollowStatus(currentUser?.id || null, profile.id),
  getUserFollowers(profile.id).catch(() => []),
  getUserFollowing(profile.id).catch(() => []),
]);
---

<Layout title={`${profile.full_name || profile.username} (@${profile.username}) - CarcBlog`} description={profile.bio || profile.tagline || `${profile.full_name}'s creator profile on CarcBlog.`}>
  <PublicProfileView
    client:load
    profile={profile}
    socialLinks={socialLinks}
    stats={stats}
    followersList={followersList}
    followingList={followingList}
    userArticles={userArticles}
    activityFeed={activityFeed}
    currentUserId={currentUser?.id || null}
    initialIsFollowing={followStatus.isFollowing}
  />
</Layout>
