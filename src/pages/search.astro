---
// Search page
import Layout from '@/components/layout/Layout.astro';
---
<Layout title="Search - Carcblog" description="Search for articles, topics, and writers">
  <div class="search-tiles">
    <!-- Tile 1: Search Query Box (Parchment Background) -->
    <section class="tile-parchment animate-fade-in">
      <div class="max-w-[640px] mx-auto px-6 text-center">
        <h1 class="search-hero-title">Search Carcblog</h1>
        
        <div class="relative flex items-center justify-center mt-6">
          <label for="search-input-field" class="sr-only">Search</label>
          <!-- Search input matching search-input specification -->
          <input
            type="text"
            id="search-input-field"
            placeholder="Search articles, topics, or authors..."
            class="search-bar"
          />
          <div class="search-icon-box">
            <svg class="h-4.5 w-4.5 text-ink/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
        <p class="search-helper-text">
          Try searching for "technology", "astronomy", "productivity", or a specific author.
        </p>
      </div>
    </section>

    <!-- Tile 2: Results & Popular Directory (White Background) -->
    <section class="tile-white">
      <div class="max-w-[720px] mx-auto px-6">
        <!-- Empty State Container -->
        <div class="empty-state">
          <svg class="h-10 w-10 text-foreground-subtle mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <h3 class="empty-title">Enter search terms</h3>
          <p class="empty-desc">
            Your search results will appear here. Start typing in the box above.
          </p>
        </div>

        <!-- Popular Tags List -->
        <div class="popular-tags-box">
          <h2 class="popular-tags-title">Popular searches</h2>
          <div class="flex flex-wrap gap-2 justify-center">
            <span class="search-tag-pill">Technology</span>
            <span class="search-tag-pill">Science</span>
            <span class="search-tag-pill">Culture</span>
            <span class="search-tag-pill">Interface Design</span>
            <span class="search-tag-pill">Productivity</span>
            <span class="search-tag-pill">Startup</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .search-tiles {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  section {
    width: 100%;
    padding-top: var(--spacing-section);
    padding-bottom: var(--spacing-section);
    border-bottom: 1px solid var(--color-divider-soft);
  }

  .tile-parchment {
    background-color: var(--color-canvas-parchment);
  }

  .tile-white {
    background-color: var(--color-canvas);
  }

  .search-hero-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-display-lg);
    font-weight: 600;
    color: var(--color-ink);
  }

  /* Search Input Field Style (Search-input standard: rounded-pill, hairline border) */
  .search-bar {
    width: 100%;
    height: 48px;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill); /* 9999px */
    padding-left: 48px;
    padding-right: 20px;
    font-size: var(--font-size-body); /* 17px */
    color: var(--color-ink);
    transition: all 200ms ease;
  }

  .search-bar:focus {
    outline: none;
    border-color: var(--color-primary-focus);
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.15);
  }

  .search-icon-box {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .search-helper-text {
    font-size: var(--font-size-caption);
    color: var(--color-foreground-muted);
    margin-top: var(--spacing-sm);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-divider-soft);
    margin-bottom: var(--spacing-xl);
  }

  .empty-title {
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--color-ink);
  }

  .empty-desc {
    font-size: var(--font-size-caption);
    color: var(--color-foreground-muted);
    margin-top: var(--spacing-xxs);
  }

  /* Popular Tags */
  .popular-tags-box {
    text-align: center;
  }

  .popular-tags-title {
    font-size: var(--font-size-caption);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: var(--spacing-md);
  }

  .search-tag-pill {
    font-size: var(--font-size-caption);
    color: var(--color-foreground);
    background-color: var(--color-canvas-parchment);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    cursor: pointer;
    transition: all 200ms ease;
    border: 1px solid var(--color-hairline);
  }
  .search-tag-pill:hover {
    background-color: var(--color-surface-pearl);
    border-color: var(--color-foreground-muted);
  }
</style>