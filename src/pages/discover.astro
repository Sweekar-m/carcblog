---
// Discover page — ElevenLabs editorial design system
import Layout from '@/components/layout/Layout.astro';
---
<Layout title="Discover — Carcblog" description="Explore trending topics, featured writers, and curated reading lists on Carcblog">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO — Trending Topics
       canvas bg, display-mega headline, atmospheric orbs
  ═══════════════════════════════════════════════ -->
  <section class="discover-hero">
    <!-- Atmospheric orbs — decoration only -->
    <div class="atm-orb discover-orb-mint"     aria-hidden="true"></div>
    <div class="atm-orb discover-orb-peach"    aria-hidden="true"></div>
    <div class="page-container">
      <div class="discover-hero-text">
        <h1 class="discover-title">Discover</h1>
        <p class="discover-sub">
          Explore trending topics, inspiring voices, and curated reading paths across the startup ecosystem.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: TRENDING TOPICS
       feature-card grid with badge-pill labels
  ═══════════════════════════════════════════════ -->
  <section class="discover-section discover-section--soft">
    <div class="page-container">
      <div class="sec-header">
        <h2 class="sec-title">Trending Topics</h2>
        <p class="sec-sub">What the community is reading and writing about.</p>
      </div>

      <div class="topics-grid reveal-grid">
        {[
          { href: '/topics#startups',   label: 'Startups',     count: '1.2M', orb: 'mint' },
          { href: '/topics#funding',    label: 'Funding',      count: '850K', orb: 'peach' },
          { href: '/topics#founders',   label: 'Founders',     count: '620K', orb: 'lavender' },
          { href: '/topics#technology', label: 'Technology',   count: '410K', orb: 'sky' },
          { href: '/topics#product',    label: 'Product',      count: '380K', orb: 'rose' },
          { href: '/topics#growth',     label: 'Growth',       count: '295K', orb: 'mint' },
        ].map(({ href, label, count, orb }) => (
          <a href={href} class={`topic-card topic-card--${orb}`} aria-label={`Browse ${label} — ${count} articles`}>
            <div class={`topic-orb topic-orb--${orb}`} aria-hidden="true"></div>
            <div class="topic-content">
              <span class="badge-pill topic-badge">#</span>
              <h3 class="topic-name">{label}</h3>
              <p class="topic-count">{count} articles</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3: FEATURED WRITERS
       voice-row style: circular avatar, Inter body
  ═══════════════════════════════════════════════ -->
  <section class="discover-section">
    <div class="page-container">
      <div class="sec-header sec-header--split">
        <div>
          <h2 class="sec-title">Featured Writers</h2>
          <p class="sec-sub">Voices that inspire and challenge perspectives.</p>
        </div>
        <a href="/writers" class="btn-outline" id="discover-see-writers">See all writers</a>
      </div>

      <div class="writers-grid reveal-grid">
        {[
          { initials: 'JD', name: 'Jane Doe',       beat: 'Technology',   followers: '12.4K', bio: 'Exploring the future of AI, interface aesthetics, and machine learning at the edge.' },
          { initials: 'MS', name: 'Michael Smith',  beat: 'Culture',      followers: '8.9K',  bio: 'Writing about society, modern art, and the human-computer connection in daily life.' },
          { initials: 'AK', name: 'Alex Kumar',     beat: 'Science',      followers: '15.2K', bio: 'Making complex scientific discoveries and astrophysics accessible to everyone.' },
        ].map(({ initials, name, beat, followers, bio }) => (
          <div class="writer-card feature-card">
            <div class="writer-top">
              <!-- voice-icon-circular spec: surface-strong, full radius -->
              <div class="writer-avatar" aria-hidden="true">{initials}</div>
              <div class="writer-info">
                <h3 class="writer-name">{name}</h3>
                <p class="writer-meta">
                  <span class="badge-pill">{beat}</span>
                  <span class="writer-followers">{followers} followers</span>
                </p>
              </div>
            </div>
            <p class="writer-bio">{bio}</p>
            <a href="/writers" class="btn-outline writer-follow" id={`follow-${name.replace(/\s+/g, '-').toLowerCase()}`}>Follow</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: READING LISTS
       product-card-stack style: hairline rows
  ═══════════════════════════════════════════════ -->
  <section class="discover-section discover-section--soft">
    <div class="page-container">
      <div class="sec-header">
        <h2 class="sec-title">Curated Reading Lists</h2>
        <p class="sec-sub">Handpicked guides to help you navigate what matters.</p>
      </div>

      <div class="lists-grid reveal-grid">
        {[
          { num: '01', title: 'Getting started with fundraising',    desc: 'A founder\'s guide to seed rounds, term sheets, and investor relations.',     tags: ['Beginner', 'Free', '6 articles'] },
          { num: '02', title: 'Building in public',                  desc: 'How transparency and community can become your most powerful growth lever.',   tags: ['Intermediate', 'Free', '8 articles'] },
          { num: '03', title: 'Startup storytelling',                desc: 'Craft narratives that resonate with customers, investors, and recruits.',       tags: ['All levels', 'Free', '10 articles'] },
          { num: '04', title: 'From 0 to 1: founder stories',        desc: 'First-hand accounts from founders who built something from nothing.',          tags: ['Advanced', 'Free', '12 articles'] },
        ].map(({ num, title, desc, tags }) => (
          <a href="#" class="list-card">
            <div class="list-num">{num}</div>
            <div class="list-body">
              <h3 class="list-title">{title}</h3>
              <p class="list-desc">{desc}</p>
              <div class="list-tags">
                {tags.map(tag => (
                  <span class="badge-pill">{tag}</span>
                ))}
              </div>
            </div>
            <span class="list-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 5: CTA BAND
       cta-band spec: canvas bg, display-lg, ink pill
  ═══════════════════════════════════════════════ -->
  <section class="discover-cta-band">
    <div class="atm-orb discover-cta-orb-lavender" aria-hidden="true"></div>
    <div class="page-container discover-cta-inner reveal-single">
      <span class="badge-pill cta-eyebrow">Discover more every week</span>
      <h2 class="cta-title">Never miss what matters.</h2>
      <p class="cta-desc">
        Get the best of Carcblog — curated stories, trending topics, and new writers — delivered to your inbox weekly.
      </p>
      <div class="cta-buttons">
        <a href="/auth/sign-up" class="btn-primary" id="discover-cta-subscribe">Subscribe free</a>
        <a href="/about" class="btn-outline" id="discover-cta-learn">Learn more</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════════════════════
   DISCOVER HERO — canvas, display-mega, atmospheric orbs
════════════════════════════════════════════════════════════ */
.discover-hero {
  background: var(--color-canvas);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
  position: relative;
  overflow: hidden;
}
.discover-orb-mint {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(167, 229, 211, 0.4) 0%, transparent 70%);
  top: -150px; right: -80px;
}
.discover-orb-peach {
  width: 350px; height: 350px;
  background: radial-gradient(circle, rgba(244, 197, 168, 0.35) 0%, transparent 70%);
  bottom: -80px; left: -40px;
}
.discover-hero-text {
  position: relative;
  z-index: 2;
  max-width: 680px;
}
/* display-mega: EB Garamond 300, 64px */
.discover-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display-mega);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-mega);
  letter-spacing: var(--ls-display-mega);
  margin-bottom: var(--space-md);
}
.discover-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  font-weight: var(--fw-regular);
  color: var(--color-body);
  line-height: var(--lh-body);
  letter-spacing: var(--ls-body);
  max-width: 540px;
}

/* ════════════════════════════════════════════════════════════
   SECTIONS
════════════════════════════════════════════════════════════ */
.discover-section {
  background: var(--color-surface-card);
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
}
.discover-section--soft {
  background: var(--color-canvas-soft);
}

/* Section header */
.sec-header {
  text-align: center;
  margin-bottom: var(--space-xl);          /* 32px */
}
.sec-header--split {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  text-align: left;
  flex-wrap: wrap;
  gap: var(--space-md);
}
/* display-lg: EB Garamond 300, 36px */
.sec-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-xs);
}
.sec-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-muted);
  line-height: var(--lh-body-sm);
}

/* ════════════════════════════════════════════════════════════
   TOPICS GRID — feature-card with atmospheric orb accent
   NO saturated colors — only pastel orbs as atmosphere
════════════════════════════════════════════════════════════ */
.topics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}
@media (max-width: 768px) {
  .topics-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .topics-grid { grid-template-columns: 1fr; }
}

.topic-card {
  background: var(--color-surface-card);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  text-decoration: none;
  position: relative;
  overflow: hidden;
  transition: box-shadow var(--duration-200) var(--ease-out), border-color var(--duration-200) var(--ease-out);
}
.topic-card:hover {
  box-shadow: var(--shadow-card-hover);
  border-color: var(--color-hairline-strong);
}

/* Atmospheric orb inside card — pure decoration, NOT the card bg */
.topic-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(35px);
  width: 160px; height: 160px;
  top: -40px; right: -40px;
  opacity: 0.9;
}
.topic-orb--mint     { background: radial-gradient(circle, rgba(167, 229, 211, 0.6) 0%, transparent 70%); }
.topic-orb--peach    { background: radial-gradient(circle, rgba(244, 197, 168, 0.6) 0%, transparent 70%); }
.topic-orb--lavender { background: radial-gradient(circle, rgba(200, 184, 224, 0.6) 0%, transparent 70%); }
.topic-orb--sky      { background: radial-gradient(circle, rgba(168, 200, 232, 0.6) 0%, transparent 70%); }
.topic-orb--rose     { background: radial-gradient(circle, rgba(232, 184, 196, 0.6) 0%, transparent 70%); }

.topic-content {
  position: relative;
  z-index: 1;
}
.topic-badge {
  font-size: 10px;
  margin-bottom: var(--space-xs);
}
/* title-md: Inter 500, 20px */
.topic-name {
  font-family: var(--font-sans);
  font-size: var(--fs-title-md);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  line-height: var(--lh-title-md);
  margin-bottom: 2px;
}
/* caption: Inter 400, 14px, muted */
.topic-count {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
}

/* ════════════════════════════════════════════════════════════
   WRITERS GRID — feature-card spec
════════════════════════════════════════════════════════════ */
.writers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-lg);
}
@media (max-width: 768px) {
  .writers-grid { grid-template-columns: 1fr; }
}

.writer-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.writer-top {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

/* voice-icon-circular: surface-strong, full radius, 40px */
.writer-avatar {
  width: 40px; height: 40px;
  border-radius: var(--radius-full);
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  flex-shrink: 0;
}

.writer-info {
  flex: 1;
  min-width: 0;
}
/* title-sm: Inter 500, 18px */
.writer-name {
  font-family: var(--font-sans);
  font-size: var(--fs-title-sm);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  margin-bottom: var(--space-xs);
}
.writer-meta {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex-wrap: wrap;
  margin-bottom: 0;
}
.writer-followers {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
}
/* body-sm: Inter 400, 15px, body color */
.writer-bio {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-body);
  line-height: var(--lh-body-sm);
  margin-bottom: 0;
  flex: 1;
}
.writer-follow {
  align-self: flex-start;
  font-size: var(--fs-caption);
  height: auto;
  padding: 6px 16px;
}

/* ════════════════════════════════════════════════════════════
   READING LISTS — hairline-row layout
════════════════════════════════════════════════════════════ */
.lists-grid {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--color-surface-card);
}

.list-card {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  padding: var(--space-lg);
  border-bottom: 1px solid var(--color-hairline);
  text-decoration: none;
  transition: background var(--duration-150) var(--ease-out);
}
.list-card:last-child { border-bottom: none; }
.list-card:hover { background: var(--color-canvas-soft); }

/* Sequence number — display-sm EB Garamond 300 */
.list-num {
  font-family: var(--font-serif);
  font-size: var(--fs-display-md);
  font-weight: var(--fw-light);
  color: var(--color-hairline-strong);
  line-height: 1;
  flex-shrink: 0;
  width: 40px;
}

.list-body { flex: 1; }
/* title-md: Inter 500, 20px */
.list-title {
  font-family: var(--font-sans);
  font-size: var(--fs-title-md);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
  line-height: var(--lh-title-md);
  margin-bottom: var(--space-xs);
}
.list-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-body);
  line-height: var(--lh-body-sm);
  margin-bottom: var(--space-sm);
}
.list-tags {
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
}

.list-arrow {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  color: var(--color-muted);
  flex-shrink: 0;
}

/* ════════════════════════════════════════════════════════════
   CTA BAND — cta-band spec
════════════════════════════════════════════════════════════ */
.discover-cta-band {
  background: var(--color-canvas);
  padding: var(--space-section) 0;
  position: relative;
  overflow: hidden;
}
.discover-cta-orb-lavender {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(200, 184, 224, 0.4) 0%, transparent 70%);
  top: -100px; left: 50%;
  transform: translateX(-50%);
}
.discover-cta-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cta-eyebrow { margin-bottom: var(--space-lg); }
/* display-lg: EB Garamond 300, 36px */
.cta-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-md);
}
.cta-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  color: var(--color-body);
  line-height: var(--lh-body);
  max-width: 500px;
  margin-bottom: var(--space-xl);
}
.cta-buttons {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
  justify-content: center;
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .discover-title { font-size: var(--fs-display-md); }
  .discover-hero, .discover-section, .discover-cta-band {
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-xxl);
  }
  .list-num { display: none; }
  .sec-header--split { flex-direction: column; align-items: flex-start; }
}
</style>