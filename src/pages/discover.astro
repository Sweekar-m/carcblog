---
// Discover page
import Layout from '@/components/layout/Layout.astro';
---
<Layout title="Discover — Carcblog" description="Explore trending topics, featured writers, and curated reading lists">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: TRENDING TOPICS
  ═══════════════════════════════════════════════ -->
  <section class="section section--parchment">
    <div class="container">
      <div class="section-header">
        <h1 class="section-title">Trending Topics</h1>
        <p class="section-sub">Explore what the community is reading and writing about.</p>
      </div>

      <div class="topics-grid">
        <a href="/topics#technology" class="topic-card topic-card--blue">
          <div class="topic-icon">#</div>
          <div class="topic-info">
            <h3 class="topic-name">Technology</h3>
            <p class="topic-count">1.2M articles</p>
          </div>
          <div class="topic-arrow">→</div>
        </a>

        <a href="/topics#science" class="topic-card topic-card--purple">
          <div class="topic-icon">#</div>
          <div class="topic-info">
            <h3 class="topic-name">Science</h3>
            <p class="topic-count">850K articles</p>
          </div>
          <div class="topic-arrow">→</div>
        </a>

        <a href="/topics#culture" class="topic-card topic-card--teal">
          <div class="topic-icon">#</div>
          <div class="topic-info">
            <h3 class="topic-name">Culture</h3>
            <p class="topic-count">620K articles</p>
          </div>
          <div class="topic-arrow">→</div>
        </a>

        <a href="/topics#politics" class="topic-card topic-card--indigo">
          <div class="topic-icon">#</div>
          <div class="topic-info">
            <h3 class="topic-name">Politics</h3>
            <p class="topic-count">410K articles</p>
          </div>
          <div class="topic-arrow">→</div>
        </a>

        <a href="/topics#art" class="topic-card topic-card--rose">
          <div class="topic-icon">#</div>
          <div class="topic-info">
            <h3 class="topic-name">Art</h3>
            <p class="topic-count">380K articles</p>
          </div>
          <div class="topic-arrow">→</div>
        </a>

        <a href="/topics#business" class="topic-card topic-card--amber">
          <div class="topic-icon">#</div>
          <div class="topic-info">
            <h3 class="topic-name">Business</h3>
            <p class="topic-count">295K articles</p>
          </div>
          <div class="topic-arrow">→</div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: FEATURED WRITERS
  ═══════════════════════════════════════════════ -->
  <section class="section section--white">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Featured Writers</h2>
        <p class="section-sub">Voices that inspire and challenge perspectives.</p>
      </div>

      <div class="writers-grid">
        <!-- Writer 1 -->
        <div class="writer-card">
          <div class="writer-avatar writer-avatar--blue">JD</div>
          <div class="writer-body">
            <h3 class="writer-name">Jane Doe</h3>
            <p class="writer-meta">Technology writer · 12.4K followers</p>
            <p class="writer-bio">Exploring the future of AI, interface aesthetics, and machine learning at the edge.</p>
          </div>
          <a href="/writers" class="writer-follow-btn">Follow</a>
        </div>

        <!-- Writer 2 -->
        <div class="writer-card">
          <div class="writer-avatar writer-avatar--purple">MS</div>
          <div class="writer-body">
            <h3 class="writer-name">Michael Smith</h3>
            <p class="writer-meta">Culture critic · 8.9K followers</p>
            <p class="writer-bio">Writing about society, modern art, and the human-computer connection in daily life.</p>
          </div>
          <a href="/writers" class="writer-follow-btn">Follow</a>
        </div>

        <!-- Writer 3 -->
        <div class="writer-card">
          <div class="writer-avatar writer-avatar--teal">AK</div>
          <div class="writer-body">
            <h3 class="writer-name">Alex Kumar</h3>
            <p class="writer-meta">Science journalist · 15.2K followers</p>
            <p class="writer-bio">Making complex scientific discoveries and astrophysics accessible to everyone.</p>
          </div>
          <a href="/writers" class="writer-follow-btn">Follow</a>
        </div>
      </div>

      <div class="writers-cta-row">
        <a href="/writers" class="see-all-link">See all writers →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3: READING LISTS
  ═══════════════════════════════════════════════ -->
  <section class="section section--parchment">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Curated Reading Lists</h2>
        <p class="section-sub">Handpicked article guides to get you started.</p>
      </div>

      <div class="lists-grid">
        <!-- List 1 -->
        <a href="#" class="list-card">
          <div class="list-card-inner">
            <div class="list-num">01</div>
            <div class="list-body">
              <h3 class="list-title">Getting started with AI</h3>
              <p class="list-desc">A beginner's guide to artificial intelligence and editorial creation.</p>
              <div class="list-tags">
                <span class="tag">Beginner</span>
                <span class="tag">Free</span>
                <span class="tag">6 articles</span>
              </div>
            </div>
          </div>
          <div class="list-card-arrow">→</div>
        </a>

        <!-- List 2 -->
        <a href="#" class="list-card">
          <div class="list-card-inner">
            <div class="list-num">02</div>
            <div class="list-body">
              <h3 class="list-title">The future of remote work</h3>
              <p class="list-desc">How digital workspace platforms are changing cooperation in the modern era.</p>
              <div class="list-tags">
                <span class="tag">Intermediate</span>
                <span class="tag">Free</span>
                <span class="tag">8 articles</span>
              </div>
            </div>
          </div>
          <div class="list-card-arrow">→</div>
        </a>

        <!-- List 3 -->
        <a href="#" class="list-card">
          <div class="list-card-inner">
            <div class="list-num">03</div>
            <div class="list-body">
              <h3 class="list-title">Creative writing techniques</h3>
              <p class="list-desc">Improve your storytelling skills and narrative pacing for every audience.</p>
              <div class="list-tags">
                <span class="tag">All levels</span>
                <span class="tag">Free</span>
                <span class="tag">10 articles</span>
              </div>
            </div>
          </div>
          <div class="list-card-arrow">→</div>
        </a>

        <!-- List 4 -->
        <a href="#" class="list-card">
          <div class="list-card-inner">
            <div class="list-num">04</div>
            <div class="list-body">
              <h3 class="list-title">Startup stories from the trenches</h3>
              <p class="list-desc">First-hand accounts from founders who built something from nothing.</p>
              <div class="list-tags">
                <span class="tag">Advanced</span>
                <span class="tag">Free</span>
                <span class="tag">12 articles</span>
              </div>
            </div>
          </div>
          <div class="list-card-arrow">→</div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: DARK CTA
  ═══════════════════════════════════════════════ -->
  <section class="section section--dark">
    <div class="container container--narrow">
      <p class="cta-eyebrow">Discover more every week</p>
      <h2 class="cta-title">Never miss what matters.</h2>
      <p class="cta-body">Get the best of Carcblog — curated stories, trending topics, and new writers — delivered to your inbox weekly.</p>
      <div class="cta-buttons">
        <a href="/sign-up" class="btn-primary">Subscribe free</a>
        <a href="/about" class="btn-ghost">Learn more</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════
   BASE CONTAINER — the ONLY centering mechanism
   (never use Tailwind mx-auto on these pages)
════════════════════════════════════════════ */
.container {
  max-width: 1100px;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
  box-sizing: border-box;
}
.container--narrow {
  max-width: 680px;
  text-align: center;
}

/* ════════════════════════════════════════════
   SECTIONS
════════════════════════════════════════════ */
.section {
  width: 100%;
  padding: 80px 0;
  border-bottom: 1px solid #e8e8ed;
}
.section--parchment { background: #f5f5f7; }
.section--white     { background: #ffffff; }
.section--dark      { background: #0a0a0f; border-bottom: none; }

/* Section header */
.section-header {
  text-align: center;
  margin-bottom: 48px;
}
.section-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.1;
  margin-bottom: 10px;
}
.section-sub {
  font-size: 16px;
  color: #6e6e73;
}
.section--dark .section-title { color: #fff; }
.section--dark .section-sub   { color: rgba(255,255,255,0.5); }

/* ════════════════════════════════════════════
   TRENDING TOPICS GRID
════════════════════════════════════════════ */
.topics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
@media (max-width: 768px) {
  .topics-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .topics-grid { grid-template-columns: 1fr; }
}

.topic-card {
  background: #ffffff;
  border: 1px solid #e0e0e8;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
  transition: all 220ms cubic-bezier(0.4,1.3,0.65,1);
  position: relative;
  overflow: hidden;
}
.topic-card::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 220ms ease;
}
.topic-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.1);
  border-color: transparent;
}
.topic-card:hover::before { opacity: 1; }
.topic-card:active { transform: translateY(0); }

/* Colour variants */
.topic-card--blue   { --t-clr: #0066cc; --t-bg: #eff6ff; }
.topic-card--purple { --t-clr: #7c3aed; --t-bg: #f5f3ff; }
.topic-card--teal   { --t-clr: #0d9488; --t-bg: #f0fdfa; }
.topic-card--indigo { --t-clr: #4f46e5; --t-bg: #eef2ff; }
.topic-card--rose   { --t-clr: #e11d48; --t-bg: #fff1f2; }
.topic-card--amber  { --t-clr: #d97706; --t-bg: #fffbeb; }
.topic-card:hover { background: var(--t-bg); }

.topic-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--t-bg, #eff6ff);
  color: var(--t-clr, #0066cc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  flex-shrink: 0;
  transition: background 220ms ease;
}
.topic-card:hover .topic-icon {
  background: var(--t-clr);
  color: #fff;
}

.topic-info { flex: 1; }
.topic-name {
  font-size: 15px;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 2px;
}
.topic-count {
  font-size: 12px;
  color: #86868b;
}

.topic-arrow {
  font-size: 16px;
  color: #c0c0c8;
  transition: all 220ms ease;
}
.topic-card:hover .topic-arrow {
  color: var(--t-clr);
  transform: translateX(4px);
}

/* ════════════════════════════════════════════
   FEATURED WRITERS GRID
════════════════════════════════════════════ */
.writers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}
@media (max-width: 768px) {
  .writers-grid { grid-template-columns: 1fr; }
}

.writer-card {
  background: #fff;
  border: 1px solid #e0e0e8;
  border-radius: 16px;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: all 240ms ease;
}
.writer-card:hover {
  border-color: #c0c0c8;
  box-shadow: 0 8px 24px rgba(0,0,0,0.07);
  transform: translateY(-2px);
}

.writer-avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 15px;
  letter-spacing: 0.02em;
  flex-shrink: 0;
}
.writer-avatar--blue   { background: #eff6ff; color: #0066cc; }
.writer-avatar--purple { background: #f5f3ff; color: #7c3aed; }
.writer-avatar--teal   { background: #f0fdfa; color: #0d9488; }

.writer-body { flex: 1; }
.writer-name {
  font-size: 16px;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 3px;
}
.writer-meta {
  font-size: 12px;
  color: #86868b;
  margin-bottom: 10px;
}
.writer-bio {
  font-size: 13px;
  color: #6e6e73;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.writer-follow-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #0066cc;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  padding: 8px 18px;
  border-radius: 9999px;
  text-decoration: none;
  transition: all 200ms ease;
  width: fit-content;
}
.writer-follow-btn:hover {
  background: #0071e3;
  transform: scale(1.03);
}

.writers-cta-row {
  text-align: center;
}
.see-all-link {
  font-size: 14px;
  font-weight: 700;
  color: #0066cc;
  text-decoration: none;
}
.see-all-link:hover { text-decoration: underline; }

/* ════════════════════════════════════════════
   READING LISTS GRID
════════════════════════════════════════════ */
.lists-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
@media (max-width: 640px) {
  .lists-grid { grid-template-columns: 1fr; }
}

.list-card {
  background: #fff;
  border: 1px solid #e0e0e8;
  border-radius: 16px;
  padding: 28px;
  text-decoration: none;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  transition: all 220ms cubic-bezier(0.4,1.3,0.65,1);
}
.list-card:hover {
  border-color: #0066cc;
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,102,204,0.1);
}

.list-card-inner { display: flex; gap: 16px; flex: 1; }

.list-num {
  font-size: 28px;
  font-weight: 800;
  color: #e8e8ed;
  line-height: 1;
  flex-shrink: 0;
  letter-spacing: -0.03em;
  transition: color 220ms ease;
}
.list-card:hover .list-num { color: #bfd4f0; }

.list-body { flex: 1; }
.list-title {
  font-size: 15px;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 6px;
  line-height: 1.3;
}
.list-desc {
  font-size: 13px;
  color: #6e6e73;
  line-height: 1.5;
  margin-bottom: 14px;
}
.list-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.tag {
  font-size: 11px;
  font-weight: 700;
  color: #0066cc;
  background: #eff6ff;
  padding: 3px 8px;
  border-radius: 9999px;
}

.list-card-arrow {
  font-size: 18px;
  color: #c0c0c8;
  flex-shrink: 0;
  transition: all 220ms ease;
}
.list-card:hover .list-card-arrow {
  color: #0066cc;
  transform: translateX(4px);
}

/* ════════════════════════════════════════════
   DARK CTA SECTION
════════════════════════════════════════════ */
.cta-eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #60a5fa;
  margin-bottom: 16px;
}
.cta-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  margin-bottom: 16px;
}
.cta-body {
  font-size: 16px;
  color: rgba(255,255,255,0.5);
  line-height: 1.65;
  margin-bottom: 36px;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.cta-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}
.btn-primary {
  background: #0066cc;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  padding: 13px 26px;
  border-radius: 9999px;
  text-decoration: none;
  transition: all 220ms ease;
}
.btn-primary:hover {
  background: #0071e3;
  transform: scale(1.03);
  box-shadow: 0 8px 24px rgba(0,102,204,0.4);
}
.btn-ghost {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.75);
  border: 1px solid rgba(255,255,255,0.16);
  font-size: 14px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 9999px;
  text-decoration: none;
  transition: all 220ms ease;
}
.btn-ghost:hover {
  background: rgba(255,255,255,0.14);
  color: #fff;
}
</style>