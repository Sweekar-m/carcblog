---
// About page — ElevenLabs editorial design system
import Layout from '@/components/layout/Layout.astro';
---
<Layout title="About — Carcblog" description="Learn about our mission and values — the premium publishing platform for thoughtful writers">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO
       canvas bg, display-mega, atmospheric orbs, surface-card stats
  ═══════════════════════════════════════════════ -->
  <section class="about-hero">
    <!-- Atmospheric orbs -->
    <div class="atm-orb about-orb-mint"     aria-hidden="true"></div>
    <div class="atm-orb about-orb-peach"    aria-hidden="true"></div>
    <div class="atm-orb about-orb-lavender" aria-hidden="true"></div>

    <div class="page-container about-hero-inner">
      <span class="badge-pill cta-eyebrow">About Carcblog</span>
      <h1 class="hero-title">Where thoughtful writing<br>finds its audience.</h1>
      <p class="hero-desc">
        Carcblog is a publishing platform dedicated to fostering thoughtful discourse and connecting writers with readers who appreciate depth, nuance, and quality.
      </p>

      <!-- Stats board: white surface-card, hairline border, xl radius -->
      <div class="hero-stats-card">
        <div class="hs-item">
          <span class="hs-num">12K+</span>
          <span class="hs-label">Writers</span>
        </div>
        <div class="hs-sep" aria-hidden="true"></div>
        <div class="hs-item">
          <span class="hs-num">84K</span>
          <span class="hs-label">Articles</span>
        </div>
        <div class="hs-sep" aria-hidden="true"></div>
        <div class="hs-item">
          <span class="hs-num">2.4M</span>
          <span class="hs-label">Monthly readers</span>
        </div>
        <div class="hs-sep" aria-hidden="true"></div>
        <div class="hs-item">
          <span class="hs-num">140+</span>
          <span class="hs-label">Countries</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: MISSION
       reading-col layout
  ═══════════════════════════════════════════════ -->
  <section class="about-section">
    <div class="page-container reading-col">
      <span class="badge-pill section-kicker">Our Mission</span>
      <h2 class="section-title">Quality over virality</h2>
      <div class="editorial-body">
        <p>
          We believe that great writing deserves an engaged, receptive audience. Our mission is to create a space where writers can share their ideas, stories, and expertise with readers who genuinely value substance over spectacle.
        </p>
        <p>
          Unlike platforms that prioritize algorithmic virality and quick click metrics, we focus on creating meaningful connections through thoughtful curation, quality-focused discovery, and community-driven recommendations.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3: VALUES GRID
       white feature-card values grid
  ═══════════════════════════════════════════════ -->
  <section class="about-section about-section--soft">
    <div class="page-container">
      <div class="sec-header">
        <span class="badge-pill section-kicker">Our Values</span>
        <h2 class="section-title">The principles that guide us</h2>
        <p class="sec-sub">The principles that guide every decision we make as a publishing platform.</p>
      </div>

      <div class="values-grid">
        {[
          { title: 'Quality over quantity', text: 'We prioritize well-researched, thoughtfully written content that adds genuine value to readers\' lives.' },
          { title: 'Thoughtful discourse',  text: 'We foster constructive conversations that bridge different perspectives and experiences.' },
          { title: 'Growth mindset',        text: 'We support writers in developing their craft and readers in expanding their horizons.' },
          { title: 'Community first',       text: 'Our platform belongs to our community of writers and readers who shape its direction.' },
          { title: 'Creative freedom',     text: 'We empower writers to express their authentic voices without algorithmic constraints.' },
          { title: 'Discoverability',       text: 'We help great content find its audience through thoughtful curation and recommendation.' }
        ].map(({ title, text }) => (
          <div class="value-card feature-card">
            <h3 class="value-title">{title}</h3>
            <p class="value-text">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: TEAM STATEMENT
       pull-quote style
  ═══════════════════════════════════════════════ -->
  <section class="about-section">
    <div class="page-container reading-col">
      <span class="badge-pill section-kicker">Our Story</span>
      <h2 class="section-title">Built by writers, for writers</h2>
      <div class="editorial-body">
        <p>
          Carcblog was born out of frustration — frustration with platforms that reward clicks over craft, follower counts over depth, and engagement metrics over genuine insight.
        </p>
        <p>
          We built Carcblog because we believe the internet deserves a publishing space where the quality of the work is the only metric that matters. Where a writer can spend three weeks on a piece and know it will find the readers who care.
        </p>
      </div>
      <!-- display-sm pull quote -->
      <div class="pull-quote">
        <blockquote>"We built Carcblog because the internet deserves better writing — and writers deserve better tools."</blockquote>
        <cite>— The Carcblog Team</cite>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 5: CTA BAND
       cta-band spec: canvas bg, display-lg, ink pill
  ═══════════════════════════════════════════════ -->
  <section class="about-cta-band">
    <!-- Atmospheric orbs -->
    <div class="atm-orb about-cta-orb-sky"  aria-hidden="true"></div>
    <div class="atm-orb about-cta-orb-rose" aria-hidden="true"></div>

    <div class="page-container about-cta-inner">
      <span class="badge-pill cta-eyebrow">Join the community</span>
      <h2 class="cta-headline">Ready to share your voice?</h2>
      <p class="cta-body">Join our community of writers and readers who believe in the power of thoughtful content.</p>
      <div class="cta-buttons">
        <a href="/auth/sign-up" class="btn-primary" id="about-cta-signup">Join as a Writer</a>
        <a href="/auth/sign-in" class="btn-outline" id="about-cta-signin">Sign in to read</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════════════════════
   ABOUT PAGE — ElevenLabs editorial system
════════════════════════════════════════════════════════════ */
.about-hero {
  background: transparent;
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
  position: relative;
  overflow: hidden;
  text-align: center;
}

.about-orb-mint {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(167, 229, 211, 0.4) 0%, transparent 70%);
  top: -120px; left: 50%;
  transform: translateX(-50%);
  pointer-events: none;
}
.about-orb-peach {
  width: 350px; height: 350px;
  background: radial-gradient(circle, rgba(244, 197, 168, 0.35) 0%, transparent 70%);
  bottom: -60px; right: -40px;
  pointer-events: none;
}
.about-orb-lavender {
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(200, 184, 224, 0.3) 0%, transparent 70%);
  bottom: 40px; left: -30px;
  pointer-events: none;
}

.about-hero-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-eyebrow {
  margin-bottom: var(--space-lg);
}

/* hero-display: DM Sans 600, 56px/80px */
.hero-title {
  font-family: var(--font-sans);
  font-size: clamp(var(--fs-heading-lg), 5vw, var(--fs-hero-display));
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  line-height: var(--lh-hero-display);
  letter-spacing: -0.025em;
  margin-bottom: var(--space-md);
}

.hero-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-subtitle);
  color: var(--color-steel);
  line-height: 1.5;
  max-width: 560px;
  margin: 0 auto var(--space-xl);
}

/* Stats board — white surface-card, hairline, xl radius, shadow */
.hero-stats-card {
  display: inline-flex;
  align-items: center;
  gap: var(--space-lg);
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  box-shadow: var(--shadow-card);
  border-radius: var(--radius-xl);
  padding: var(--space-md) var(--space-xl);
}
@media (max-width: 640px) {
  .hero-stats-card {
    flex-direction: column;
    width: 100%;
    gap: var(--space-sm);
  }
  .hs-sep { display: none; }
}

.hs-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.hs-num {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-md);
  font-weight: var(--fw-semibold);
  color: var(--color-ink-strong);
  line-height: 1;
}
.hs-label {
  font-family: var(--font-sans);
  font-size: var(--fs-caption-upper);
  font-weight: var(--fw-semibold);
  color: var(--color-muted);
  letter-spacing: var(--ls-caption-upper);
  text-transform: uppercase;
}
.hs-sep {
  width: 1px;
  height: 36px;
  background: var(--color-hairline);
}

/* ── Sections ── */
.about-section {
  background: transparent;
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
}
.about-section--soft {
  background: transparent;
}

.sec-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}
.section-kicker {
  display: inline-flex;
  margin-bottom: var(--space-md);
}

/* display-lg: EB Garamond 300, 36px */
.section-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-md);
}
.sec-sub {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-muted);
}

/* ── Editorial body ── */
.editorial-body p {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  line-height: var(--lh-body);
  color: var(--color-body);
  margin-bottom: var(--space-md);
}

/* display-sm pull quote style: italic EB Garamond 300, hairline left */
.pull-quote {
  border-left: 2px solid var(--color-hairline-strong);
  padding-left: var(--space-lg);
  margin: var(--space-xl) 0 0;
}
.pull-quote blockquote {
  font-family: var(--font-serif);
  font-size: var(--fs-display-sm);
  font-weight: var(--fw-light);
  font-style: italic;
  color: var(--color-body-strong);
  line-height: var(--lh-display-sm);
  margin: 0 0 var(--space-xs);
}
.pull-quote cite {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: var(--color-muted);
  font-style: normal;
}

/* ── Values Grid — white cards, no accent strips ── */
.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}
@media (max-width: 768px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .values-grid { grid-template-columns: 1fr; } }

.value-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

/* voice-icon-circular styling for icons */
.value-icon-box {
  font-size: 20px;
  width: 44px; height: 44px;
  background: var(--color-surface-strong);
  border: 1px solid var(--color-hairline-soft);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* title-sm: Inter 500 */
.value-title {
  font-family: var(--font-sans);
  font-size: var(--fs-title-sm);
  font-weight: var(--fw-medium);
  color: var(--color-ink);
}

.value-text {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-body);
  line-height: var(--lh-body-sm);
  margin: 0;
}

/* ── CTA Band ── */
.about-cta-band {
  background: transparent;
  padding: var(--space-section) 0;
  border-bottom: 1px solid var(--color-hairline);
  position: relative;
  overflow: hidden;
}
.about-cta-orb-sky {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(168, 200, 232, 0.4) 0%, transparent 70%);
  top: -100px; left: 50%;
  transform: translateX(-50%);
}
.about-cta-orb-rose {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(232, 184, 196, 0.35) 0%, transparent 70%);
  bottom: -60px; right: 10%;
  pointer-events: none;
}
.about-cta-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cta-title {
  font-family: var(--font-serif);
  font-size: var(--fs-display-lg);
  font-weight: var(--fw-light);
  color: var(--color-ink);
  line-height: var(--lh-display-lg);
  letter-spacing: var(--ls-display-lg);
  margin-bottom: var(--space-md);
}
.cta-body {
  font-family: var(--font-sans);
  font-size: var(--fs-body-md);
  color: var(--color-body);
  line-height: var(--lh-body);
  max-width: 500px;
  margin: 0 auto var(--space-xl);
}
.cta-buttons {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
  justify-content: center;
}

/* ── Responsive ── */
@media (max-width: 640px) {
  .about-hero, .about-section, .about-cta-band {
    padding-top: var(--space-xxl);
    padding-bottom: var(--space-xxl);
  }
  .hero-title { font-size: var(--fs-display-md); }
  .cta-title { font-size: var(--fs-display-sm); }
}
</style>