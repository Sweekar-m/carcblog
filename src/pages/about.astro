---
// About page
import Layout from '@/components/layout/Layout.astro';
---
<Layout title="About — Carcblog" description="Learn about our mission and values — the premium publishing platform for thoughtful writers">

  <!-- ═══════════════════════════════════════════════
       SECTION 1: HERO
  ═══════════════════════════════════════════════ -->
  <section class="section section--dark section--hero">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="container container--narrow" style="position:relative;z-index:1;">
      <p class="eyebrow">About Carcblog</p>
      <h1 class="hero-title">Where Thoughtful Writing<br>Finds Its Audience</h1>
      <p class="hero-desc">
        Carcblog is a publishing platform dedicated to fostering thoughtful discourse and connecting writers with readers who appreciate depth, nuance, and quality.
      </p>
      <div class="hero-stats">
        <div class="hs-item"><span class="hs-num">12K+</span><span class="hs-label">Writers</span></div>
        <div class="hs-sep"></div>
        <div class="hs-item"><span class="hs-num">84K</span><span class="hs-label">Articles</span></div>
        <div class="hs-sep"></div>
        <div class="hs-item"><span class="hs-num">2.4M</span><span class="hs-label">Monthly readers</span></div>
        <div class="hs-sep"></div>
        <div class="hs-item"><span class="hs-num">140+</span><span class="hs-label">Countries</span></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2: MISSION
  ═══════════════════════════════════════════════ -->
  <section class="section section--white">
    <div class="container container--editorial">
      <p class="section-kicker">Our Mission</p>
      <h2 class="section-title">Quality over virality</h2>
      <div class="editorial-body">
        <p>
          We believe that great writing deserves an engaged, receptive audience. Our mission is to create a space where writers can share their ideas, stories, and expertise with readers who genuinely value substance over spectacle.
        </p>
        <p>
          Unlike platforms that prioritize algorithmic virality and quick click metrics, we focus on creating meaningful connections through thoughtful curation, quality-focused discovery, and community-driven recommendations.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3: VALUES GRID
  ═══════════════════════════════════════════════ -->
  <section class="section section--parchment">
    <div class="container">
      <div class="section-header">
        <p class="section-kicker">Our Values</p>
        <h2 class="section-title">The principles that guide us</h2>
        <p class="section-sub">The principles that guide every decision we make as a publishing platform.</p>
      </div>

      <div class="values-grid">
        <div class="value-card vc--blue">
          <div class="value-icon">📖</div>
          <h3 class="value-title">Quality over quantity</h3>
          <p class="value-text">We prioritize well-researched, thoughtfully written content that adds genuine value to readers' lives.</p>
        </div>

        <div class="value-card vc--purple">
          <div class="value-icon">💬</div>
          <h3 class="value-title">Thoughtful discourse</h3>
          <p class="value-text">We foster constructive conversations that bridge different perspectives and experiences.</p>
        </div>

        <div class="value-card vc--teal">
          <div class="value-icon">🌱</div>
          <h3 class="value-title">Growth mindset</h3>
          <p class="value-text">We support writers in developing their craft and readers in expanding their horizons.</p>
        </div>

        <div class="value-card vc--rose">
          <div class="value-icon">🤝</div>
          <h3 class="value-title">Community first</h3>
          <p class="value-text">Our platform belongs to our community of writers and readers who shape its direction.</p>
        </div>

        <div class="value-card vc--amber">
          <div class="value-icon">✨</div>
          <h3 class="value-title">Creative freedom</h3>
          <p class="value-text">We empower writers to express their authentic voices without algorithmic constraints.</p>
        </div>

        <div class="value-card vc--indigo">
          <div class="value-icon">🔍</div>
          <h3 class="value-title">Discoverability</h3>
          <p class="value-text">We help great content find its audience through thoughtful curation and recommendation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4: TEAM STATEMENT
  ═══════════════════════════════════════════════ -->
  <section class="section section--white">
    <div class="container container--editorial">
      <p class="section-kicker">Our Story</p>
      <h2 class="section-title">Built by writers, for writers</h2>
      <div class="editorial-body">
        <p>
          Carcblog was born out of frustration — frustration with platforms that reward clicks over craft, follower counts over depth, and engagement metrics over genuine insight.
        </p>
        <p>
          We built Carcblog because we believe the internet deserves a publishing space where the quality of the work is the only metric that matters. Where a writer can spend three weeks on a piece and know it will find the readers who care.
        </p>
      </div>
      <div class="pull-quote">
        <blockquote>"We built Carcblog because the internet deserves better writing — and writers deserve better tools."</blockquote>
        <cite>— The Carcblog Team</cite>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 5: DARK CTA
  ═══════════════════════════════════════════════ -->
  <section class="section section--dark section--cta">
    <div class="blob b3"></div>
    <div class="container container--narrow" style="position:relative;z-index:1;text-align:center;">
      <p class="eyebrow">Join the community</p>
      <h2 class="cta-title">Ready to share your voice?</h2>
      <p class="cta-desc">Join our community of writers and readers who believe in the power of thoughtful content.</p>
      <div class="cta-btns">
        <a href="/sign-up" class="btn-primary">Join as a Writer</a>
        <a href="/sign-in" class="btn-ghost">Sign in to read</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ════════════════════════════════════════════
   CONTAINERS
════════════════════════════════════════════ */
.container {
  max-width: 1100px;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
  box-sizing: border-box;
}
.container--narrow { max-width: 720px; text-align: center; }
.container--editorial { max-width: 720px; }

/* ════════════════════════════════════════════
   SECTIONS
════════════════════════════════════════════ */
.section {
  width: 100%;
  padding: 96px 0;
  border-bottom: 1px solid #e8e8ed;
  position: relative;
  overflow: hidden;
}
.section--white     { background: #fff; }
.section--parchment { background: #f5f5f7; }
.section--dark      { background: #0a0a0f; border-bottom: none; }
.section--hero      { padding: 120px 0 100px; }
.section--cta       { padding: 100px 0; }

/* ambient blobs */
.blob { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
.b1 { width: 600px; height: 600px; background: rgba(0,102,204,0.25); top: -200px; left: 50%; transform: translateX(-50%); }
.b2 { width: 400px; height: 400px; background: rgba(124,58,237,0.18); bottom: -100px; right: 10%; }
.b3 { width: 500px; height: 500px; background: rgba(0,102,204,0.2); bottom: -150px; left: 50%; transform: translateX(-50%); }

/* section kicker / eyebrow */
.eyebrow, .section-kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #60a5fa;
  margin-bottom: 16px;
}
.section--white .section-kicker,
.section--parchment .section-kicker { color: #0066cc; }

/* ════════════════════════════════════════════
   HERO
════════════════════════════════════════════ */
.hero-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2.4rem, 5.5vw, 4rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 20px;
}
.hero-desc {
  font-size: 17px;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
  max-width: 560px;
  margin: 0 auto 48px;
}
.hero-stats {
  display: inline-flex;
  align-items: center;
  gap: 28px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 20px 32px;
  backdrop-filter: blur(10px);
}
.hs-item { display: flex; flex-direction: column; align-items: center; gap: 3px; }
.hs-num { font-size: 1.5rem; font-weight: 800; color: #fff; line-height: 1; }
.hs-label { font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 600; }
.hs-sep { width: 1px; height: 36px; background: rgba(255,255,255,0.1); }

/* ════════════════════════════════════════════
   EDITORIAL BODY
════════════════════════════════════════════ */
.section-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.15;
  margin-bottom: 24px;
}
.section-sub { font-size: 15px; color: #6e6e73; }
.section-header { text-align: center; margin-bottom: 56px; }

.editorial-body p {
  font-size: 17px;
  line-height: 1.7;
  color: #3d3d3f;
  margin-bottom: 20px;
}

.pull-quote {
  border-left: 3px solid #0066cc;
  padding: 20px 28px;
  margin: 40px 0 0;
  background: #f5f5f7;
  border-radius: 0 12px 12px 0;
}
.pull-quote blockquote {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 1.3rem;
  font-style: italic;
  color: #1d1d1f;
  line-height: 1.55;
  margin: 0 0 10px;
}
.pull-quote cite { font-size: 13px; color: #86868b; font-style: normal; font-weight: 600; }

/* ════════════════════════════════════════════
   VALUES GRID
════════════════════════════════════════════ */
.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
@media (max-width: 768px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .values-grid { grid-template-columns: 1fr; } }

.value-card {
  background: #fff;
  border: 1px solid #e0e0e8;
  border-radius: 16px;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: all 240ms cubic-bezier(0.4,1.3,0.65,1);
}
.value-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.08);
}

/* top accent strip per color */
.vc--blue   { border-top: 3px solid #3b82f6; }
.vc--purple { border-top: 3px solid #8b5cf6; }
.vc--teal   { border-top: 3px solid #14b8a6; }
.vc--rose   { border-top: 3px solid #f43f5e; }
.vc--amber  { border-top: 3px solid #f59e0b; }
.vc--indigo { border-top: 3px solid #6366f1; }

.value-icon { font-size: 28px; }
.value-title { font-size: 15px; font-weight: 700; color: #1d1d1f; }
.value-text  { font-size: 13px; color: #6e6e73; line-height: 1.55; }

/* ════════════════════════════════════════════
   DARK CTA
════════════════════════════════════════════ */
.cta-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 16px;
}
.cta-desc {
  font-size: 16px;
  color: rgba(255,255,255,0.45);
  line-height: 1.7;
  max-width: 480px;
  margin: 0 auto 36px;
}
.cta-btns {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}
.btn-primary {
  background: #0066cc;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  padding: 13px 28px;
  border-radius: 9999px;
  text-decoration: none;
  transition: all 220ms ease;
}
.btn-primary:hover {
  background: #0071e3;
  transform: scale(1.03);
  box-shadow: 0 8px 24px rgba(0,102,204,0.4);
}
.btn-ghost {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.75);
  border: 1.5px solid rgba(255,255,255,0.2);
  font-size: 14px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 9999px;
  text-decoration: none;
  transition: all 220ms ease;
}
.btn-ghost:hover {
  background: rgba(255,255,255,0.14);
  border-color: rgba(255,255,255,0.35);
  color: #fff;
}
</style>