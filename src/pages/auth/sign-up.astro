---
// Standard Clerk Sign-Up Page
import Layout from '@/components/layout/Layout.astro';
import { SignUp } from '@clerk/astro/components';
---
<Layout title="Sign Up — Carcblog" description="Create a new Carcblog account">
  <div class="auth-container">
    <SignUp forceRedirectUrl="/onboarding" fallbackRedirectUrl="/onboarding" />
  </div>
</Layout>

<style>
  .auth-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 120px);
    padding: 24px;
    background-color: var(--color-background);
  }
</style>