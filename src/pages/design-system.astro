---
// Design System Showcase
import Layout from '@/components/layout/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Input from '@/components/ui/Input.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Avatar from '@/components/ui/Avatar.astro';
---
<Layout title="Design System Showcase - Carcblog" description="Explore the Carcblog design system">
  <div class="min-h-[calc(100vh-var(--header-height))] flex-1 p-6">
    <div class="space-y-8">
      <header class="text-center">
        <h1 class="font-serif text-5xl font-bold text-foreground mb-4">Carcblog Design System</h1>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          A premium design system inspired by Linear, Vercel, Arc Browser, Apple, Stripe, Notion, Framer, and Medium
        </p>
      </header>

      <section class="space-y-6">
        <h2 class="font-serif text-3xl font-bold text-foreground">Color System</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="flex items-center space-x-3 p-4 bg-background-alt rounded-lg border border-border">
            <div class="h-8 w-8 rounded-md bg-primary"></div>
            <div>
              <p class="font-medium text-foreground">Primary</p>
              <p class="text-xs text-foreground-muted">#0F172A</p>
            </div>
          </div>
          <div class="flex items-center space-x-3 p-4 bg-background-alt rounded-lg border border-border">
            <div class="h-8 w-8 rounded-md bg-accent"></div>
            <div>
              <p class="font-medium text-foreground">Accent</p>
              <p class="text-xs text-foreground-muted">#0EA5E9</p>
            </div>
          </div>
          <div class="flex items-center space-x-3 p-4 bg-background-alt rounded-lg border border-border">
            <div class="h-8 w-8 rounded-md bg-accent-2"></div>
            <div>
              <p class="font-medium text-foreground">Accent 2</p>
              <p class="text-xs text-foreground-muted">#7C3AED</p>
            </div>
          </div>
          <div class="flex items-center space-x-3 p-4 bg-background-alt rounded-lg border border-border">
            <div class="h-8 w-8 rounded-md bg-background"></div>
            <div>
              <p class="font-medium text-foreground">Background</p>
              <p class="text-xs text-foreground-muted">#FFFFFF</p>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-6">
        <h2 class="font-serif text-3xl font-bold text-foreground">Typography</h2>
        <div class="space-y-4">
          <p class="text-xs font-light text-foreground">Light 300</p>
          <p class="text-xs font-normal text-foreground">Regular 400</p>
          <p class="text-xs font-medium text-foreground">Medium 500</p>
          <p class="text-xs font-semibold text-foreground">Semi-bold 600</p>
          <p class="text-xs font-bold text-foreground">Bold 700</p>
          <p class="text-xs font-black text-foreground">Black 800</p>
        </div>

        <div class="space-y-4">
          <p class="text-xs tracking-tighter">Tight tracking</p>
          <p class="text-xs tracking-normal">Normal tracking</p>
          <p class="text-xs tracking-wide">Wide tracking</p>
        </div>

        <div class="space-y-4">
          <p class="text-xs leading-none">None leading</p>
          <p class="text-xs leading-tight">Tight leading</p>
          <p class="text-xs leading-snug">Snug leading</p>
          <p class="text-xs leading-normal">Normal leading</p>
          <p class="text-xs leading-relaxed">Relaxed leading</p>
          <p class="text-xs leading-loose">Loose leading</p>
        </div>
      </section>

      <section class="space-y-6">
        <h2 class="font-serif text-3xl font-bold text-foreground">Spacing (8px grid)</h2>
        <div class="grid gap-2 p-4 bg-background-alt rounded-lg border border-hidden">
          <div class="text-xs text-center bg-primary/10 rounded-lg p-2">0</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-0-5">0.5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-1">1</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-1-5">1.5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-2">2</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-2-5">2.5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-3">3</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-3-5">3.5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-4">4</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-4-5">4.5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-5">5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-5-5">5.5</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-6">6</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-7">7</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-8">8</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-9">9</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-10">10</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-11">11</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-12">12</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-14">14</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-16">16</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-20">20</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-24">24</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-28">28</div>
          <div class="text-xs text-center bg-primary/10 rounded-lg p-32">32</div>
        </div>
      </section>

      <section class="space-y-6">
        <h2 class="font-serif text-3xl font-bold text-foreground">Components</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="col-span-2">
            <h3 class="font-semibold text-lg text-foreground mb-3">Buttons</h3>
            <div class="flex flex-wrap gap-3">
              <Button variant="primary" size="md">Primary</Button>
              <Button variant="secondary" size="md">Secondary</Button>
              <Button variant="outline" size="md">Outline</Button>
              <Button variant="ghost" size="md">Ghost</Button>
              <Button variant="danger" size="md">Danger</Button>
              <Button variant="link" size="md">Link</Button>
            </div>
          </div>

          <div class="col-span-2">
            <h3 class="font-semibold text-lg text-foreground mb-3">Inputs</h3>
            <div class="space-y-4">
              <Input label="Email address" placeholder="you@example.com" type="email" />
              <Input label="Password" placeholder="••••••••" type="password" />
              <Input label="With error" placeholder="Enter value" type="text" error="This field is required" />
              <Input label="With helper text" placeholder="Enter value" type="text" helperText="We'll never share your email with anyone else." />
            </div>
          </div>

          <div>
            <h3 class="font-semibold text-lg text-foreground mb-3">Badges</h3>
            <div class="flex flex-wrap gap-2">
              <Badge variant="neutral">Neutral</Badge>
              <Badge variant="primary">Primary</Badge>
              <Badge variant="success">Success</Badge>
              <Badge variant="warning">Warning</Badge>
              <Badge variant="error">Error</Badge>
              <Badge variant="info">Info</Badge>
              <Badge variant="accent">Accent</Badge>
              <Badge variant="accent-2">Accent 2</Badge>
            </div>
          </div>

          <div>
            <h3 class="font-semibold text-lg text-foreground mb-3">Avatars</h3>
            <div class="flex space-x-4">
              <Avatar name="Alex Johnson" size="xs" />
              <Avatar name="Alex Johnson" size="sm" />
              <Avatar name="Alex Johnson" size="md" />
              <Avatar name="Alex Johnson" size="lg" />
              <Avatar name="Alex Johnson" size="xl" />
              <Avatar name="A" size="md" />
            </div>
          </div>

          <div>
            <h3 class="font-semibold text-lg text-foreground mb-3">Cards</h3>
            <div class="space-y-4">
              <Card variant="flat" class="p-6">
                <h4 class="font-semibold text-lg text-foreground mb-2">Flat Card</h4>
                <p class="text-sm text-foreground-muted">Base background with subtle border</p>
              </Card>
              <Card variant="elevated" class="p-6">
                <h4 class="font-semibold text-lg text-foreground mb-2">Elevated Card</h4>
                <p class="text-sm text-foreground-muted">Raised with shadow for depth</p>
              </Card>
              <Card variant="glass" class="p-6">
                <h4 class="font-semibold text-lg text-foreground mb-2">Glass Card</h4>
                <p class="text-sm text-foreground-muted">Frosted glass effect with backdrop blur</p>
              </Card>
              <Card variant="interactive" class="p-6 cursor-pointer hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200">
                <h4 class="font-semibold text-lg text-foreground mb-2">Interactive Card</h4>
                <p class="text-sm text-foreground-muted">Lifts on hover with shadow</p>
              </Card>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-6">
        <h2 class="font-serif text-3xl font-bold text-foreground">Usage Example</h2>
        <Card variant="elevated" class="p-6">
          <h3 class="font-serif text-2xl font-bold text-foreground mb-4">Article Preview Card</h3>
          <div class="space-y-4">
            <div class="flex items-start space-x-4">
              <Avatar name="Jane Doe" size="lg" />
              <div class="flex-1 space-y-2">
                <h4 class="font-semibold text-lg text-foreground">The Future of AI-Assisted Writing</h4>
                <p class="text-sm text-foreground-muted">Published • Apr 15, 2024 • 5 min read</p>
                <p class="text-base text-foreground-muted leading-relaxed">
                  Explore how artificial intelligence is transforming the writing process, from ideation to publication, while preserving the unique voice and creativity of human authors.
                </p>
                <div class="flex items-center space-x-4 mt-4">
                  <Button variant="outline" size="sm">Read article</Button>
                  <Button variant="secondary" size="sm">Save for later</Button>
                </div>
              </div>
            </div>
          </div>
        </Card>
      </section>
    </div>
  </div>
</Layout>