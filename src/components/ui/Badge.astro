---
interface Props {
  variant?: 'neutral' | 'primary' | 'success' | 'warning' | 'error' | 'info' | 'accent' | 'accent-2';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'neutral',
  class: className = '',
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium tracking-wide uppercase leading-none select-none';

const variants = {
  neutral: 'bg-background-muted text-foreground-muted border border-border/50',
  primary: 'bg-primary text-primary-foreground',
  success: 'bg-success/10 text-success border border-success/20',
  warning: 'bg-warning/10 text-warning border border-warning/20',
  error: 'bg-error/10 text-error border border-error/20',
  info: 'bg-info/10 text-info border border-info/20',
  accent: 'bg-accent/10 text-accent border border-accent/20',
  'accent-2': 'bg-accent-2/10 text-accent-2 border border-accent-2/20'
};

---
<span class:list={[baseStyles, variants[variant], className]} {...rest}>
  <slot />
</span>