---
interface Props {
  variant?: 'neutral' | 'primary' | 'success' | 'new' | 'beta' | 'code' | 'coral' | 'magenta' | 'blue' | 'purple' | 'emerald' | 'amber';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'neutral',
  class: className = '',
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-sans font-semibold tracking-wide select-none leading-tight';

const variants = {
  neutral: 'bg-surface-strong text-slate border border-hairline',
  primary: 'bg-primary text-on-primary',
  success: 'bg-emerald-50 text-semantic-success border border-emerald-200/60',
  new: 'bg-brand-coral text-white font-bold',
  beta: 'bg-brand-blue-200 text-brand-blue-deep font-bold',
  code: 'bg-brand-blue-200 text-brand-blue-deep font-mono text-[11px] rounded-sm px-1.5 py-0.5',
  coral: 'bg-orange-50 text-brand-coral border border-orange-200/60',
  magenta: 'bg-fuchsia-50 text-brand-magenta border border-fuchsia-200/60',
  blue: 'bg-sky-50 text-brand-blue border border-sky-200/60',
  purple: 'bg-violet-50 text-brand-purple border border-violet-200/60',
  emerald: 'bg-emerald-50 text-brand-emerald border border-emerald-200/60',
  amber: 'bg-amber-50 text-brand-amber border border-amber-200/60',
};

---
<span class:list={[baseStyles, variants[variant], className]} {...rest}>
  <slot />
</span>