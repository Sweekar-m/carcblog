---
// ArticleCard — feature-card spec from design.md
// Background: surface-card (#fff), hairline border, xl radius (16px), 24px padding
// Single shadow tier on hover (0 4px 16px rgba(0,0,0,0.04))
interface Props {
  title: string;
  excerpt: string | null;
  publishedAt: string;
  authorName: string;
  authorImage: string | null;
  slug: string;
  coverImage: string | null;
}

const { title, excerpt, publishedAt, authorName, authorImage, slug, coverImage } = Astro.props;

const authorInitial = authorName ? authorName.charAt(0).toUpperCase() : '?';
// Resolve slug to string
const slugStr = typeof slug === 'string' ? slug : (slug as any)?.current ?? '';
---

<article class="article-card">
  <a href={`/article/${slugStr}`} class="card-link" aria-label={`Read: ${title}`}>

    <!-- Cover image — editorial aspect ratio 16:10 -->
    <div class="card-img-box">
      {coverImage ? (
        <img
          src={coverImage}
          alt={title}
          width="400"
          height="250"
          decoding="async"
          class="card-img"
          loading="lazy"
          style="aspect-ratio: 16/10; object-fit: cover;"
          referrerpolicy="no-referrer"
          onerror="this.style.display='none';"
        />
      ) : (
        /* Atmospheric orb placeholder — never dark gradient */
        <div class="card-placeholder">
          <div class="placeholder-orb placeholder-orb-a" aria-hidden="true"></div>
          <div class="placeholder-orb placeholder-orb-b" aria-hidden="true"></div>
        </div>
      )}
    </div>

    <!-- Card body — 24px padding per feature-card spec -->
    <div class="card-body">
      <!-- caption-uppercase: date -->
      <time class="card-date" datetime={publishedAt}>
        {new Date(publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </time>

      <!-- display-sm: EB Garamond 300, 24px — card title -->
      <h3 class="card-title">{title}</h3>

      {excerpt && (
        <p class="card-excerpt">{excerpt}</p>
      )}

      <!-- Footer: author + read label -->
      <div class="card-footer">
        <div class="author-row">
          <!-- voice-icon-circular spec: surface-strong bg, full radius, 32px -->
          {authorImage ? (
            <img
              src={authorImage}
              alt={authorName}
              class="author-avatar"
              referrerpolicy="no-referrer"
              onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
            />
          ) : null}
          <div class="author-avatar-fallback" style={authorImage ? 'display:none' : 'display:flex'}>
            {authorInitial}
          </div>
          <span class="author-name">{authorName}</span>
        </div>
        <span class="card-read-label">Read</span>
      </div>
    </div>

  </a>
</article>

<style>
  /* ── feature-card spec ── */
  .article-card {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    border-radius: var(--radius-xl);              /* 16px */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-200) var(--ease-out), box-shadow var(--duration-200) var(--ease-out), border-color var(--duration-200) var(--ease-out);
  }
  /* Single soft shadow tier and lift */
  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);         /* 0 4px 16px rgba(0,0,0,0.04) */
    border-color: var(--color-hairline-strong);
  }

  .card-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
    flex-grow: 1;
  }

  /* ── Cover image — canvas-soft placeholder, atmospheric orb fill ── */
  .card-img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-canvas-soft);
    flex-shrink: 0;
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 350ms var(--ease-out);
  }
  .article-card:hover .card-img { transform: scale(1.02); }

  /* Placeholder — atmospheric orbs, canvas-soft bg, NEVER dark gradient */
  .card-placeholder {
    position: absolute;
    inset: 0;
    background: var(--color-canvas);
    overflow: hidden;
  }
  .placeholder-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(40px);
  }
  .placeholder-orb-a {
    width: 180px; height: 180px;
    background: radial-gradient(circle, rgba(167, 229, 211, 0.5) 0%, transparent 70%);
    top: -40px; left: -20px;
  }
  .placeholder-orb-b {
    width: 160px; height: 160px;
    background: radial-gradient(circle, rgba(244, 197, 168, 0.4) 0%, transparent 70%);
    bottom: -30px; right: -20px;
  }

  /* ── Card body — 24px padding ── */
  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--space-lg);                     /* 24px */
  }

  /* caption-uppercase: date */
  .card-date {
    font-family: var(--font-sans);
    font-size: var(--fs-caption-upper);           /* 12px */
    font-weight: var(--fw-semibold);              /* 600 */
    letter-spacing: var(--ls-caption-upper);      /* 0.08em ≈ 0.96px */
    text-transform: uppercase;
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-sm);               /* Increased from 8px to 12px */
  }

  /* card-title: DM Sans 600, 20px, lh 1.4 */
  .card-title {
    font-family: var(--font-sans);
    font-size: var(--fs-card-title);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    line-height: var(--lh-card-title);
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* body-sm: Inter 400, 15px, body color */
  .card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);                 /* 15px */
    font-weight: var(--fw-regular);
    color: var(--color-body);
    line-height: var(--lh-body-sm);               /* 1.47 */
    letter-spacing: var(--ls-body-sm);
    margin-bottom: var(--space-lg);               /* Increased from 20px to 24px */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Card footer ── */
  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);                 /* 12px */
    border-top: 1px solid var(--color-hairline-soft);
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);                         /* 8px */
  }

  /* voice-icon-circular spec: surface-strong, full radius, 32px */
  .author-avatar {
    width: 28px; height: 28px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 1px solid var(--color-hairline);
    display: block;
    flex-shrink: 0;
  }
  .author-avatar-fallback {
    width: 28px; height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-surface-strong);      /* #f0efed */
    border: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* caption: author name */
  .author-name {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);                 /* 14px */
    font-weight: var(--fw-medium);
    color: var(--color-body-strong);
  }

  /* Read label — Inter 500, muted, no blue */
  .card-read-label {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--color-muted);
    transition: color var(--duration-150) var(--ease-out);
  }
  .article-card:hover .card-read-label {
    color: var(--color-ink);
  }
</style>