---
interface Props {
  text: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  class?: string;
  [key: string]: any;
}

const {
  text,
  position = 'top',
  class: className = '',
  ...rest
} = Astro.props;

const positions = {
  top: 'bottom-full left-1/2 -translate-x-1/2 mb-2',
  bottom: 'top-full left-1/2 -translate-x-1/2 mt-2',
  left: 'right-full top-1/2 -translate-y-1/2 mr-2',
  right: 'left-full top-1/2 -translate-y-1/2 ml-2'
};
---

<div class:list={['relative inline-block group', className]} {...rest}>
  <slot />
  <div class:list={[
    'absolute z-50 pointer-events-none opacity-0 scale-95 group-hover:opacity-100 group-hover:scale-100 transition-all duration-150 ease-spring px-2 py-1 text-xs font-medium text-white bg-slate-900 dark:bg-slate-100 dark:text-slate-900 rounded shadow-premium whitespace-nowrap',
    positions[position]
  ]}>
    {text}
  </div>
</div>
