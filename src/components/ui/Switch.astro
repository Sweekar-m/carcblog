---
interface Props {
  label?: string;
  helperText?: string;
  class?: string;
  id?: string;
  checked?: boolean;
  [key: string]: any;
}

const {
  label,
  helperText,
  class: className = '',
  id = `switch-${Math.random().toString(36).substr(2, 9)}`,
  checked = false,
  ...rest
} = Astro.props;
---

<label for={id} class="inline-flex items-start justify-between gap-4 cursor-pointer select-none group w-full">
  {label && (
    <div class="flex flex-col">
      <span class="text-sm font-medium text-foreground leading-snug group-hover:text-foreground/90">{label}</span>
      {helperText && <span class="text-xs text-foreground-muted leading-tight mt-0.5">{helperText}</span>}
    </div>
  )}
  <div class="relative flex items-center shrink-0">
    <input
      type="checkbox"
      id={id}
      checked={checked}
      class:list={[
        'peer sr-only',
        className
      ]}
      {...rest}
    />
    <div class="h-5 w-9 rounded-full bg-background-muted border border-border transition-colors duration-200 peer-checked:bg-primary peer-checked:border-primary peer-focus:ring-2 peer-focus:ring-accent/20 peer-disabled:opacity-50"></div>
    <div class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white shadow-premium-sm transition-transform duration-200 ease-spring peer-checked:translate-x-4 pointer-events-none"></div>
  </div>
</label>
