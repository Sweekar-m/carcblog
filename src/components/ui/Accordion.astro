---
interface Props {
  items: { title: string; content: string; id: string }[];
  class?: string;
  [key: string]: any;
}

const {
  items,
  class: className = '',
  ...rest
} = Astro.props;

const id = `accordion-${Math.random().toString(36).substr(2, 9)}`;
---

<div id={id} class:list={['flex flex-col border border-border/60 rounded-lg divide-y divide-border/40 overflow-hidden w-full bg-background', className]} {...rest}>
  {items.map((item) => (
    <div class="group/item flex flex-col">
      <button
        data-accordion-trigger={item.id}
        class="flex items-center justify-between w-full px-5 py-4 text-left font-medium text-foreground hover:bg-background-alt focus:outline-none transition-colors duration-200 cursor-pointer"
      >
        <span>{item.title}</span>
        <svg
          data-accordion-icon
          class="h-4 w-4 text-foreground-muted transition-transform duration-200"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div
        data-accordion-panel={item.id}
        class="hidden px-5 pb-5 text-sm text-foreground-muted leading-relaxed"
      >
        <p>{item.content}</p>
      </div>
    </div>
  ))}
</div>

<script define:vars={{ id }}>
  const container = document.getElementById(id);
  if (container) {
    const triggers = container.querySelectorAll('[data-accordion-trigger]');
    
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const itemId = trigger.getAttribute('data-tab-trigger') || trigger.getAttribute('data-accordion-trigger');
        const panel = container.querySelector(`[data-accordion-panel="${itemId}"]`);
        const icon = trigger.querySelector('[data-accordion-icon]');
        const isCollapsed = panel.classList.contains('hidden');

        // Toggle state
        if (isCollapsed) {
          panel.classList.remove('hidden');
          if (icon) icon.classList.add('rotate-180');
        } else {
          panel.classList.add('hidden');
          if (icon) icon.classList.remove('rotate-180');
        }
      });
    });
  }
</script>
