---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline' | 'danger' | 'link';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  disabled?: boolean;
  loading?: boolean;
  href?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  disabled = false,
  loading = false,
  href,
  ...rest
} = Astro.props;

// Base styles & micro-interactions per Design.md §154-172
const baseStyles = 'inline-flex items-center justify-center font-sans font-semibold text-sm rounded-full transition-all duration-200 ease-in-out focus:outline-none disabled:opacity-50 disabled:bg-hairline disabled:text-muted disabled:pointer-events-none cursor-pointer text-center';

const variants = {
  primary: 'bg-primary text-on-primary hover:bg-primary-active active:bg-ink-strong border border-transparent',
  secondary: 'bg-transparent text-ink border border-ink hover:bg-surface-strong active:scale-98',
  tertiary: 'bg-canvas text-ink border border-hairline hover:bg-surface active:scale-98',
  outline: 'bg-transparent text-ink border border-ink hover:bg-surface-strong active:scale-98',
  ghost: 'bg-transparent text-ink hover:bg-surface active:bg-surface-strong',
  danger: 'bg-semantic-error text-white hover:opacity-90 active:scale-98',
  link: 'bg-transparent text-ink hover:underline p-0 h-auto rounded-none',
  circular: 'w-9 h-9 p-0 rounded-full bg-canvas border border-hairline text-ink hover:bg-surface flex items-center justify-center shrink-0',
};

const sizes = {
  xs: 'px-3 py-1 text-xs h-7 gap-1',
  sm: 'px-4 py-1.5 text-xs h-8 gap-1.5',
  md: 'px-6 py-2.5 text-sm h-10 gap-2',
  lg: 'px-7 py-3 text-base h-12 gap-2.5',
  xl: 'px-8 py-3.5 text-lg h-14 gap-3',
};

const Element = href ? 'a' : 'button';
const elementProps = href ? { href, ...rest } : { type, disabled: disabled || loading, ...rest };
---

<Element class:list={[baseStyles, variants[variant], sizes[size], className]} {...elementProps}>
  {loading && (
    <svg class="animate-spin h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  )}
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
</Element>