---
interface Props {
  label?: string;
  error?: string;
  helperText?: string;
  class?: string;
  id?: string;
  checked?: boolean;
  [key: string]: any;
}

const {
  label,
  error,
  helperText,
  class: className = '',
  id = `checkbox-${Math.random().toString(36).substr(2, 9)}`,
  checked = false,
  ...rest
} = Astro.props;
---

<div class="flex flex-col gap-1 w-full">
  <label for={id} class="inline-flex items-start gap-2.5 cursor-pointer select-none group">
    <div class="relative flex items-center justify-center mt-0.5">
      <input
        type="checkbox"
        id={id}
        checked={checked}
        class:list={[
          'peer sr-only',
          className
        ]}
        {...rest}
      />
      <div class="h-4 w-4 rounded border border-border bg-background transition-all duration-200 peer-checked:bg-primary peer-checked:border-primary peer-focus:ring-2 peer-focus:ring-accent/20 group-hover:border-border-muted peer-disabled:opacity-50"></div>
      <svg class="absolute h-2.5 w-2.5 text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity duration-150 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    {label && (
      <div class="flex flex-col">
        <span class="text-sm font-medium text-foreground leading-snug group-hover:text-foreground/90">{label}</span>
        {helperText && <span class="text-xs text-foreground-muted leading-tight mt-0.5">{helperText}</span>}
      </div>
    )}
  </label>
  {error && <p class="text-xs text-error font-medium leading-none ml-6.5 mt-0.5">{error}</p>}
</div>
