---
interface Props {
  variant?: 'flat' | 'elevated' | 'glass' | 'interactive';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
  href?: string;
  [key: string]: any;
}

const {
  variant = 'flat',
  padding = 'md',
  class: className = '',
  href,
  ...rest
} = Astro.props;

// Premium surface elevations and layout wrappers
const baseStyles = 'rounded-lg border border-border bg-background transition-all duration-200 overflow-hidden';

const variants = {
  flat: 'bg-background-alt border-border/30',
  elevated: 'shadow-md border-border/20 hover:shadow-lg transition-shadow duration-200',
  glass: 'glass shadow-sm',
  interactive: 'cursor-pointer hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200 active:scale-[0.98]'
};

const paddings = {
  none: 'p-0',
  sm: 'p-3',
  md: 'p-6',
  lg: 'p-8'
};

const Element = href ? 'a' : 'div';
const elementProps = href ? { href, ...rest } : rest;
---

<Element class:list={[baseStyles, variants[variant], paddings[padding], className]} {...elementProps}>
  <slot />
</Element>