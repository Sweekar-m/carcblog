---
interface Props {
  label?: string;
  type?: string;
  error?: string;
  helperText?: string;
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  label,
  type = 'text',
  error = '',
  helperText = '',
  class: className = '',
  id = `input-${Math.random().toString(36).substr(2, 9)}`,
  ...rest
} = Astro.props;
---

<div class="flex flex-col gap-1.5 w-full">
  {label && (
    <label for={id} class="text-xs font-semibold text-foreground/80 tracking-wide uppercase select-none">
      {label}
    </label>
  )}
  <div class="relative flex items-center">
    <slot name="left-icon" />
    <input
      type={type}
      id={id}
      class:list={[
        'w-full px-3.5 h-10 md:h-10 text-sm rounded-md border bg-canvas text-ink font-sans transition-all duration-200 focus:outline-none focus:border-[2px] focus:border-brand-blue placeholder:text-steel disabled:opacity-50 disabled:pointer-events-none',
        error ? 'border-[#d45656] text-[#d45656] focus:border-[#d45656]' : 'border-hairline',
        Astro.slots.has('left-icon') ? 'pl-9' : '',
        Astro.slots.has('right-icon') ? 'pr-9' : '',
        className
      ]}
      {...rest}
    />
    <slot name="right-icon" />
  </div>
  {error ? (
    <p class="text-xs text-error font-medium leading-none mt-0.5">{error}</p>
  ) : helperText ? (
    <p class="text-xs text-foreground-muted leading-none mt-0.5">{helperText}</p>
  ) : null}
</div>