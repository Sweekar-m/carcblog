---
interface Props {
  label?: string;
  error?: string;
  helperText?: string;
  class?: string;
  id?: string;
  rows?: number;
  [key: string]: any;
}

const {
  label,
  error,
  helperText,
  class: className = '',
  id = `textarea-${Math.random().toString(36).substr(2, 9)}`,
  rows = 4,
  ...rest
} = Astro.props;
---

<div class="flex flex-col gap-1.5 w-full">
  {label && (
    <label for={id} class="text-xs font-semibold text-foreground/80 tracking-wide uppercase select-none">
      {label}
    </label>
  )}
  <textarea
    id={id}
    rows={rows}
    class:list={[
      'w-full px-3 py-2 text-sm rounded-md border bg-background text-foreground transition-all duration-200 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 placeholder:text-foreground-subtle disabled:opacity-50 disabled:pointer-events-none resize-y',
      error ? 'border-error focus:ring-error/20 focus:border-error' : 'border-border focus:border-accent',
      className
    ]}
    {...rest}
  />
  {error ? (
    <p class="text-xs text-error font-medium leading-none mt-0.5">{error}</p>
  ) : helperText ? (
    <p class="text-xs text-foreground-muted leading-none mt-0.5">{helperText}</p>
  ) : null}
</div>
