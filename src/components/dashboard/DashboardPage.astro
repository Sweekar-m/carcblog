---
/**
 * DashboardPage.astro
 * Shared page-level shell for authenticated dashboard pages.
 *
 * Renders a consistent max-width container, page header (h1 + subtitle),
 * and content area. Individual pages only supply their specific content.
 *
 * Usage:
 *   <DashboardPage title="Notifications" subtitle="Your activity updates.">
 *     <slot />
 *   </DashboardPage>
 *
 * Named slots:
 *   - default: main page content
 *   - actions: optional right-side header actions (buttons, filters)
 */

interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className = '' } = Astro.props;
---

<div class={`w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 font-sans ${className}`}>
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 sm:mb-8 pb-4 sm:pb-6 border-b border-hairline">
    <div>
      <h1 class="font-sans text-2xl sm:text-3xl font-extrabold text-ink tracking-tight leading-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="font-sans text-sm sm:text-base text-steel mt-1">{subtitle}</p>
      )}
    </div>
    <div class="shrink-0">
      <slot name="actions" />
    </div>
  </div>

  <!-- Page Content -->
  <slot />
</div>
