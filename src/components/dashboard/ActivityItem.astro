---
// ActivityItem.astro — Individual row in the dashboard's activity list
// white surface-card, hairline border, xl radius, single shadow
interface Props {
  type: 'article' | 'engagement' | 'follow';
  title?: string;
  description?: string;
  timestamp: string;
}

const { type, title, description, timestamp } = Astro.props;
---

<div class="activity-row-card">
  <!-- voice-icon-circular style -->
  <div class="activity-icon-wrap" aria-hidden="true">
    {type === 'article' && (
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m2 0a9 9 0 11-18 0 9 9 0 0018 0z" />
      </svg>
    )}
    {type === 'engagement' && (
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 3v1h16V3H4zm1 14a2 2 0 100-4 2 2 0 000 4zm4-6a2 2 0 100-4 2 2 0 000 4zm4 0a2 2 0 100-4 2 2 0 000 4z" />
      </svg>
    )}
    {type === 'follow' && (
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5c0-6-2-8-5-8-5 0-5 2-5 8v7c0 6 2 6 8 4z" />
      </svg>
    )}
  </div>
  
  <div class="activity-body">
    <p class="activity-title">{title || description}</p>
    <time class="activity-time" datetime={timestamp}>
      {new Date(timestamp).toLocaleString(undefined, { 
        month: 'short', 
        day: 'numeric', 
        year: 'numeric', 
        hour: '2-digit', 
        minute: '2-digit' 
      })}
    </time>
  </div>
  <!-- badge-pill type indicator -->
  <span class="badge-pill activity-type-badge">{type}</span>
</div>

<style>
  .activity-row-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    transition: box-shadow var(--duration-200) var(--ease-out), border-color var(--duration-200) var(--ease-out);
  }
  .activity-row-card:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-card-hover);
  }

  /* voice-icon-circular wrap */
  .activity-icon-wrap {
    width: 32px; height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .activity-body { flex: 1; min-width: 0; }

  .activity-title {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--color-body-strong);
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .activity-time {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-muted-soft);
    margin: 0;
    display: block;
  }

  .activity-type-badge {
    flex-shrink: 0;
  }
</style>
