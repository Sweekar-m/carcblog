---
// SidebarNav.astro — Role-aware left sidebar navigation per design.md
import { SignOutButton } from '@clerk/astro/components';

interface Props {
  currentPath: string;
  role?: 'reader' | 'founder' | 'writer' | 'admin';
}

const { currentPath, role = 'writer' } = Astro.props;

const isActive = (path: string) => {
  if (path === '/dashboard') return currentPath === '/dashboard';
  return currentPath.startsWith(path);
};

// Define role-based navigation item maps
const roleNavItems = {
  reader: [
    { href: '/dashboard', label: 'Overview', icon: 'home' },
    { href: '/dashboard/following', label: 'Following', icon: 'users' },
    { href: '/dashboard/bookmarks', label: 'Bookmarks', icon: 'bookmark' },
    { href: '/dashboard/likes', label: 'Liked Articles', icon: 'heart' },
    { href: '/dashboard/history', label: 'Reading History', icon: 'clock' },
    { href: '/dashboard/notifications', label: 'Notifications', icon: 'bell' },
    { href: '/dashboard/settings', label: 'Settings', icon: 'settings' },
  ],
  founder: [
    { href: '/dashboard', label: 'Overview', icon: 'home' },
    { href: '/dashboard/following', label: 'Following', icon: 'users' },
    { href: '/dashboard/bookmarks', label: 'Bookmarks', icon: 'bookmark' },
    { href: '/dashboard/likes', label: 'Liked Articles', icon: 'heart' },
    { href: '/dashboard/history', label: 'Reading History', icon: 'clock' },
    { href: '/dashboard/notifications', label: 'Notifications', icon: 'bell' },
    { href: '/dashboard/settings', label: 'Settings', icon: 'settings' },
  ],
  writer: [
    { href: '/dashboard', label: 'Overview', icon: 'home' },
    { href: '/dashboard/articles', label: 'Articles', icon: 'document' },
    { href: '/dashboard/analytics', label: 'Analytics', icon: 'chart' },
    { href: '/dashboard/following', label: 'Following', icon: 'users' },
    { href: '/dashboard/bookmarks', label: 'Bookmarks', icon: 'bookmark' },
    { href: '/dashboard/likes', label: 'Liked Articles', icon: 'heart' },
    { href: '/dashboard/history', label: 'Reading History', icon: 'clock' },
    { href: '/dashboard/notifications', label: 'Notifications', icon: 'bell' },
    { href: '/dashboard/settings', label: 'Settings', icon: 'settings' },
  ],
  admin: [
    { href: '/dashboard', label: 'Overview', icon: 'home' },
    { href: '/dashboard/users', label: 'Users', icon: 'users' },
    { href: '/dashboard/articles', label: 'Articles', icon: 'document' },
    { href: '/dashboard/following', label: 'Following', icon: 'users' },
    { href: '/dashboard/bookmarks', label: 'Bookmarks', icon: 'bookmark' },
    { href: '/dashboard/likes', label: 'Liked Articles', icon: 'heart' },
    { href: '/dashboard/history', label: 'Reading History', icon: 'clock' },
    { href: '/dashboard/notifications', label: 'Notifications', icon: 'bell' },
    { href: '/dashboard/settings', label: 'Settings', icon: 'settings' },
  ]
};

const navItems = roleNavItems[role] || roleNavItems.writer;
---

<div class="sidebar-wrapper">
  {/* Navigation links */}
  <nav class="sidebar-nav" aria-label="Dashboard navigation">
    <div class="role-badge">
      <span class="role-dot"></span>
      <span class="role-text">{role.toUpperCase()} DASHBOARD</span>
    </div>

    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`nav-link ${active ? 'nav-link--active' : ''}`}
          aria-current={active ? 'page' : undefined}
        >
          <span class={`nav-icon ${active ? 'nav-icon--active' : ''}`}>
            {item.icon === 'home' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 100-2z" />
              </svg>
            )}
            {item.icon === 'building' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            )}
            {item.icon === 'document' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {item.icon === 'file' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            )}
            {item.icon === 'check-circle' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {item.icon === 'chart' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            )}
            {item.icon === 'bookmark' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
              </svg>
            )}
            {item.icon === 'heart' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            )}
            {item.icon === 'clock' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {item.icon === 'bell' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
            )}
            {item.icon === 'settings' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            {item.icon === 'users' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            )}
            {item.icon === 'trending' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            )}
            {item.icon === 'edit' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            )}
            {item.icon === 'layers' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            )}
            {item.icon === 'file-text' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
          </span>
          <span class="nav-label">{item.label}</span>
        </a>
      );
    })}
  </nav>

  {/* Logout / Sign Out Button at bottom */}
  <div class="sidebar-footer">
    <SignOutButton redirectUrl="/">
      <button class="logout-btn" aria-label="Sign out of account">
        <span class="nav-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </span>
        <span class="nav-label">Sign Out</span>
      </button>
    </SignOutButton>
  </div>
</div>

<style>
  .sidebar-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: calc(100vh - 100px);
  }

  .role-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    margin-bottom: 12px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    width: fit-content;
  }
  .role-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-blue, #0ea5e9);
  }
  .role-text {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-steel);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-link, .logout-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 12px 14px;
    min-height: 48px;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--color-steel);
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
    outline: none;
    border: none;
    background: transparent;
    width: 100%;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
  }
  .nav-link:hover, .logout-btn:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .nav-link:focus-visible, .logout-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .nav-link--active {
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
  }
  .nav-link--active:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .nav-icon {
    flex-shrink: 0;
    color: var(--color-stone);
    display: flex;
    align-items: center;
    transition: color 150ms ease;
  }
  .nav-link--active .nav-icon {
    color: var(--color-ink);
  }

  .sidebar-footer {
    padding-top: 16px;
    border-top: 1px solid var(--color-hairline);
    margin-top: 16px;
  }
</style>
