---
// SidebarNav.astro — Modular sidebar navigation with scoped CSS and Sign Out
import { SignOutButton } from '@clerk/astro/components';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (path: string) => {
  if (path === '/dashboard') return currentPath === '/dashboard';
  return currentPath.startsWith(path);
};

const navItems = [
  { href: '/dashboard',           label: 'Overview',  icon: 'home'     },
  { href: '/dashboard/articles',  label: 'Articles',  icon: 'document' },
  { href: '/dashboard/analytics', label: 'Analytics', icon: 'chart'    },
  { href: '/dashboard/profile',   label: 'Profile',   icon: 'user'     },
  { href: '/dashboard/settings',  label: 'Settings',  icon: 'settings' },
];
---

<div class="sidebar-wrapper">
  <!-- Navigation links -->
  <nav class="sidebar-nav" aria-label="Dashboard navigation">
    {navItems.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`nav-link ${active ? 'nav-link--active' : ''}`}
          aria-current={active ? 'page' : undefined}
        >
          <span class={`nav-icon ${active ? 'nav-icon--active' : ''}`}>
            {item.icon === 'home' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 100-2z" />
              </svg>
            )}
            {item.icon === 'document' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            )}
            {item.icon === 'chart' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            )}
            {item.icon === 'user' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            )}
            {item.icon === 'settings' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
          </span>
          <span class="nav-label">{item.label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Logout / Sign Out Button at bottom -->
  <div class="sidebar-footer">
    <SignOutButton redirectUrl="/">
      <button class="logout-btn" aria-label="Sign out of account">
        <span class="nav-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </span>
        <span class="nav-label">Sign Out</span>
      </button>
    </SignOutButton>
  </div>
</div>

<style>
  .sidebar-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: calc(100vh - 48px);
  }

  /* ── Nav container ── */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* ── Individual nav link / buttons — nav-link spec: Inter 500 15px, ink/muted ── */
  .nav-link, .logout-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 8px var(--space-sm);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--fs-nav-link);
    font-weight: var(--fw-medium);
    line-height: var(--lh-nav-link);
    color: var(--color-muted);
    text-decoration: none;
    transition: background var(--duration-150) var(--ease-out), color var(--duration-150) var(--ease-out);
    outline: none;
    border: none;
    background: transparent;
    width: 100%;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
  }
  .nav-link:hover, .logout-btn:hover {
    background: var(--color-surface-strong);
    color: var(--color-ink);
  }
  .nav-link:focus-visible, .logout-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* ── Active link: surface-strong bg, ink text — NO blue ── */
  .nav-link--active {
    background: var(--color-surface-strong);
    color: var(--color-ink);
  }
  .nav-link--active:hover {
    background: var(--color-hairline-soft);
    color: var(--color-ink);
  }

  /* ── Icons ── */
  .nav-icon {
    flex-shrink: 0;
    color: var(--color-muted-soft);
    display: flex;
    align-items: center;
    transition: color var(--duration-150) var(--ease-out);
  }
  .nav-link--active .nav-icon,
  .nav-link:hover .nav-icon,
  .logout-btn:hover .nav-icon {
    color: var(--color-ink);
  }

  /* ── Label text ── */
  .nav-label {
    font-family: var(--font-sans);
    letter-spacing: 0;
    line-height: 1;
  }

  /* ── Footer ── */
  .sidebar-footer {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-hairline);
  }

  /* Sign out — muted hover, no red tint */
  .logout-btn:hover {
    background: var(--color-surface-strong);
    color: var(--color-body-strong);
  }
</style>
