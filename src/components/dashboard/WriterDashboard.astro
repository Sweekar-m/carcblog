---
// WriterDashboard.astro — ElevenLabs editorial design system
// surface-card stats, badge-pill status, EB Garamond 300 headings, hairline dividers
interface Props {
  stats: {
    articleCount: number;
    viewCount: number;
    readTime: number;
  };
  recentActivity: Array<{
    type: 'article' | 'engagement' | 'follow';
    title?: string;
    description?: string;
    timestamp: string;
  }>;
  userName?: string;
}

const { stats, recentActivity, userName = 'Writer' } = Astro.props;

function formatDate(ts: string) {
  return new Date(ts).toLocaleString(undefined, {
    month: 'short', day: 'numeric', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
  });
}
---

<div class="dashboard-content">

  <!-- Welcome header: EB Garamond 300 -->
  <div class="welcome-block">
    <h1 class="welcome-heading">Welcome back, {userName}.</h1>
    <p class="welcome-sub">Here's what's happening with your writing.</p>
  </div>

  <!-- Quick action: ink pill CTA -->
  <div class="quick-action">
    <a href="/dashboard/articles/new" class="btn-primary" id="dash-new-article">Write a new article</a>
    <a href="/dashboard/articles" class="btn-outline" id="dash-all-articles">Manage articles</a>
  </div>

  <!-- Stats grid: surface-card, hairline border, xl radius -->
  <div class="stats-grid">

    <!-- Articles -->
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <span class="stat-label">Articles Published</span>
      </div>
      <!-- EB Garamond 300 display number -->
      <p class="stat-value">{stats.articleCount}</p>
    </div>

    <!-- Views -->
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <span class="stat-label">Total Views</span>
      </div>
      <p class="stat-value">{stats.viewCount.toLocaleString()}</p>
    </div>

    <!-- Read time -->
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
          </svg>
        </div>
        <span class="stat-label">Avg. Read Time</span>
      </div>
      <p class="stat-value">{stats.readTime}<span class="stat-unit">min</span></p>
    </div>

  </div>

  <!-- Recent activity: hairline-divider rows, badge-pill type labels -->
  <div class="activity-section">
    <h2 class="section-heading">Recent Activity</h2>

    {recentActivity.length > 0 ? (
      <div class="activity-list">
        {recentActivity.map((activity) => (
          <div class="activity-row">
            <div class="activity-icon-wrap" aria-hidden="true">
              {activity.type === 'article' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
              )}
              {activity.type === 'engagement' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              )}
              {activity.type === 'follow' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
              )}
            </div>
            <div class="activity-body">
              <p class="activity-title">{activity.title || activity.description}</p>
              <time class="activity-time">{formatDate(activity.timestamp)}</time>
            </div>
            <!-- badge-pill type indicator -->
            <span class="badge-pill activity-type-badge">{activity.type}</span>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-activity">
        <p>No recent activity yet. Start writing to see updates here.</p>
      </div>
    )}
  </div>

  <!-- CTA card — surface-card, EB Garamond 300, ink pill -->
  <div class="dash-cta-card">
    <h2 class="dash-cta-title">Ready to write your next story?</h2>
    <p class="dash-cta-body">
      Share your perspective with a community of thoughtful readers.
    </p>
    <a href="/dashboard/articles/new" class="btn-primary" id="dash-cta-write">Start writing</a>
  </div>

</div>

<style>
  .dashboard-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);                   /* 32px */
  }

  /* ── Welcome ── */
  .welcome-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hairline);
  }
  /* display-md: EB Garamond 300, 32px */
  .welcome-heading {
    font-family: var(--font-serif);
    font-size: var(--fs-display-md);
    font-weight: var(--fw-light);           /* 300 */
    color: var(--color-ink);
    margin: 0;
    line-height: var(--lh-display-md);
    letter-spacing: var(--ls-display-md);
  }
  .welcome-sub {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-muted);
    margin: 0;
    line-height: var(--lh-body-sm);
  }

  /* ── Quick action ── */
  .quick-action {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* ── Stats grid: surface-card, hairline, xl radius ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr; }
  }

  .stat-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    transition: box-shadow var(--duration-200) var(--ease-out);
  }
  .stat-card:hover {
    box-shadow: var(--shadow-card-hover);
  }

  .stat-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  /* voice-icon-circular: surface-strong, md radius */
  .stat-icon {
    width: 32px; height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  /* caption-uppercase */
  .stat-label {
    font-family: var(--font-sans);
    font-size: var(--fs-caption-upper);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caption-upper);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* EB Garamond 300 display-xl for stat numbers */
  .stat-value {
    font-family: var(--font-serif);
    font-size: var(--fs-display-xl);        /* 48px */
    font-weight: var(--fw-light);           /* 300 */
    color: var(--color-ink);
    margin: 0;
    line-height: 1;
    letter-spacing: var(--ls-display-xl);
  }
  .stat-unit {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: var(--fw-regular);
    color: var(--color-muted);
    margin-left: 4px;
  }

  /* ── Activity section ── */
  .activity-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* title-md: Inter 500, 20px */
  .section-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-title-md);
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    margin: 0;
    line-height: var(--lh-title-md);
  }

  /* Activity list — hairline divider rows */
  .activity-list {
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .activity-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-hairline-soft);
    transition: background var(--duration-150) var(--ease-out);
  }
  .activity-row:last-child { border-bottom: none; }
  .activity-row:hover { background: var(--color-canvas-soft); }

  /* voice-icon-circular style */
  .activity-icon-wrap {
    width: 32px; height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-strong);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .activity-body { flex: 1; min-width: 0; }

  .activity-title {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--color-body-strong);
    margin: 0 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .activity-time {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-muted-soft);
    margin: 0;
  }

  /* badge-pill type indicator */
  .activity-type-badge {
    flex-shrink: 0;
  }

  /* Empty state */
  .empty-activity {
    text-align: center;
    padding: var(--space-xl);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
  }
  .empty-activity p {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-muted);
    margin: 0;
  }

  /* ── CTA card — surface-card, xl radius ── */
  .dash-cta-card {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  /* display-sm: EB Garamond 300, 24px */
  .dash-cta-title {
    font-family: var(--font-serif);
    font-size: var(--fs-display-sm);
    font-weight: var(--fw-light);
    color: var(--color-ink);
    margin: 0;
    line-height: var(--lh-display-sm);
  }

  .dash-cta-body {
    font-family: var(--font-sans);
    font-size: var(--fs-body-sm);
    color: var(--color-body);
    margin: 0;
    max-width: 380px;
    line-height: var(--lh-body-sm);
  }
</style>
