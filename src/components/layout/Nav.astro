---
// Nav.astro — ElevenLabs editorial design system
// top-nav spec: canvas background #f5f5f5, height 64px, ink text, pill CTA
import { UserButton } from '@clerk/astro/components';

const user = Astro.locals.user;
const userId = user?.userId;

const currentPath = new URL(Astro.request.url).pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="nav-root" role="banner">
  <div class="nav-inner">

    <!-- ── Logo ── -->
    <a href="/" class="nav-logo" aria-label="Carcblog home">
      <span class="logo-text">Carcblog</span>
    </a>

    <!-- ── Primary nav links (desktop) ── -->
    <nav class="nav-links" aria-label="Primary navigation">
      {[
        { href: '/feed',     label: 'Feed'     },
        { href: '/discover', label: 'Discover' },
        { href: '/topics',   label: 'Topics'   },
        { href: '/writers',  label: 'Writers'  },
        { href: '/about',    label: 'About'    },
      ].map(({ href, label }) => (
        <a
          href={href}
          class={`nav-link ${isActive(href) ? 'nav-link--active' : ''}`}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- ── Right cluster ── -->
    <div class="nav-actions">

      <!-- Search — expands on click -->
      <div class="search-wrap" id="search-wrap">
        <button
          class="search-trigger"
          id="search-trigger"
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="search-input"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <div class="search-input-wrap" id="search-input-wrap" aria-hidden="true">
          <input
            id="search-input"
            type="search"
            placeholder="Search articles…"
            class="search-input"
            autocomplete="off"
            tabindex="-1"
          />
        </div>
      </div>

      <!-- Auth controls -->
      {userId ? (
        <>
          {user?.role === 'writer' && (
            <>
              <a href="/dashboard" class={`nav-link ${isActive('/dashboard') ? 'nav-link--active' : ''}`}>Dashboard</a>
              <a href="/dashboard/articles/new" class="nav-cta" id="nav-write-cta">Write</a>
            </>
          )}
          <div class="user-btn-wrap">
            <UserButton afterSignOutUrl="/" />
          </div>
        </>
      ) : (
        <a href="/auth/sign-up" class="nav-cta" id="nav-get-started-cta">Get started</a>
      )}

      <!-- Mobile hamburger -->
      <button
        class="nav-burger"
        id="nav-burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </button>
    </div>
  </div>

  <!-- ── Mobile drawer ── -->
  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      {[
        { href: '/feed',     label: 'Feed'     },
        { href: '/discover', label: 'Discover' },
        { href: '/topics',   label: 'Topics'   },
        { href: '/writers',  label: 'Writers'  },
        { href: '/about',    label: 'About'    },
      ].map(({ href, label }) => (
        <a
          href={href}
          class={`mobile-link ${isActive(href) ? 'mobile-link--active' : ''}`}
        >
          {label}
        </a>
      ))}
      {userId && user?.role === 'writer' && (
        <a href="/dashboard" class="mobile-link">Dashboard</a>
      )}
      <div class="mobile-sep"></div>
      {userId ? (
        user?.role === 'writer' && (
          <a href="/dashboard/articles/new" class="mobile-cta" id="mobile-write-cta">Write an article →</a>
        )
      ) : (
        <a href="/auth/sign-up" class="mobile-cta" id="mobile-get-started-cta">Get started →</a>
      )}
    </nav>
  </div>
</header>

<!-- Interaction script -->
<script>
  // ── Search expand ──────────────────────────────────────
  const searchWrap     = document.getElementById('search-wrap') as HTMLElement;
  const searchTrigger  = document.getElementById('search-trigger') as HTMLButtonElement;
  const searchInputWrap= document.getElementById('search-input-wrap') as HTMLElement;
  const searchInput    = document.getElementById('search-input') as HTMLInputElement;

  function openSearch() {
    searchWrap.classList.add('search-open');
    searchTrigger.setAttribute('aria-expanded', 'true');
    searchInputWrap.removeAttribute('aria-hidden');
    searchInput.removeAttribute('tabindex');
    searchInput.focus();
  }
  function closeSearch() {
    searchWrap.classList.remove('search-open');
    searchTrigger.setAttribute('aria-expanded', 'false');
    searchInputWrap.setAttribute('aria-hidden', 'true');
    searchInput.setAttribute('tabindex', '-1');
    searchInput.value = '';
  }

  searchTrigger.addEventListener('click', () => {
    searchWrap.classList.contains('search-open') ? closeSearch() : openSearch();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearch(); });
  document.addEventListener('click', (e) => {
    if (!searchWrap.contains(e.target as Node)) closeSearch();
  });

  // ── Mobile menu ────────────────────────────────────────
  const burger    = document.getElementById('nav-burger') as HTMLButtonElement;
  const mobileNav = document.getElementById('nav-mobile') as HTMLElement;

  burger.addEventListener('click', () => {
    const isOpen = mobileNav.classList.toggle('nav-mobile--open');
    burger.setAttribute('aria-expanded', String(isOpen));
    mobileNav.setAttribute('aria-hidden', String(!isOpen));
    burger.classList.toggle('burger--open', isOpen);
  });

  mobileNav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('nav-mobile--open');
      burger.setAttribute('aria-expanded', 'false');
      mobileNav.setAttribute('aria-hidden', 'true');
      burger.classList.remove('burger--open');
    });
  });
</script>

<style>
/* ════════════════════════════════════════════════════════
   NAV ROOT — glass nav: translucent canvas with blur, ink text
   Shows particles softly through the nav for unified aesthetic
════════════════════════════════════════════════════════ */
.nav-root {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  background: rgba(245, 245, 245, 0.80);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(231, 229, 228, 0.6);
  color: var(--color-ink);
}

/* ── Inner layout ── */
.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-lg);               /* 24px sides */
  height: var(--h-nav);                     /* 64px */
  display: flex;
  align-items: center;
  gap: 0;
}

/* ════════════════════════════════════════════════════════
   LOGO — EB Garamond 300, ink, no color accent
════════════════════════════════════════════════════════ */
.nav-logo {
  display: inline-flex;
  align-items: baseline;
  text-decoration: none;
  margin-right: var(--space-xl);            /* 32px */
  flex-shrink: 0;
  color: var(--color-ink);
}

.logo-text {
  font-family: var(--font-serif);
  font-size: 1.25rem;                        /* ~20px — compact editorial wordmark */
  font-weight: var(--fw-light);             /* 300 */
  color: var(--color-ink);
  line-height: 1;
  letter-spacing: var(--ls-display-md);
}

/* ════════════════════════════════════════════════════════
   DESKTOP NAV LINKS — nav-link spec: Inter 500 15px, ink
════════════════════════════════════════════════════════ */
.nav-links {
  display: none;
  align-items: center;
  gap: 2px;
  flex: 1;
}

@media (min-width: 768px) {
  .nav-links { display: flex; }
}

.nav-link {
  font-family: var(--font-sans);
  font-size: var(--fs-nav-link);            /* 15px */
  font-weight: var(--fw-medium);            /* 500 */
  line-height: var(--lh-nav-link);          /* 1.4 */
  letter-spacing: var(--ls-display-sm);     /* 0 */
  color: var(--color-muted);
  text-decoration: none;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  transition: color var(--duration-150) var(--ease-out);
  white-space: nowrap;
}

.nav-link:hover {
  color: var(--color-ink);
  opacity: 1;
}

.nav-link--active {
  color: var(--color-ink);
}

/* ════════════════════════════════════════════════════════
   RIGHT CLUSTER
════════════════════════════════════════════════════════ */
.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--space-xs);                     /* 8px */
  margin-left: auto;
}

/* ── Search ── */
.search-wrap {
  display: flex;
  align-items: center;
  position: relative;
}

.search-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: none;
  background: transparent;
  color: var(--color-muted);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: color var(--duration-150) var(--ease-out), background var(--duration-150) var(--ease-out);
  flex-shrink: 0;
  z-index: 1;
}
.search-trigger:hover {
  color: var(--color-ink);
  background: var(--color-surface-strong);
}

.search-input-wrap {
  overflow: hidden;
  max-width: 0;
  opacity: 0;
  transition:
    max-width 280ms var(--ease-in-out),
    opacity 200ms var(--ease-out);
}

.search-open .search-input-wrap {
  max-width: 240px;
  opacity: 1;
}

.search-input {
  width: 240px;
  height: 36px;
  padding: 0 var(--space-sm) 0 var(--space-xs);
  background: var(--color-surface-card);
  border: 1px solid var(--color-hairline-strong);
  border-radius: var(--radius-md);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-regular);
  outline: none;
  transition: border-color var(--duration-150) var(--ease-out);
}
.search-input::placeholder { color: var(--color-muted-soft); }
.search-input:focus {
  border-color: var(--color-ink);
  border-width: 2px;
}
.search-input::-webkit-search-cancel-button { display: none; }

/* ── User button ── */
.user-btn-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── CTA pill — button-primary spec ── */
.nav-cta {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-sans);
  font-size: var(--fs-btn);                 /* 15px */
  font-weight: var(--fw-medium);            /* 500 */
  color: var(--color-on-primary);           /* white */
  background: var(--color-primary);         /* #292524 */
  text-decoration: none;
  padding: 10px 20px;
  height: var(--h-btn);                     /* 40px */
  border-radius: var(--radius-pill);        /* 9999px */
  white-space: nowrap;
  transition: background var(--duration-150) var(--ease-out);
}
.nav-cta:hover {
  background: var(--color-primary-active);  /* #0c0a09 */
  opacity: 1;
}
.nav-cta:active {
  background: var(--color-ink);
}

/* ── Burger button (mobile) ── */
.nav-burger {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4px;
  width: 36px;
  height: 36px;
  border: none;
  background: transparent;
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: background var(--duration-150) var(--ease-out);
  padding: 4px;
}
@media (min-width: 768px) { .nav-burger { display: none; } }
.nav-burger:hover { background: var(--color-surface-strong); }

.burger-bar {
  display: block;
  width: 18px;
  height: 1px;
  background: var(--color-ink);
  border-radius: var(--radius-pill);
  transition: transform 220ms var(--ease-in-out), opacity 180ms var(--ease-out), width 200ms var(--ease-in-out);
  transform-origin: center;
}

.burger--open .burger-bar:nth-child(1) {
  transform: translateY(5px) rotate(45deg);
}
.burger--open .burger-bar:nth-child(2) {
  opacity: 0;
  width: 0;
}
.burger--open .burger-bar:nth-child(3) {
  transform: translateY(-5px) rotate(-45deg);
}

/* ════════════════════════════════════════════════════════
   MOBILE DRAWER — canvas background, ink links
════════════════════════════════════════════════════════ */
.nav-mobile {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  max-height: 0;
  background: var(--color-canvas-soft);     /* #fafafa */
  border-top: 1px solid var(--color-hairline);
  transition: max-height 280ms var(--ease-in-out);
}

@media (min-width: 768px) { .nav-mobile { display: none; } }

.nav-mobile--open { max-height: 480px; }

.nav-mobile nav {
  display: flex;
  flex-direction: column;
  padding: var(--space-sm) var(--space-lg) var(--space-lg);
  gap: 2px;
}

.mobile-link {
  font-family: var(--font-sans);
  font-size: var(--fs-nav-link);
  font-weight: var(--fw-medium);
  color: var(--color-muted);
  text-decoration: none;
  padding: 10px var(--space-sm);
  border-radius: var(--radius-md);
  transition: color var(--duration-150) var(--ease-out), background var(--duration-150) var(--ease-out);
}
.mobile-link:hover,
.mobile-link--active {
  color: var(--color-ink);
  background: var(--color-surface-strong);
  opacity: 1;
}

.mobile-sep {
  height: 1px;
  background: var(--color-hairline);
  margin: var(--space-xs) 0;
}

/* Mobile CTA — ink pill */
.mobile-cta {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-sans);
  font-size: var(--fs-btn);
  font-weight: var(--fw-medium);
  color: var(--color-on-primary);
  background: var(--color-primary);
  text-decoration: none;
  padding: 12px var(--space-lg);
  border-radius: var(--radius-pill);
  margin-top: var(--space-xs);
  transition: background var(--duration-150) var(--ease-out);
  align-self: flex-start;
}
.mobile-cta:hover {
  background: var(--color-primary-active);
  opacity: 1;
}
</style>
