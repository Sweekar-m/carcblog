---
// Footer component
---
<footer class="footer">
  <div class="max-w-[1024px] mx-auto px-6">
    <!-- Grid Stacks -->
    <div class="footer-grid">
      <!-- Logo column -->
      <div class="footer-logo-col">
        <span class="footer-brand">Carcblog</span>
        <p class="footer-tagline">
          The premium platform for thoughtful writers who demand excellence.
        </p>
      </div>

      <!-- Links columns -->
      <div>
        <h5 class="footer-header">Explore</h5>
        <div class="footer-links">
          <a href="/" class="footer-link">Home</a>
          <a href="/feed" class="footer-link">Feed</a>
          <a href="/discover" class="footer-link">Discover</a>
          <a href="/topics" class="footer-link">Topics</a>
          <a href="/about" class="footer-link">About</a>
        </div>
      </div>

      <div>
        <h5 class="footer-header">Create</h5>
        <div class="footer-links">
          <a href="/dashboard" class="footer-link">Write</a>
          <a href="/dashboard/articles" class="footer-link">Manage Articles</a>
          <a href="/dashboard/analytics" class="footer-link">Analytics</a>
          <a href="/dashboard/settings" class="footer-link">Settings</a>
        </div>
      </div>

      <div>
        <h5 class="footer-header">Company</h5>
        <div class="footer-links">
          <a href="#" class="footer-link">Careers</a>
          <a href="#" class="footer-link">Blog</a>
          <a href="#" class="footer-link">Press</a>
          <a href="#" class="footer-link">Contact</a>
        </div>
      </div>

      <div>
        <h5 class="footer-header">Legal</h5>
        <div class="footer-links">
          <a href="/terms" class="footer-link">Terms</a>
          <a href="/privacy" class="footer-link">Privacy</a>
          <a href="/copyright" class="footer-link">Copyright</a>
          <a href="/accessibility" class="footer-link">Accessibility</a>
        </div>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="footer-bottom">
      <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
        <span>Copyright &copy; {new Date().getFullYear()} Carcblog Inc. All rights reserved.</span>
        <div class="flex space-x-4">
          <a href="/privacy" class="footer-legal-link">Privacy Policy</a>
          <span class="text-ink/20">|</span>
          <a href="/terms" class="footer-legal-link">Terms of Use</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-canvas-parchment);
    color: var(--color-foreground-muted);
    padding-top: 64px;
    padding-bottom: 64px;
    font-family: var(--font-sans);
    border-top: 1px solid var(--color-divider-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    padding-bottom: var(--spacing-xxl);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr repeat(4, 1fr);
    }
  }

  .footer-logo-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: var(--font-size-tagline);
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer-tagline {
    font-size: var(--font-size-caption);
    line-height: var(--leading-relaxed);
    max-width: 240px;
    color: var(--color-foreground-muted);
  }

  .footer-header {
    font-size: var(--font-size-caption);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: var(--spacing-sm);
    text-transform: capitalize;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
  }

  .footer-link {
    font-size: var(--font-size-body);
    line-height: 2.41; /* SF Pro dense-link standard */
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--spacing-lg);
    font-size: var(--font-size-fine-print, 12px);
    color: #7a7a7a; /* ink-muted-48 */
  }

  .footer-legal-link {
    color: #7a7a7a;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer-legal-link:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>