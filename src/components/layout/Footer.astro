---
// Footer — ElevenLabs editorial design system
// footer spec: canvas bg, body text, body-sm type, 5-column, 64px×48px padding
---
<footer class="footer" role="contentinfo">
  <div class="footer-container">
    <!-- 5-column grid: 2fr brand + 4× 1fr link columns -->
    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-wordmark" aria-label="Carcblog home">Carcblog</a>
        <p class="footer-tagline">
          The editorial platform for the startup ecosystem. News, founder stories, funding updates, and more.
        </p>
      </div>

      <!-- Explore column -->
      <div class="footer-links-col">
        <div class="footer-col-head" role="heading" aria-level="3">Explore</div>
        <nav aria-label="Explore links">
          <a href="/" class="footer-link">Home</a>
          <a href="/feed" class="footer-link">Feed</a>
          <a href="/blog" class="footer-link">Blog</a>
          <a href="/discover" class="footer-link">Discover</a>
          <a href="/topics" class="footer-link">Topics</a>
          <a href="/about" class="footer-link">About</a>
          <a href="/labs" class="footer-link">Labs</a>
        </nav>
      </div>

      <!-- Create column -->
      <div class="footer-links-col">
        <div class="footer-col-head" role="heading" aria-level="3">Create</div>
        <nav aria-label="Create links">
          <a href="/dashboard" class="footer-link">Write</a>
          <a href="/dashboard/articles" class="footer-link">Manage Articles</a>
          <a href="/dashboard/analytics" class="footer-link">Analytics</a>
          <a href="/dashboard/settings" class="footer-link">Settings</a>
        </nav>
      </div>

      <!-- Company column -->
      <div class="footer-links-col">
        <div class="footer-col-head" role="heading" aria-level="3">Company</div>
        <nav aria-label="Company links">
          <a href="#" class="footer-link">Careers</a>
          <a href="#" class="footer-link">Blog</a>
          <a href="#" class="footer-link">Press</a>
          <a href="#" class="footer-link">Contact</a>
        </nav>
      </div>

      <!-- Legal column -->
      <div class="footer-links-col">
        <div class="footer-col-head" role="heading" aria-level="3">Legal</div>
        <nav aria-label="Legal links">
          <a href="/terms" class="footer-link">Terms</a>
          <a href="/privacy" class="footer-link">Privacy</a>
          <a href="/copyright" class="footer-link">Copyright</a>
          <a href="/accessibility" class="footer-link">Accessibility</a>
        </nav>
      </div>

    </div>

    <!-- Bottom row -->
    <div class="footer-bottom">
      <span class="footer-copy">
        Copyright &copy; {new Date().getFullYear()} Carcblog. All rights reserved.
      </span>
      <div class="footer-legal-row">
        <a href="/privacy" class="footer-legal-link">Privacy Policy</a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="/terms" class="footer-legal-link">Terms of Use</a>
      </div>
    </div>

  </div>
</footer>

<style>
/* ════════════════════════════════════════════════════════════
   FOOTER — glass treatment matching nav/card aesthetic
   Semi-transparent canvas bg with blur, body text color
════════════════════════════════════════════════════════════ */
.footer {
  background: #0f172a;
  color: #94a3b8;
  border-top: 1px solid #1e293b;
  font-family: var(--font-sans);
}

.footer-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 64px 32px;
}
@media (max-width: 768px) {
  .footer-container { padding: var(--space-xxl) var(--space-lg); }
}

/* ── 5-column grid ── */
.footer-grid {
  display: grid;
  grid-template-columns: 2fr repeat(4, 1fr);
  gap: var(--space-xl);
  padding-bottom: var(--space-xxl);
}
@media (max-width: 768px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .footer-grid { grid-template-columns: 1fr; }
}

/* ── Brand column ── */
.footer-brand-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  grid-column: 1;
}

.footer-wordmark {
  font-family: var(--font-sans);
  font-size: var(--fs-heading-sm);
  font-weight: var(--fw-bold);
  color: #ffffff;
  text-decoration: none;
  line-height: 1;
  letter-spacing: -0.02em;
}

.footer-tagline {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-regular);
  color: #94a3b8;
  line-height: var(--lh-body-sm);
  max-width: 280px;
  margin: 0;
}

/* ── Link columns ── */
.footer-links-col {
  display: flex;
  flex-direction: column;
}
.footer-links-col nav {
  display: flex;
  flex-direction: column;
}

.footer-col-head {
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: var(--fw-semibold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #ffffff;
  margin-bottom: var(--space-sm);
}

.footer-link {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-regular);
  line-height: 2.2;
  color: #94a3b8;
  text-decoration: none;
  transition: color var(--duration-150) var(--ease-out);
}
.footer-link:hover {
  color: #ffffff;
}

/* ── Bottom row ── */
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-md);
  padding-top: var(--space-lg);
  border-top: 1px solid #1e293b;
}

.footer-copy {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: #cbd5e1;
}

.footer-legal-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.footer-sep {
  color: #64748b;
  font-size: var(--fs-caption);
}

.footer-legal-link {
  font-family: var(--font-sans);
  font-size: var(--fs-caption);
  color: #cbd5e1;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color var(--duration-150) var(--ease-out);
}
.footer-legal-link:hover {
  color: #ffffff;
}
</style>