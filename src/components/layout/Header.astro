---
// Header component
let userId = null;
let user = null;
if (typeof Astro.locals.auth === 'function') {
  try {
    const auth = await Astro.locals.auth();
    userId = auth?.userId;
    if (userId && typeof Astro.locals.currentUser === 'function') {
      user = await Astro.locals.currentUser();
    }
  } catch (e) {
    console.warn("Auth check failed in Header:", e);
  }
}
---
<!-- Two-Tier Premium Navigation -->
<div class="nav-wrapper">
  <!-- 1. Global Navigation Bar -->
  <nav class="global-nav">
    <div class="max-w-[1440px] mx-auto px-6 h-full flex items-center justify-between">
      <!-- Apple-inspired Logo -->
      <a href="/" class="global-nav-logo">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          <path d="M2 12h20" />
        </svg>
        <span class="sr-only">Carcblog</span>
      </a>

      <!-- Horizontal Menu Link Row -->
      <div class="global-nav-links">
        <a href="/feed" class="global-nav-link">Feed</a>
        <a href="/discover" class="global-nav-link">Discover</a>
        <a href="/topics" class="global-nav-link">Topics</a>
        <a href="/about" class="global-nav-link">About</a>
      </div>

      <!-- Action items -->
      <div class="global-nav-actions">
        <a href="/search" class="global-nav-icon" aria-label="Search">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        {userId ? (
          <a href="/dashboard" class="global-nav-icon relative" aria-label="Dashboard">
            <img src={user?.imageUrl || "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"}
                 alt="User Profile" class="h-5.5 w-5.5 rounded-full object-cover border border-white/20" />
          </a>
        ) : (
          <a href="/sign-in" class="global-nav-link text-xs">Sign In</a>
        )}
      </div>
    </div>
  </nav>

  <!-- 2. Sub Navigation Bar (Frosted Glass) -->
  <div class="sub-nav">
    <div class="max-w-[1440px] mx-auto px-6 h-full flex items-center justify-between">
      <a href="/" class="sub-nav-title">Carcblog</a>

      <div class="sub-nav-right">
        <div class="sub-nav-links">
          <a href="/discover" class="sub-nav-link">Featured</a>
          <a href="/topics" class="sub-nav-link">Categories</a>
        </div>

        {userId ? (
          <a href="/dashboard/articles/new" class="btn-primary-pill text-xs font-semibold leading-none">
            Write Article
          </a>
        ) : (
          <a href="/sign-up" class="btn-primary-pill text-xs font-semibold leading-none">
            Subscribe
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .nav-wrapper {
    position: relative;
    z-index: 1020;
    width: 100%;
  }

  /* ── Global Nav Bar (44px true-black) ── */
  .global-nav {
    height: 44px;
    background-color: #000000;
    font-size: 12px;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .global-nav-logo {
    color: rgba(255, 255, 255, 0.8);
    opacity: 0.8;
    transition: opacity 200ms ease;
    display: inline-flex;
    align-items: center;
  }
  .global-nav-logo:hover { opacity: 1; }

  /* Nav links container — explicit gap so links never crunch */
  .global-nav-links {
    display: none;
    align-items: center;
    gap: 28px;          /* fixed 28px gap between each link */
  }
  @media (min-width: 768px) {
    .global-nav-links { display: flex; }
  }

  .global-nav-link {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    letter-spacing: -0.1px;
    white-space: nowrap;
    transition: color 200ms ease;
  }
  .global-nav-link:hover { color: #ffffff; }

  /* Nav action items container */
  .global-nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .global-nav-icon {
    color: rgba(255, 255, 255, 0.72);
    display: inline-flex;
    align-items: center;
    transition: color 200ms ease;
  }
  .global-nav-icon:hover { color: #ffffff; }

  /* ── Sub Nav Bar (52px frosted glass) ── */
  .sub-nav {
    height: 52px;
    background-color: rgba(245, 245, 247, 0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid #f0f0f0;
    position: sticky;
    top: 0;
    z-index: 1010;
  }

  .sub-nav-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.3125rem;   /* 21px tagline */
    font-weight: 600;
    color: #1d1d1f;
    text-decoration: none;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }

  /* Sub-nav right cluster — gap keeps links from crashing */
  .sub-nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Sub-nav link container */
  .sub-nav-links {
    display: none;
    align-items: center;
    gap: 20px;             /* explicit gap between Featured and Categories */
  }
  @media (min-width: 640px) {
    .sub-nav-links { display: flex; }
  }

  .sub-nav-link {
    font-size: 12px;
    color: rgba(29, 29, 31, 0.75);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms ease;
  }
  .sub-nav-link:hover { color: #0066cc; }

  /* Primary Blue Pill Button */
  .btn-primary-pill {
    background-color: var(--color-primary);
    color: #ffffff;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 200ms cubic-bezier(0.4, 1.3, 0.65, 1); /* ease-spring */
  }
  .btn-primary-pill:hover {
    background-color: var(--color-primary-focus);
    transform: scale(1.03);
  }
  .btn-primary-pill:active {
    transform: scale(0.97);
  }
</style>