{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/article(?:\\/(.*?))?\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/dashboard\\/analytics\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/dashboard\\/articles\\/new\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/dashboard\\/articles\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/dashboard\\/profile\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/dashboard\\/?$",
			"dest": "_render"
		},
		{
			"src": "/.*",
			"dest": "/404.html",
			"status": 404
		}
	]
}